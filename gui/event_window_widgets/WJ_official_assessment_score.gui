# 复制原版 child_examination_success_chance.gui 的数据访问方式，仅替换为 WJ 成绩值与文本。
vbox = {
	name = "WJ_official_assessment_score"
	layoutpolicy_horizontal = expanding

	divider_light = {
		layoutpolicy_horizontal = expanding
	}

	hbox = {
		layoutpolicy_horizontal = expanding
		spacing = 5

		icon = {
			size = { 60 60 }
			texture = "gfx/interface/icons/character_interactions/tgp_send_to_childrens_examination_interaction.dds"
		}

		vbox = {
			spacing = 5

			hbox = {
				layoutpolicy_horizontal = expanding
				margin_left = 3
				spacing = 5

				text_single = { text = WJ_official_assessment_score }
				text_single = { text = "[GetPlayer.MakeScope.Var( 'wj_official_assessment_score' ).GetValue]" }
				expand = {}
			}

			hbox = {
				spacing = 10

				progressbar_standard = {
					layoutpolicy_horizontal = expanding
					size = { 200 20 }
					value = "[GetPlayer.MakeScope.Var( 'wj_official_assessment_score' ).GetValue]"
					max = 100
					min = 0
					using = Progressbar_Changed_Animation

					datacontext = "[GuiScope.SetRoot( GetPlayer.MakeScope ).GetScriptValueBreakdown( 'WJ_official_assessment_score_value' )]"
					tooltipwidget = { widget_value_breakdown_tooltip = {} }

					marker = {
						name = "current_value"
						icon = {
							size = { 25 16 }
							position = { -20 2 }
							texture = "gfx/interface/progressbars/progressbar_center_glow.dds"
							color = { 0.80 0.90 1 0.9 }
						}
					}
				}

				text_single = {
					visible = "[And( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'wj_official_assessment_score' ).GetValue, '(CFixedPoint)40' ), LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'wj_official_assessment_score' ).GetValue, '(CFixedPoint)60' ) )]"
					text = WJ_official_assessment_score_passing
					align = nobaseline
				}
				text_single = {
					visible = "[And( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'wj_official_assessment_score' ).GetValue, '(CFixedPoint)60' ), LessThan_CFixedPoint( GetPlayer.MakeScope.Var( 'wj_official_assessment_score' ).GetValue, '(CFixedPoint)90' ) )]"
					text = WJ_official_assessment_score_good
					align = nobaseline
				}
				text_single = {
					visible = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.Var( 'wj_official_assessment_score' ).GetValue, '(CFixedPoint)90' )]"
					text = WJ_official_assessment_score_high
					align = nobaseline
				}
			}
		}

		expand = {}
	}
}
