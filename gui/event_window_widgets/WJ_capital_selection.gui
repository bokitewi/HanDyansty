# Same list/portrait selection pattern as WJ_grandson_selection.
widget = {
 name = "WJ_capital_selection"
 size = { 440 280 }
 vbox = {
  layoutpolicy_horizontal = expanding
  layoutpolicy_vertical = expanding
  scrollbox = {
   layoutpolicy_horizontal = expanding
   layoutpolicy_vertical = expanding
   blockoverride "scrollbox_content" {
    vbox = {
     datamodel = "[GetPlayer.MakeScope.GetList('wj_capital_candidates')]"
     layoutpolicy_horizontal = expanding
     item = {
      button_standard = {
       size = { 402 68 }
       datacontext = "[Scope.GetCharacter]"
       enabled = "[GetScriptedGui('WJ_capital_select').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('recipient', Character.MakeScope).End)]"
       onclick = "[GetScriptedGui('WJ_capital_select').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('recipient', Character.MakeScope).End)]"
       down = "[GetScriptedGui('WJ_capital_select').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('recipient', Character.MakeScope).End)]"
       portrait_head_small = { scale = 0.75 tooltip_visible = yes }
       text_single = {
        position = { 70 0 } size = { 320 30 }
        text = "[Character.Custom('WJ_GetUIName')]"
        using = Font_Size_Medium autoresize = no
       }
       widget = { position = { 70 35 } hbox_skills_grid_character_model = { margin_left = 0 } }
      }
     }
    }
   }
  }
  text_single = {
   text = WJ_capital_no_candidates
  }
 }
}
