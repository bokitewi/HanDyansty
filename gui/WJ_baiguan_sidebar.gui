types WJBaiguanSidebarTypes {
 # Reuse the native council data model, not the council window as an entry point.
 type WJ_baiguan_sidebar_tab = widget_hud_main_tab {
  tooltip_offset = { 20 0 }
  tooltip = hd_baiguan_open_tt
  blockoverride "maintab_button" {
   texture = "gfx/interface/icons/court_position_types/favored_minister_court_position.dds"
   block "select_baiguan_court" {}
   onclick = "[GetScriptedGui('hd_baiguan_open_effect').Execute(GuiScope.SetRoot(GetPlayer.GetTopLiege.MakeScope).End)]"
   onclick = "[GetVariableSystem.Clear('WJ_baiguan_page')]"
   onclick = "[GetVariableSystem.Toggle('hd_baiguan_visibility')]"
  }
 }
}

window = {
 name = "WJ_baiguan_sidebar"
 datacontext = "[AccessCouncilWindow]"
 visible = "[GetPlayer.IsValid]"
 layer = bottom
 size = { 100% 90% }
 using = Animation_ShowHide_Quick
 alwaystransparent = yes
 button_hud_character_bar = {
  # Source flower position. No second entry at the old bamboo position (0, -200).
  position = { 0 -150 }
  parentanchor = bottom|left
  visible = "[And(IsDefaultGUIMode, And(Not(IsGameViewOpen('barbershop')), GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(GetPlayer.GetTopLiege.MakeScope).End)))]"
  WJ_baiguan_sidebar_tab = {
   visible = "[ObjectsEqual(GetPlayer, GetPlayer.GetTopLiege)]"
   blockoverride "select_baiguan_court" { onclick = "[CouncilWindow.SetPlayerCouncil]" }
  }
  WJ_baiguan_sidebar_tab = {
   visible = "[Not(ObjectsEqual(GetPlayer, GetPlayer.GetTopLiege))]"
   blockoverride "select_baiguan_court" { onclick = "[CouncilWindow.SetTopLiegeCouncil]" }
  }
 }
}
