types hd_baiguan_dragon_types
{
 type hd_dragon_ministry_interactions = button_round {
					visible = "[HasAccessToMinistry( Character.GetLiege )]"
					position = { 107 76 }
     size = { 28 28 }


					onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'celestial_ministry')]"

					tooltip = "CELESTIAL_MINISTRY_INTERACTIONS_BUTTON_TOOLTIP"
					tooltip_visible = "[Not(IsInteractionMenuOpenForCharacterWithFilter(Character.Self, 'celestial_ministry'))]"

					button_icon = {
						alwaystransparent = yes
						parentanchor = center
						size = { 21 21 }
						texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
					}

					text_single = {
						parentanchor = bottom|hcenter
						position = { 0 3 }
						text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, 'celestial_ministry')]"
						default_format = "#glow_color:{0.1,0.1,0.1,1.0}"

						background = {
							margin = { 5 0 }
							margin_top = -5
							using = Background_Area_Dark
						}
					}
				}
 # A card owns every pixel of its title, portrait, name and action row. No flow layout.
 type hd_dragon_person_slot = widget {
  parentanchor = top|left widgetanchor = top|left
  size = { 158 150 } allow_outside = no
  widget = { position = { 36 0 } size = { 85 90 } alwaystransparent = yes
   background = { texture = "gfx/interface/illustrations/WJ_tingyi/portrait.dds" }
   icon = { position = { 2 2 } size = { 81 86 } alwaystransparent = yes
    visible = "[Not(And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter))))]"
    texture = "gfx/portraits/unknown_portraits/button_unknown_head.dds" framesize = { 384 480 } frame = 1
   }
  }
  widget = {
   size = { 158 150 }
   block "person_visible" { visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]" }
   widget = { position = { 36 0 } size = { 85 90 }
    background = { texture = "gfx/interface/illustrations/WJ_tingyi/portrait.dds" }
    WJ_rank_background = {}
    portrait_button = { position = { 2 -6 } size = { 80 100 } using = portrait_base
     portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
     mask = "gfx/portraits/portrait_mask_head_small.dds" effectname = "NoHighlight"
    }
    WJ_rank_frame = {}
   }
   block "person_name" { text_single = { position = { 5 108 } size = { 148 18 }
    text = "[Character.GetFirstNameNoTooltip]"
    fontsize = 14 align = center|nobaseline autoresize = no alwaystransparent = yes
   } }
   block "person_actions" {}
  }
  block "vacant_name" { text_single = { position = { 5 108 } size = { 148 18 }
   block "vacant_visible" { visible = "[Not(And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter))))]" }
   block "vacant_text" { text = WJ_baiguan_text_vacant }
   fontsize = 14 default_format = "#weak" align = center|nobaseline autoresize = no alwaystransparent = yes
  } }
  block "office_text" { text_single = { position = { 0 90 } size = { 158 18 }
   block "office_label" { text = WJ_baiguan_text_vacant }
   fontsize = 16 default_format = "#clickable" align = center|nobaseline autoresize = no alwaystransparent = yes
  } }
  block "appointment" {}
 }
 # Horizontal cards keep the same portrait art and compact names, with no inherited action geometry.
 type hd_dragon_header_slot = widget {
  parentanchor = top|left widgetanchor = top|left
  size = { 278 92 } allow_outside = no
  widget = { position = { 4 0 } size = { 85 90 } alwaystransparent = yes
   background = { texture = "gfx/interface/illustrations/WJ_tingyi/portrait.dds" }
   icon = { position = { 2 2 } size = { 81 86 } texture = "gfx/portraits/unknown_portraits/button_unknown_head.dds" framesize = { 384 480 } frame = 1 alwaystransparent = yes }
  }
  widget = { size = { 278 92 }
   block "person_visible" { visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]" }
   widget = { position = { 4 0 } size = { 85 90 }
    background = { texture = "gfx/interface/illustrations/WJ_tingyi/portrait.dds" }
    WJ_rank_background = {}
    portrait_button = { position = { 2 -6 } size = { 80 100 } using = portrait_base
     portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
     mask = "gfx/portraits/portrait_mask_head_small.dds" effectname = "NoHighlight"
    }
    WJ_rank_frame = {}
   }
   block "person_name" { text_single = { position = { 100 34 } size = { 172 24 }
    text = "[Character.GetFirstNameNoTooltip]" fontsize = 15 autoresize = no alwaystransparent = yes
   } }
  }
  block "vacant_name" { text_single = { position = { 100 34 } size = { 172 24 }
   block "vacant_visible" { visible = "[Not(And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter))))]" }
   block "vacant_text" { text = WJ_baiguan_text_vacant }
   fontsize = 15 default_format = "#weak" autoresize = no alwaystransparent = yes
  } }
  block "office_text" { text_single = { position = { 100 8 } size = { 172 26 }
   block "office_label" { text = WJ_baiguan_text_vacant }
   fontsize = 18 default_format = "#high" autoresize = no alwaystransparent = yes
  } }
  block "appointment" {}
 }
 type hd_dragon_council_slot = hd_dragon_person_slot {
  blockoverride "vacant_text" { text = "[SelectLocalization(GuiCouncilPosition.CanPotentiallySelectCouncillor, 'WJ_baiguan_text_vacant', 'hd_dragon_office_unavailable')]" }
  blockoverride "person_actions" { hd_dragon_ministry_interactions = {} }
  blockoverride "appointment" {
   button_round = { position = { 65 128 } size = { 28 22 }
    visible = "[And(ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter), Not(GetScriptedGui('WJ_ty_native_appoint').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End)))]"
    enabled = "[GuiCouncilPosition.CanSelectCouncillor]"
    tooltip = "[GuiCouncilPosition.GetSelectCouncillorTooltip]"
    onclick = "[GuiCouncilPosition.SelectCouncillor]"
    button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
   }
   widget = {
   name = "wj_ty_entry_actions" parentanchor = top|left widgetanchor = top|left
   position = { 5 128 } size = { 148 22 }
   visible = "[And(GetScriptedGui('WJ_ty_gui_open_empty').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_ty_native_appoint').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End))]"
   button_standard = {
    name = "wj_ty_entry_appoint" parentanchor = top|left widgetanchor = top|left position = { 0 0 } size = { 70 22 } text = hd_baiguan_appoint
    texture = "gfx/interface/illustrations/WJ_tingyi/button.dds"
    buttonText = { text_single = { size = { 100% 100% } fontsize = 13 margin = { 2 0 } autoresize = no align = center|nobaseline default_format = "#clickable" alwaystransparent = yes } }
    enabled = "[GetScriptedGui('WJ_ty_native_appoint').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End)]"
    onclick = "[GetScriptedGui('WJ_ty_native_appoint').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
    tooltip = "[GetScriptedGui('WJ_ty_native_appoint').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End)]"
   }
   button_standard = {
    name = "wj_ty_entry_dismiss" parentanchor = top|left widgetanchor = top|left position = { 78 0 } size = { 70 22 } text = hd_baiguan_dismiss
    texture = "gfx/interface/illustrations/WJ_tingyi/button.dds"
    buttonText = { text_single = { size = { 100% 100% } fontsize = 13 margin = { 2 0 } autoresize = no align = center|nobaseline default_format = "#clickable" alwaystransparent = yes } }
    enabled = "[GetScriptedGui('WJ_ty_native_dismiss').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End)]"
    onclick = "[GetScriptedGui('WJ_ty_native_dismiss').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
    tooltip = "[GetScriptedGui('WJ_ty_native_dismiss').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', ActiveCouncilTask.GetCourtOwner.MakeScope).AddScope('wj_ty_native_task', ActiveCouncilTask.MakeScope).End)]"
   }
  }
  }
 }
 type hd_dragon_court_slot = widget {
  parentanchor = top|left widgetanchor = top|left
  size = { 158 150 } allow_outside = no
  widget = { size = { 158 150 }
   visible = "[Not(CouncilWindow.GetCharacter.EmploysCourtPositionType(CourtPositionType.Self))]"
   hd_dragon_person_slot = { datacontext = "[GetNullCharacter]"
    blockoverride "person_visible" { visible = no }
    blockoverride "vacant_visible" { visible = yes }
    blockoverride "office_label" { text = "" }
    blockoverride "vacant_text" { text = "[SelectLocalization(CourtPositionType.CanHirePosition(CouncilWindow.GetCharacter), 'WJ_baiguan_text_vacant', 'hd_dragon_office_unavailable')]" }
   }
  }
  hbox = { parentanchor = top|left widgetanchor = top|left
   position = { 0 0 } size = { 158 150 } ignoreinvisible = yes
   datamodel = "[CouncilWindow.GetCharacter.GetEmployedCourtPositions]"
   item = { hd_dragon_person_slot = {
    block "court_match" { visible = no }
    datacontext = "[CourtPosition.GetEmployee]"
    blockoverride "office_label" { text = "" }
    blockoverride "person_actions" { hd_dragon_ministry_interactions = {} }
    blockoverride "appointment" { button_round = { position = { 65 128 } size = { 28 22 }
     visible = "[And(ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter), Not(GetScriptedGui('WJ_ty_native_appoint').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)))]"
     tooltip = COURT_POSITION_REPLACE
     onclick = "[CourtPosition.OpenReplaceWindow]"
     button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
    } }
   } }
  }
  button_round = { position = { 65 128 } size = { 28 22 }
   visible = "[And(And(ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter), Not(CouncilWindow.GetCharacter.EmploysCourtPositionType(CourtPositionType.Self))), Not(GetScriptedGui('WJ_ty_native_appoint').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)))]"
   enabled = "[CourtPositionType.CanHirePosition(CouncilWindow.GetCharacter)]"
   tooltip = "[SelectLocalization(CourtPositionType.CanHirePosition(CouncilWindow.GetCharacter), 'hd_dragon_appoint_tt', 'hd_dragon_office_unavailable_tt')]"
   onclick = "[CourtPositionType.OpenAppointWindow(CouncilWindow.GetCharacter)]"
   button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
  }
  widget = {
   name = "wj_ty_entry_actions" parentanchor = top|left widgetanchor = top|left
   position = { 5 128 } size = { 148 22 }
   visible = "[And(GetScriptedGui('WJ_ty_gui_open_empty').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_ty_native_appoint').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End))]"
   button_standard = {
    name = "wj_ty_entry_appoint" parentanchor = top|left widgetanchor = top|left position = { 0 0 } size = { 70 22 } text = hd_baiguan_appoint
    texture = "gfx/interface/illustrations/WJ_tingyi/button.dds"
    buttonText = { text_single = { size = { 100% 100% } fontsize = 13 margin = { 2 0 } autoresize = no align = center|nobaseline default_format = "#clickable" alwaystransparent = yes } }
    enabled = "[GetScriptedGui('WJ_ty_native_appoint').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)]"
    onclick = "[GetScriptedGui('WJ_ty_native_appoint').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
    tooltip = "[GetScriptedGui('WJ_ty_native_appoint').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)]"
   }
   button_standard = {
    name = "wj_ty_entry_dismiss" parentanchor = top|left widgetanchor = top|left position = { 78 0 } size = { 70 22 } text = hd_baiguan_dismiss
    texture = "gfx/interface/illustrations/WJ_tingyi/button.dds"
    buttonText = { text_single = { size = { 100% 100% } fontsize = 13 margin = { 2 0 } autoresize = no align = center|nobaseline default_format = "#clickable" alwaystransparent = yes } }
    enabled = "[GetScriptedGui('WJ_ty_native_dismiss').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)]"
    onclick = "[GetScriptedGui('WJ_ty_native_dismiss').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
    tooltip = "[GetScriptedGui('WJ_ty_native_dismiss').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', CourtPositionType.MakeScope).End)]"
   }
  }
   block "court_label" { text_single = { position = { 0 90 } size = { 158 18 }
   text = "[CourtPositionType.CalcTriggeredNameNoTooltip(CouncilWindow.GetCharacter)]"
   fontsize = 16 default_format = "#high" align = center|nobaseline autoresize = no alwaystransparent = yes
  } }
 }
 type hd_dragon_navigation_button = button_standard {
  size = { 64 62 }
  buttonText = { text_single = { size = { 100% 100% } autoresize = no margin = { 4 0 }
   fontsize = 16 align = center|nobaseline default_format = "#clickable" alwaystransparent = yes
  } }
 }
}

window = {
	name = "hd_baiguan_dragon_window"
	# Keep native drag coordinates unscaled; only the ordinary content canvas scales.
	size = "[FloatToCVector2f(Multiply_float('(float)1747', ScaleToFitElementInside('(int32)1800', '(int32)1040')), Multiply_float('(float)998.5', ScaleToFitElementInside('(int32)1800', '(int32)1040')))]"
	parentanchor = center widgetanchor = center layer = windows_layer alwaystransparent = no
	using = Window_Movable
	allow_outside = yes
	enabled = "[Not(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))]"
	datacontext = "[AccessCouncilWindow]"
	# Never pass a missing council owner to a character-scoped scripted GUI.
	visible = "[And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), And(CouncilWindow.GetCharacter.IsValid, And(Not(GetVariableSystem.Exists('hd_baiguan_native_cover')), Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes'))))))]"
	state = { name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard }
	state = {
		name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard
	}
	widget = {
		name = "hd_dragon_canvas"
		size = { 1747 998.5 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 }
		scale = "[ScaleToFitElementInside('(int32)1800', '(int32)1040')]"
		visible = "[GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
		# The root owns movement and context; only explicit close actions change the open toggle.
  # Approved static decoration only: one continuous body, clipped dragons, no people or labels baked in.
  icon = {
   name = "hd_dragon_background" position = { 0 0 } size = { 1747 998.5 }
   texture = "gfx/interface/hd_baiguan/wj_court_background_clipped.png" alwaystransparent = yes
  }


		button_close = {
			position = { 1660 282 } size = { 32 32 } tooltip = CLOSE_TOOLTIP
			shortcut = "[Select_CString(Or(Or(Or(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End), GetScriptedGui('WJ_kaoke_table_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)), Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page'))), Or(GetPlayer.MakeScope.Var('wj_mt_subordinate_head').IsSet, GetScriptedGui('WJ_dd_ui_officers_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))), '', 'close_window')]"
			onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
		}
		widget = {
   name = "hd_dragon_emperor_backdrop" position = { 834.85 102.66 } size = { 154.51 173.81 } alwaystransparent = yes datacontext = "[CouncilWindow.GetCharacter]"
   background = { texture = "gfx/interface/illustrations/WJ_tingyi/portrait.dds" }
   WJ_rank_background_large = { margin = { 2 2 } }
  }
		portrait_button = {
			name = "hd_dragon_emperor" position = { 837.35 105.16 } size = { 149.51 168.81 }
			enabled = "[Not(Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page')))]"
			datacontext = "[CouncilWindow.GetCharacter]" using = portrait_base
			portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			mask = "gfx/portraits/portrait_mask_head_small.dds" effectname = "NoHighlight"
		}
		WJ_rank_frame_large = { position = { 834.85 102.66 } size = { 154.51 173.81 } parentanchor = top|left widgetanchor = top|left datacontext = "[CouncilWindow.GetCharacter]" }
		widget = {
			name = "hd_dragon_display_sync" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('WJ_baiguan_display_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
			state = { name = _show on_start = "[GetScriptedGui('hd_baiguan_rebuild_effect').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]" }
		}
		widget = {
			name = "hd_dragon_overview" size = { 1747 998.5 } alwaystransparent = yes
			enabled = "[Not(Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page')))]"
			visible = "[Not(GetVariableSystem.Exists('WJ_baiguan_page'))]"

   icon = { name = "hd_dragon_heading_inner" position = { 220 373 } size = { 130.5 70.2 } texture = "gfx/interface/hd_baiguan/wj_heading_inner_alpha.png" alwaystransparent = yes }
   icon = { name = "hd_dragon_heading_outer" position = { 1037 398 } size = { 126 58.5 } texture = "gfx/interface/hd_baiguan/wj_heading_outer_alpha.png" alwaystransparent = yes }
   icon = { name = "hd_dragon_heading_public" position = { 665 475 } size = { 50 54 } texture = "gfx/interface/hd_baiguan/wj_heading_public_alpha.png" alwaystransparent = yes }
   icon = { name = "hd_dragon_heading_ministers" position = { 665 654 } size = { 50 54 } texture = "gfx/interface/hd_baiguan/wj_heading_ministers_alpha.png" alwaystransparent = yes }
   icon = { name = "hd_dragon_heading_monitors" position = { 665 818 } size = { 50 60 } texture = "gfx/interface/hd_baiguan/wj_heading_monitors_alpha.png" alwaystransparent = yes }
   icon = { name = "hd_dragon_rule_top" position = { 365 398 } size = { 1175 1 } texture = "gfx/interface/colors/white.dds" color = { 0.48 0.42 0.29 0.7 } alwaystransparent = yes }
   icon = { name = "hd_dragon_rule_inner_rise" position = { 365 363 } size = { 1 35 } texture = "gfx/interface/colors/white.dds" color = { 0.48 0.42 0.29 0.7 } alwaystransparent = yes }
   icon = { name = "hd_dragon_rule_inner_return" position = { 268 363 } size = { 97 1 } texture = "gfx/interface/colors/white.dds" color = { 0.48 0.42 0.29 0.7 } alwaystransparent = yes }
   icon = { name = "hd_dragon_rule_vertical" position = { 640 414 } size = { 1 514 } texture = "gfx/interface/colors/white.dds" color = { 0.48 0.42 0.29 0.7 } alwaystransparent = yes }
   icon = { name = "hd_dragon_rule_ministers" position = { 715 630 } size = { 825 1 } texture = "gfx/interface/colors/white.dds" color = { 0.48 0.42 0.29 0.7 } alwaystransparent = yes }
   icon = { name = "hd_dragon_rule_monitors" position = { 715 810 } size = { 825 1 } texture = "gfx/interface/colors/white.dds" color = { 0.48 0.42 0.29 0.7 } alwaystransparent = yes }
   button = {
    name = "WJ_ty_baiguan_entry" position = { 390 379 } size = { 220 62 }
    visible = "[GetScriptedGui('WJ_ty_gui_memorial_council').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_viewed_court', CouncilWindow.GetCharacter.MakeScope).End)]"
    enabled = "[GetScriptedGui('WJ_ty_gui_open_empty').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('WJ_ty_gui_open_empty').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    tooltip = "[GetScriptedGui('WJ_ty_gui_open_empty').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    state = { name = _mouse_enter on_start = "[PdxGuiWidget.FindChild('WJ_ty_baiguan_hover').TriggerAnimation('mouse_enter')]" }
    state = { name = _mouse_leave on_start = "[PdxGuiWidget.FindChild('WJ_ty_baiguan_hover').TriggerAnimation('mouse_leave')]" }
    icon = { size = { 100% 100% } texture = "gfx/interface/hd_baiguan/wj_tingyi_button.png" alwaystransparent = yes
     visible = "[GetScriptedGui('WJ_ty_gui_open_empty').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    icon = { name = "WJ_ty_baiguan_hover" size = { 100% 100% } texture = "gfx/interface/hd_baiguan/wj_tingyi_button_hover.png" alpha = 0 alwaystransparent = yes
     visible = "[GetScriptedGui('WJ_ty_gui_open_empty').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     state = { name = mouse_enter alpha = 1 duration = 0.12 }
     state = { name = mouse_leave alpha = 0 duration = 0.12 }
    }
    highlight_icon = { size = { 100% 100% } texture = "gfx/interface/hd_baiguan/wj_tingyi_button.png" alwaystransparent = yes
