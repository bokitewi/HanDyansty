# Sidebar-owned lifecycle. Closing the council must not close Hundred Officials.
# Leave special GUI modes cleanly without a persistent hidden toggle.
widget = {
	name = "hd_baiguan_council_close_guard"
	size = { 1 1 }
	alwaystransparent = yes
	visible = "[And( GetVariableSystem.HasValue( 'hd_baiguan_visibility', 'true' ), Not( IsDefaultGUIMode ) )]"

	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
	}
}
