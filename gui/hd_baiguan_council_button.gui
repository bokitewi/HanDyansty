# Sidebar-owned lifecycle. Closing the council must not close Hundred Officials.
# Close explicit scene views without treating temporary input modes as a close request.
widget = {
	name = "hd_baiguan_council_close_guard"
	size = { 1 1 }
	alwaystransparent = yes
	visible = "[And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes')))]"

	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
	}
}

# Secondary states survive temporary hiding for child windows.
widget = {
	name = "hd_secondary_army_close_guard"
	size = { 1 1 } alwaystransparent = yes
	datacontext = "[AccessCouncilWindow]"
	visible = "[And(Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page')), Or(Not(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true')), Or(Not(And(GetPlayer.IsValid, CouncilWindow.GetCharacter.IsValid)), Or(Not(ObjectsEqual(CouncilWindow.GetCharacter, GetPlayer.GetTopLiege)), Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes'))))))]"
	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
		on_start = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
	}
}

# Native right-side windows share windows_layer with Hundred Officials.
# While one is open, Hundred Officials and its secondary pages step aside without losing their open state.
widget = {
	name = "hd_baiguan_native_cover_on"
	size = { 1 1 } alwaystransparent = yes
	visible = "[And(Not(GetVariableSystem.Exists('hd_baiguan_native_cover')), Or(Or(Or(Or(IsGameViewOpen('military'), IsGameViewOpen('court_window')), Or(IsGameViewOpen('council_window'), IsGameViewOpen('my_realm'))), Or(Or(IsGameViewOpen('government_administration'), IsGameViewOpen('intrigue_window')), Or(IsGameViewOpen('factions_window'), IsGameViewOpen('decisions')))), Or(Or(Or(IsGameViewOpen('activity_list_window'), IsGameViewOpen('situations')), Or(IsGameViewOpen('manage_tax_slots'), IsGameViewOpen('struggle'))), Or(Or(IsGameViewOpen('epidemics'), IsGameViewOpen('legends')), Or(IsGameViewOpen('title_appointment'), IsGameViewOpen('geographical_regions'))))))]"
	state = {
		name = _show
		on_start = "[GetVariableSystem.Set('hd_baiguan_native_cover', 'true')]"
	}
}
widget = {
	name = "hd_baiguan_native_cover_off"
	size = { 1 1 } alwaystransparent = yes
	visible = "[And(GetVariableSystem.Exists('hd_baiguan_native_cover'), Not(Or(Or(Or(Or(IsGameViewOpen('military'), IsGameViewOpen('court_window')), Or(IsGameViewOpen('council_window'), IsGameViewOpen('my_realm'))), Or(Or(IsGameViewOpen('government_administration'), IsGameViewOpen('intrigue_window')), Or(IsGameViewOpen('factions_window'), IsGameViewOpen('decisions')))), Or(Or(Or(IsGameViewOpen('activity_list_window'), IsGameViewOpen('situations')), Or(IsGameViewOpen('manage_tax_slots'), IsGameViewOpen('struggle'))), Or(Or(IsGameViewOpen('epidemics'), IsGameViewOpen('legends')), Or(IsGameViewOpen('title_appointment'), IsGameViewOpen('geographical_regions')))))))]"
	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear('hd_baiguan_native_cover')]"
	}
}
