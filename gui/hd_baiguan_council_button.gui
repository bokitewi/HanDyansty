# Independent lifecycle guard. If another major view closes the council while
# the custom window toggle is still set, clear it without relying on the
# custom window's hide animation finishing.
widget = {
	name = "hd_baiguan_council_close_guard"
	size = { 1 1 }
	alwaystransparent = yes
	visible = "[And( GetVariableSystem.HasValue( 'hd_baiguan_visibility', 'true' ), Not( IsGameViewOpen( 'council_window' ) ) )]"

	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
	}
}
