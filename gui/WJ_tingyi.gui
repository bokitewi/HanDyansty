types WJ_tingyi_types {
 # All seats bind their real observer to one explicit attitude-source tooltip.
 type WJ_ty_button = button_normal {
  texture = "gfx/interface/illustrations/WJ_tingyi/button.dds"
  size = { 170 33 } gfxtype = togglepushbuttongfx effectname = "NoHighlight"
  upframe = 1 uphoverframe = 2 uppressedframe = 3 downframe = 4 downhoverframe = 4 downpressedframe = 4 disableframe = 7
  spriteType = Corneredtiled spriteborder = { 4 4 } framesize = { 252 80 }
  buttonText = { text_single = { size = { 100% 100% } margin = { 6 0 } autoresize = no align = center|nobaseline default_format = "#clickable" using = Font_Size_Small alwaystransparent = yes } }
 }
}
window = {
 name = "WJ_tingyi_window" parentanchor = right|vcenter position = { -20 0 } layer = windows_layer allow_outside = no
 size = { 1200 800 } using = Window_Movable 
 filter_mouse = all alwaystransparent = no
 visible = "[GetPlayer.MakeScope.Var('wj_ty_open').IsSet]"
 state = { name = _show
  on_start = "[CloseGameView('government_administration')]"
  on_start = "[CloseGameView('my_realm')]"
  on_start = "[CloseGameView('military')]"
  on_start = "[CloseGameView('council_window')]"
  on_start = "[CloseGameView('court_window')]"
  on_start = "[CloseGameView('intrigue_window')]"
  on_start = "[CloseGameView('factions_window')]"
  on_start = "[CloseGameView('decisions')]"
  on_start = "[CloseGameView('decision_detail')]"
  on_start = "[CloseGameView('activity_list_window')]"
  on_start = "[CloseGameView('situations')]"
  on_start = "[CloseGameView('struggle')]"
  on_start = "[CloseGameView('epidemics')]"
  on_start = "[CloseGameView('legends')]"
  on_start = "[CloseGameView('title_appointment')]"
  on_start = "[CloseGameView('geographical_regions')]"
  on_start = "[CloseGameView('manage_tax_slots')]"
  on_start = "[GetVariableSystem.Clear('court_scene')]"
  on_start = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
  on_start = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
  on_start = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
  on_start = "[GetVariableSystem.Set('wj_ty_view_ready', 'yes')]"
 }
 state = { name = _hide on_start = "[GetVariableSystem.Clear('wj_ty_view_ready')]" }

 background = { texture = "gfx/interface/illustrations/WJ_tingyi/shell.dds" }
 widget = { name = "WJ_ty_main_page" size = { 1200 800 }
 background = { texture = "gfx/interface/illustrations/WJ_tingyi/surface.dds" }
 

text_single = { position = { 102 50 } size = { 500 23 } text = WJ_ty_header using = Font_Size_Small autoresize = no  }
text_single = { position = { 640 49 } size = { 482 26 } text = WJ_ty_resources autoresize = no using = Font_Size_Small align = right }
text_single = { position = { 480 19 } size = { 642 26 } text = WJ_ty_proposer_label autoresize = no align = right }

widget = { name = "WJ_ty_roster_sync" size = { 0 0 } alwaystransparent = yes
 visible = "[GetScriptedGui('WJ_ty_gui_sync').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 state = { name = _show on_start = "[GetScriptedGui('WJ_ty_gui_sync').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
}
widget = { name = "WJ_ty_seat_card_0" position = { 24 112 } size = { 158 224 }
 button = { name = "WJ_ty_select_seat_0" size = { 158 224 }
 onclick = "[GetScriptedGui('WJ_ty_gui_role_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
background = { texture = "gfx/interface/illustrations/WJ_tingyi/button.dds" framesize = { 252 80 } frame = 4 spriteType = Corneredtiled spriteborder = { 4 4 } alpha = 0.35 visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('wj_ty_role').GetValue, '(CFixedPoint)0')]" }
WJ_ty_button = { position = { 4 2 } size = { 150 28 } text = WJ_ty_role_0 onclick = "[GetScriptedGui('WJ_ty_gui_role_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"  down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('wj_ty_role').GetValue, '(CFixedPoint)0')]" }
widget = { position = { 36 36 } size = { 85 90 } visible = "[GetPlayer.MakeScope.Var('wj_ty_seat_0').IsSet]" datacontext = "[GetPlayer.MakeScope.Var('wj_ty_seat_0').Char]" background = { texture = "gfx/interface/illustrations/WJ_tingyi/portrait.dds" } portrait_button = { position = { 2 -6 } size = { 80 100 } using = portrait_base
 portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
 mask = "gfx/portraits/portrait_mask_head_small.dds" effectname = "NoHighlight"
 } }
text_single = { position = { 12 62 } size = { 134 40 } text = WJ_ty_empty autoresize = no align = center visible = "[Not(GetPlayer.MakeScope.Var('wj_ty_seat_0').IsSet)]" alwaystransparent = yes }
text_single = { position = { 5 130 } size = { 148 24 } using = Font_Size_Small text = WJ_ty_name_0 autoresize = no align = center visible = "[GetPlayer.MakeScope.Var('wj_ty_seat_0').IsSet]" alwaystransparent = yes }
button = { position = { 4 154 } size = { 150 22 }
 datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_observer', GetPlayer.MakeScope.Var('wj_ty_seat_0').Char.MakeScope)]"
 tooltip_visible = yes
 tooltipwidget = {
  WJ_ty_attitude_breakdown_tooltip = {
   datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_observer', GetPlayer.MakeScope.Var('wj_ty_seat_0').Char.MakeScope)]"
   blockoverride "header_text" { text = WJ_ty_agreement_tt_0 }
   blockoverride "attitude_summary" { text = "[GetPlayer.MakeScope.ScriptValue('WJ_ty_agreement_0')|=+2]" }
   blockoverride "proposer_summary" { text = "[GetPlayer.MakeScope.ScriptValue('WJ_ty_proposer_subtotal_0')|=+2]" }
   blockoverride "proposer_visible" { visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('WJ_ty_proposer_activity_0'), '(CFixedPoint)0'))]" }
   blockoverride "issue_summary" { text = "[GetPlayer.MakeScope.ScriptValue('WJ_ty_issue_subtotal_0')|=+2]" }
   blockoverride "issue_visible" { visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('WJ_ty_issue_activity_0'), '(CFixedPoint)0'))]" }
  }
 }
 onclick = "[GetScriptedGui('WJ_ty_gui_role_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 text_single = { size = { 100% 100% } text = WJ_ty_attitude_label_0 autoresize = no align = center alwaystransparent = yes } }
button = { position = { 4 176 } size = { 150 22 } tooltip = WJ_ty_contribution_tt_0
 onclick = "[GetScriptedGui('WJ_ty_gui_role_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 text_single = { size = { 100% 100% } using = Font_Size_Small text = WJ_ty_contribution_label_0 autoresize = no align = center alwaystransparent = yes } }
}
