     onselectionchanged = "[GetScriptedGui(Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), 'WJ_ty_picker_filter_culture_0', Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), 'WJ_ty_picker_filter_culture_1', 'WJ_ty_picker_filter_culture_2'))).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    blockoverride "dropdown_active_item_properties" { text = "[Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), Localize('any_filter_option'), Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Localize('same_culture_filter_option'), Localize('not_same_culture_filter_option')))]" }
    blockoverride "dropdown_item_properties" { text = "[Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), Localize('any_filter_option'), Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Localize('same_culture_filter_option'), Localize('not_same_culture_filter_option')))]" }
   }
   }
  }
scrollbox = {
   name = "characters_scroll_area"
   layoutpolicy_horizontal = expanding
   layoutpolicy_vertical = expanding
   scissor = yes
   blockoverride "scrollbox_margins" { margin = { 0 0 } }
   blockoverride "scrollbox_background" {}
   blockoverride "scrollbox_content" {
    fixedgridbox = {
     name = "characters_grid"
     parentanchor = top|left
     addcolumn = 650 addrow = 110
     maxhorizontalslots = 1
     datamodel_reuse_widgets = yes
     datamodel = "[GetPlayer.MakeScope.GetList('wj_ty_picker_candidates')]"
     item = {
      widget = {
       name = "WJ_ty_picker_candidate_row"
       datacontext = "[Scope.Char]"
       size = { 630 110 }
       # Put absolute geometry on widgets, never on hbox child defaults.
       portrait_head_small = { parentanchor = top|left position = { 0 5 } }
       widget = {
        parentanchor = top|left position = { 95 5 } size = { 535 100 }
        background = { texture = "gfx/interface/illustrations/WJ_tingyi/catalog_panel.dds" }
        background = { using = Background_Area_Dark_Border }
        text_single = { parentanchor = top|left position = { 10 0 } size = { 345 28 } text = "[Character.Custom('WJ_GetUIName')|U]" using = Font_Size_Medium autoresize = no }
        widget = {
         name = "WJ_ty_picker_candidate_skills"
         parentanchor = top|left position = { 372 3 } size = { 160 25 }
         hbox_skills_grid_character_model = {}
        }
        widget = { name = "WJ_ty_picker_candidate_age" parentanchor = top|left position = { 10 30 } size = { 345 25 }
 text_single = { position = { 0 0 } size = { 55 25 } text = WJ_ty_character_age using = Font_Size_Small autoresize = no }
 icon = { position = { 54 1 } size = { 23 23 }
 texture = "gfx/interface/icons/character_status/icon_health.dds" framesize = { 60 60 }
 frame = "[Character.GetHealthIconFrame]" tooltip = "[Character.GetHealthInfo]"
 visible = "[Not(Character.IsDeadAndValid)]"
}
 text_single = { position = { 84 0 } size = { 256 25 } text = "[Character.Custom2('WJ_RelationToViewer', GetPlayer)]" tooltip = EXTENDED_RELATIONS_TOOLTIP default_format = "#low" autoresize = no
 visible = "[And(GetPlayer.IsValid, Or(Character.HasRelationTo(GetPlayer), GetScriptedGui('WJ_relation_has_mufu').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('viewer', GetPlayer.MakeScope).End)))]" }
}
        widget = {
         name = "WJ_ty_picker_candidate_identity"
         parentanchor = top|left position = { 10 60 } size = { 340 40 }
         hbox = {
         spacing = 5
         widget = { size = { 35 40 } coa_house_tiny = { datacontext = "[Character.GetHouse]" parentanchor = center } }
         icon = { size = { 35 35 } datacontext = "[Character.GetFaith]" texture = "[Faith.GetIcon]" tooltipwidget = { faith_tooltip = {} } }
         icon = { size = { 30 30 } texture = "gfx/interface/icons/icon_culture.dds" datacontext = "[Character.GetCulture]" tooltipwidget = { culture_tooltip = {} } }
         text_single = { size = { 45 30 } datacontext = "[Character.GetCulture]" text = CULTURE_LISTS_WINDOW autoresize = no tooltipwidget = { culture_tooltip = {} } }
         WJ_luzhi_badge = { size = { 30 30 } visible = "[Character.ShouldShowMerit]"
 tooltipwidget = { WJ_ty_character_merit_tooltip = {} }
}
         widget = {
          size = { 120 35 } scissor = yes
          fixedgridbox = {
           parentanchor = top|left size = { 120 35 } flipdirection = yes
           datamodel = "[Character.GetTraitIndices]"
           addcolumn = 24 addrow = 35 maxhorizontalslots = 5 maxverticalslots = 1
           item = { widget = { size = { 24 35 }
            icon_trait = { parentanchor = center datacontext = "[GetTraitForIndex(int32.GetInt)]" blockoverride "icon_size" { size = { 28 28 } } }
           } }
          }
         }
         }
        }
        button_standard = {
         parentanchor = top|left position = { 357 62 } size = { 170 32 } text = WJ_ty_select
         enabled = "[GetScriptedGui('WJ_ty_gui_target').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Scope.Char.MakeScope).End)]"
         onclick = "[GetScriptedGui('WJ_ty_gui_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Scope.Char.MakeScope).End)]"
         tooltip = "[GetScriptedGui('WJ_ty_gui_target').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Scope.Char.MakeScope).End)]"
        }
       }
       divider_light = { parentanchor = bottom|hcenter size = { 100% 3 } }
      }
     }
    }
   }
  blockoverride "scrollbox_empty" { visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_ty_picker_candidates'))]" text = WJ_ty_picker_empty }
  }
 }
}

