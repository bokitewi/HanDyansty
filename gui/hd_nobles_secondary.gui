types hd_nobles_secondary_types
{
	type hd_nobles_character_box = widget {
		size = { 684 104 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
		visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]"
		background = {
			texture = "gfx/interface/buttons/button_entry_characterlist.dds"
			framesize = { 252 80 } spriteType = Corneredtiled spriteborder = { 10 30 }
			alpha = 0.15
		}
		portrait_head_small = {
			position = { 8 12 } size = { 85 90 }
			blockoverride "coa" {} blockoverride "opinion_box" {}
			blockoverride "show_portrait_status_icons" { visible = no }
		}
		textbox = {
			position = { 104 4 } size = { 572 42 } autoresize = no fontsize = 17
			using = Font_Type_Standard multiline = yes align = top|left
			text = "[Character.Custom('WJ_GetUIName')]" tooltip = "[Character.Custom('WJ_GetUIName')]"
			fontcolor = { 0 0 0 1 } default_format = "#hd_black"
		}
		text_single = {
			position = { 104 49 } size = { 572 20 } autoresize = no fontsize = 14
			visible = "[CouncilWindow.GetCharacter.IsValid]"
			text = "[Character.GetAge] · [Character.Custom2('WJ_RelationToViewerLight', CouncilWindow.GetCharacter)]"
			tooltip = "[Character.GetAge] · [Character.Custom2('WJ_RelationToViewerLight', CouncilWindow.GetCharacter)]"
			fontcolor = { 0 0 0 1 } default_format = "#hd_black"
		}
		text_single = {
			position = { 104 49 } size = { 572 20 } autoresize = no fontsize = 14
			visible = "[Not(CouncilWindow.GetCharacter.IsValid)]"
			text = "[Character.GetAge]"
			tooltip = "[Character.GetAge]"
			fontcolor = { 0 0 0 1 } default_format = "#hd_black"
		}
		button_standard = {
			position = { 104 75 } size = { 108 26 } text = hd_secondary_royal_actions
			onclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
		}
	}
	type hd_nobles_group = vbox {
		layoutpolicy_horizontal = expanding layoutpolicy_vertical = growing spacing = 4 ignoreinvisible = yes
		text_single = {
			size = { 684 24 } fontsize = 20 autoresize = no align = center|nobaseline
			layoutpolicy_vertical = fixed
			fontcolor = { 0 0 0 1 } default_format = "#hd_black"
			block "group_title" { text = WJ_royal_group_noble_dukes }
		}
		text_single = {
			size = { 684 26 } text = hd_secondary_royal_empty fontsize = 16 align = center|nobaseline
			layoutpolicy_vertical = fixed
			fontcolor = { 0 0 0 1 } default_format = "#hd_black"
			block "group_empty" { visible = "[Not(GetScriptedGui('hd_nobles_dukes_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
		}
		dynamicgridbox = {
			layoutpolicy_horizontal = expanding layoutpolicy_vertical = growing
			block "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_noble_dukes')]" }
			datamodel_wrap = 1 flipdirection = yes ignoreinvisible = yes
			item = { hd_nobles_character_box = { datacontext = "[Scope.GetCharacter]" } }
		}
	}
}

window = {
	name = "hd_nobles_secondary_frame"
	enabled = "[Not(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))]"
	# Only the ordinary canvas scales; native drag coordinates belong to this root.
	size = "[FloatToCVector2f(Multiply_float('(float)1632', ScaleToFitElementInside('(int32)1728', '(int32)1040')), Multiply_float('(float)960', ScaleToFitElementInside('(int32)1728', '(int32)1040')))]"
	parentanchor = center widgetanchor = center layer = middle alwaystransparent = no
	position = { 0 0 }
	using = Window_Movable allow_outside = yes datacontext = "[AccessCouncilWindow]"
	visible = "[And(GetVariableSystem.HasValue('hd_secondary_royal_page', 'nobles'), And(Not(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true')), And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), And(GetPlayer.IsValid, And(Not(GetVariableSystem.Exists('hd_baiguan_native_cover')), And(CouncilWindow.GetCharacter.IsValid, And(Not(IsInteractionConfirmationWindowOpen), Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes'))))))))))]"
	state = {
		name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard
		on_start = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
	}
	state = { name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard }
	widget = {
		name = "hd_nobles_secondary_canvas" size = { 1632 960 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 }
		scale = "[ScaleToFitElementInside('(int32)1728', '(int32)1040')]"
		widget = {
			name = "hd_nobles_eligibility_guard" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
			state = { name = _show on_start = "[GetVariableSystem.Clear('hd_secondary_royal_page')]" }
		}
		icon = { name = "hd_nobles_background" size = { 1632 960 } texture = "gfx/interface/hd_baiguan/wj_nobles_frame_tall.png" alwaystransparent = yes }
		icon = {
			name = "hd_nobles_title" position = { 666 150 } size = { 300 100 }
			texture = "gfx/interface/hd_baiguan/wj_heading_nobles_alpha.png"
			color = { 0.18 0.16 0.12 1 } tooltip = hd_nobles_title
			alwaystransparent = yes
		}
		button_close = {
			position = { 1548 280 } size = { 32 32 } tooltip = CLOSE_TOOLTIP
			shortcut = "[Select_CString(Or(Or(IsInteractionConfirmationWindowOpen, GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)), Or(GetPlayer.MakeScope.Var('wj_mt_subordinate_head').IsSet, GetScriptedGui('WJ_dd_ui_officers_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))), '', 'close_window')]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
		}
		scrollbox = {
			name = "hd_nobles_roster" position = { 460 292 } size = { 712 560 }
			blockoverride "scrollbox_background" {}
			blockoverride "scrollbox_margins" { margin = { 8 4 } }
			blockoverride "scrollbox_content" { vbox = {
				layoutpolicy_horizontal = expanding layoutpolicy_vertical = growing spacing = 8 ignoreinvisible = yes
				hd_nobles_group = {
					blockoverride "group_title" { text = WJ_royal_group_all_kings }
					blockoverride "group_empty" { visible = "[Not(GetScriptedGui('hd_nobles_kings_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
					blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_kings')]" }
				}
				hd_nobles_group = {}
				hd_nobles_group = {
					blockoverride "group_title" { text = WJ_royal_group_marquises }
					blockoverride "group_empty" { visible = "[Not(GetScriptedGui('hd_nobles_marquises_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
					blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_marquises')]" }
				}
			} }
		}
	}
}
