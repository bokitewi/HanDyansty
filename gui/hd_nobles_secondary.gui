types hd_nobles_secondary_types
{
	type hd_nobles_character_box = widget {
		size = { 310 100 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
		visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]"
		background = {
			texture = "gfx/interface/buttons/button_entry_characterlist.dds"
			framesize = { 252 80 } spriteType = Corneredtiled spriteborder = { 10 30 }
		}
		portrait_head_small = {
			position = { 8 5 } size = { 85 90 }
			blockoverride "coa" {} blockoverride "opinion_box" {}
			blockoverride "show_portrait_status_icons" { visible = no }
		}
		text_single = {
			position = { 104 5 } size = { 198 30 } autoresize = no fontsize = 17
			text = "[Character.Custom('WJ_GetUIName')]" tooltip = "[Character.Custom('WJ_GetUIName')]"
			fontcolor = { 0.18 0.12 0.10 1 }
		}
		text_single = {
			position = { 104 38 } size = { 198 24 } autoresize = no fontsize = 14
			text = "[Character.GetAge] · [Character.Custom2('WJ_RelationToViewer', CouncilWindow.GetCharacter)]"
			tooltip = "[Character.GetAge] · [Character.Custom2('WJ_RelationToViewer', CouncilWindow.GetCharacter)]"
			fontcolor = { 0.18 0.12 0.10 1 }
		}
		button_standard = {
			position = { 104 72 } size = { 108 26 } text = hd_secondary_royal_actions
			onclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
		}
	}
	type hd_nobles_group = vbox {
		layoutpolicy_horizontal = expanding spacing = 6 ignoreinvisible = yes
		text_single = {
			size = { 310 28 } fontsize = 20 autoresize = no align = center|nobaseline
			fontcolor = { 0.18 0.12 0.10 1 }
			block "group_title" { text = WJ_royal_group_noble_dukes }
		}
		text_single = {
			size = { 310 26 } text = hd_secondary_royal_empty fontsize = 16 align = center|nobaseline
			fontcolor = { 0.18 0.12 0.10 1 }
			block "group_empty" { visible = "[Not(GetScriptedGui('hd_nobles_dukes_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
		}
		dynamicgridbox = {
			block "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_noble_dukes')]" }
			datamodel_wrap = 1 flipdirection = yes ignoreinvisible = yes
			item = { hd_nobles_character_box = { datacontext = "[Scope.GetCharacter]" } }
		}
	}
}

window = {
	name = "hd_nobles_secondary_frame"
	enabled = "[Not(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))]"
	# Only the ordinary canvas scales; native drag coordinates belong to this root.
	size = "[FloatToCVector2f(Multiply_float('(float)1448', ScaleToFitElementInside('(int32)1500', '(int32)1200')), Multiply_float('(float)620', ScaleToFitElementInside('(int32)1500', '(int32)1200')))]"
	parentanchor = center widgetanchor = center layer = middle alwaystransparent = no
	position = { -48 0 }
	using = Window_Movable allow_outside = yes datacontext = "[AccessCouncilWindow]"
	visible = "[And(GetVariableSystem.HasValue('hd_secondary_royal_page', 'nobles'), And(Not(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true')), And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), And(GetPlayer.IsValid, And(CouncilWindow.GetCharacter.IsValid, And(Not(IsInteractionConfirmationWindowOpen), Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes')))))))))]"
	state = {
		name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard
		on_start = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
	}
	state = { name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard }
	widget = {
		name = "hd_nobles_secondary_canvas" size = { 1448 620 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 }
		scale = "[ScaleToFitElementInside('(int32)1500', '(int32)1200')]"
		widget = {
			name = "hd_nobles_eligibility_guard" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
			state = { name = _show on_start = "[GetVariableSystem.Clear('hd_secondary_royal_page')]" }
		}
		icon = { size = { 1448 620 } texture = "gfx/interface/hd_baiguan/ui3.png" alwaystransparent = yes }
		text_single = {
			position = { 538 172 } size = { 356 60 } text = WJ_baiguan_tab_nobles
			fontsize = 40 autoresize = no align = center|nobaseline fontcolor = { 0.18 0.12 0.10 1 }
		}
		button_close = {
			position = { 1392 280 } size = { 32 32 } tooltip = CLOSE_TOOLTIP
			shortcut = "[Select_CString(Or(IsInteractionConfirmationWindowOpen, GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)), '', 'close_window')]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
		}
		scrollbox = {
			name = "hd_nobles_roster" position = { 538 250 } size = { 356 266 }
			blockoverride "scrollbox_background" {}
			blockoverride "scrollbox_margins" { margin = { 8 4 } }
			blockoverride "scrollbox_content" { vbox = {
				layoutpolicy_horizontal = expanding spacing = 8 ignoreinvisible = yes
				hd_nobles_group = {}
				hd_nobles_group = {
					blockoverride "group_title" { text = WJ_royal_group_marquises }
					blockoverride "group_empty" { visible = "[Not(GetScriptedGui('hd_nobles_marquises_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
					blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_marquises')]" }
				}
			} }
		}
	}
}
