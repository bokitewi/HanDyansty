# Shares the original district membership/cache; no vassal-tree substitution.
window = {
 name = "WJ_district_officers" parentanchor = center widgetanchor = center layer = top
 size = "[FloatToCVector2f(Multiply_float('(float)907.5', ScaleToFitElementInside('(int32)1160', '(int32)820')), Multiply_float('(float)646', ScaleToFitElementInside('(int32)1160', '(int32)820')))]"
 enabled = "[Not(Or(IsInteractionConfirmationWindowOpen, GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)))]"
 using = Window_Movable filter_mouse = all alwaystransparent = no allow_outside = yes
 visible = "[And(GetScriptedGui('WJ_dd_ui_officers_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End), Not(Or(GetPlayer.MakeScope.Var('wj_mt_open').IsSet, GetPlayer.MakeScope.Var('wj_mt_subordinate_head').IsSet)))]"
 datacontext = "[GetPlayer.MakeScope.Var('wj_dd_officers_view').Char]"
 state = { name = _show on_start = "[GetVariableSystem.Set('wj_dd_officers_visible', 'yes')]" }
 state = { name = _hide on_start = "[GetVariableSystem.Clear('wj_dd_officers_visible')]" }
 state = {
  name = officers_live_refresh trigger_on_create = yes duration = 3 next = officers_live_refresh
  on_start = "[GetScriptedGui(Select_CString(GetVariableSystem.Exists('wj_dd_officers_visible'), 'WJ_dd_ui_people_refresh', 'WJ_dd_ui_noop')).Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
 }
 button = {
  name = "WJ_military_people_escape" size = { 0 0 }
  shortcut = "[Select_CString(Or(IsInteractionConfirmationWindowOpen, GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)), '', 'close_window')]"
  onclick = "[GetScriptedGui('WJ_dd_ui_officers_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }

 widget = {
  name = "WJ_district_officer_canvas" size = { 907.5 646 } alwaystransparent = yes
  parentanchor = top|left widgetanchor = top|left position = { 0 0 }
  scale = "[ScaleToFitElementInside('(int32)1160', '(int32)820')]"
  WJ_mt_people_frame = {}
  WJ_mt_people_layout = {
   blockoverride "people_empty" { visible = "[And(IsDataModelEmpty(Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_general_cards')), IsDataModelEmpty(Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_officer_tiles')))]" }
   blockoverride "general_visible" { visible = "[Not(IsDataModelEmpty(Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_general_cards')))]" }
   blockoverride "general_model" { datamodel = "[Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_general_cards')]" }
   blockoverride "officer_visible" { visible = "[Not(IsDataModelEmpty(Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_officer_tiles')))]" }
   blockoverride "officer_model" { datamodel = "[Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_officer_tiles')]" }

  }
  button_close = { position = { 759.5 60 } size = { 28 28 } tooltip = CLOSE_TOOLTIP
   background = { texture = "gfx/interface/colors/white.dds" color = { 0.945 0.918 0.847 0.70 } }
   background = { using = Background_Frame color = { 0.61 0.51 0.32 0.33 } } onclick = "[GetScriptedGui('WJ_dd_ui_officers_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 }
}
