# Reference: xinde-touxian seven-column portrait_shoulders list (native 125x160).
window = {
 name = "WJ_district_officers"
 size = { 1000 730 } parentanchor = center layer = middle allow_outside = yes
 using = Window_Background using = Window_Decoration_Spike using = Window_Movable
 filter_mouse = all alwaystransparent = no
 visible = "[GetScriptedGui('WJ_dd_ui_officers_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 datacontext = "[GetPlayer.MakeScope.Var('wj_dd_officers_view').Char]"
 state = { name = _show on_start = "[GetVariableSystem.Set('wj_dd_officers_visible', 'yes')]" }
 state = { name = _hide on_start = "[GetVariableSystem.Clear('wj_dd_officers_visible')]" }
 state = {
  name = officers_live_refresh trigger_on_create = yes duration = 3 next = officers_live_refresh
  on_start = "[GetScriptedGui(Select_CString(GetVariableSystem.Exists('wj_dd_officers_visible'), 'WJ_dd_ui_people_refresh', 'WJ_dd_ui_noop')).Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
 }
 widget = {
  position = { 20 10 } size = { 960 50 }
  header_pattern = {
   blockoverride "size" { size = { 960 50 } }
   blockoverride "header_text" { text = WJ_dd_ui_officers_window_title }
   blockoverride "button_close" { onclick = "[GetScriptedGui('WJ_dd_ui_officers_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
  }
 }
 WJ_mt_entries = { name = "district_transfer_fixed" position = { 128 65 } }
 scrollbox = {
  position = { 24 171 } size = { 952 529 }
  blockoverride "scrollbox_background" {}
  blockoverride "scrollbox_margins" { margin = { 4 4 } }
  blockoverride "scrollbox_content" {
   vbox = {
    layoutpolicy_horizontal = expanding spacing = 14
    widget = {
     name = "district_officers_command" size = { 926 268 } layoutpolicy_vertical = fixed
     WJ_inner_person_card = {
      position = { 243 0 }
      blockoverride "inner_title" { text = WJ_mt_governor_title }
      blockoverride "inner_animation" { portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', 'marshal', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]" }
      WJ_mt_menu_button = { position = { 396 230 } }
     }
    }
    divider = { layoutpolicy_horizontal = expanding }
    text_single = {
     layoutpolicy_horizontal = expanding size = { 910 32 }
     text = WJ_mt_rank_kingdom align = center default_format = "#high"
     background = { using = Background_Area_Dark }
    }
    dynamicgridbox = {
     datamodel = "[Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_officers_kingdom')]"
     datamodel_wrap = 7 flipdirection = yes
     item = { widget = {
      datacontext = "[Scope.Char]" size = { 133 238 }
      WJ_dd_officer_card = {}
     } }
    }
    text_single = {
     layoutpolicy_horizontal = expanding size = { 910 32 }
     text = WJ_mt_rank_duchy align = center default_format = "#high"
     background = { using = Background_Area_Dark }
    }
    dynamicgridbox = {
     datamodel = "[Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_officers_duchy')]"
     datamodel_wrap = 7 flipdirection = yes
     item = { widget = {
      datacontext = "[Scope.Char]" size = { 133 238 }
      WJ_dd_officer_card = {}
     } }
    }
    text_single = {
     layoutpolicy_horizontal = expanding size = { 910 32 }
     text = WJ_mt_rank_county align = center default_format = "#high"
     background = { using = Background_Area_Dark }
    }
    dynamicgridbox = {
     datamodel = "[Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_officers_county')]"
     datamodel_wrap = 7 flipdirection = yes
     item = { widget = {
      datacontext = "[Scope.Char]" size = { 133 238 }
      WJ_dd_officer_card = {}
     } }
    }
   }
  }
 }
}
