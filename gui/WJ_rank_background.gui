types WJRankBackgroundTypes {
 type WJ_rank_background = widget {
  size = { 96% 96% }
  parentanchor = center
  widgetanchor = center
  alwaystransparent = yes
  background = { texture = "gfx/interface/hd_baiguan/rank_count_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)3')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_duke_blue_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)4')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_kingdom_hui_v2.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)5')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_empire_cloud_muted_v3.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)6')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_hegemony_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)7')))]" }
 }
 type WJ_rank_frame = widget {
  size = { 96% 96% }
  parentanchor = center
  widgetanchor = center
  scissor = no
  alwaystransparent = yes
  # Preserve the other ranks' accepted clipping and coordinates.
  widget = {
   size = { 100% 100% }
   parentanchor = top|left
   widgetanchor = top|left
   scissor = yes
   alwaystransparent = yes
   icon = { parentanchor = center widgetanchor = center size = { 110.485% 110.387% } texture = "gfx/interface/hd_baiguan/frame_count_v1.png" alwaystransparent = yes visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)3')))]" }
   icon = { parentanchor = center widgetanchor = center size = { 109.138% 109.329% } texture = "gfx/interface/hd_baiguan/frame_duke_v1.png" alwaystransparent = yes visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)4')))]" }
   icon = { parentanchor = top|left widgetanchor = top|left position = { -4.332756% -4.427083% } size = { 108.665511% 108.854167% } texture = "gfx/interface/hd_baiguan/frame_kingdom_bronze_v2.png" alwaystransparent = yes visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)5')))]" }
  }
  # Fit the original hegemony straight rails; projecting dragons remain visible.
  icon = { parentanchor = top|left widgetanchor = top|left position = { -3.135593% -3.741497% } size = { 106.271186% 106.632653% } texture = "gfx/interface/hd_baiguan/frame_hegemony_v1.png" alwaystransparent = yes visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)7')))]" }
  # Register the empire body rails while allowing its corner and side ornaments to project.
  icon = { parentanchor = top|left widgetanchor = top|left position = { -4.141501% -4.580812% } size = { 108.196721% 108.383751% } texture = "gfx/interface/hd_baiguan/frame_empire_chi_v2.png" alwaystransparent = yes visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsValid, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)6')))]" }
 }
 # Keep the approved large emperor composition; small portraits use registered edges above.
 type WJ_rank_background_large = widget {
  size = { 92% 92% }
  parentanchor = center
  widgetanchor = center
  alwaystransparent = yes
  background = { texture = "gfx/interface/hd_baiguan/rank_count_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)3')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_duke_blue_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)4')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_kingdom_hui_v2.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)5')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_empire_cloud_muted_v3.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)6')))]" }
  background = { texture = "gfx/interface/hd_baiguan/rank_hegemony_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)7')))]" }
 }
 type WJ_rank_frame_large = widget {
  size = { 100% 100% }
  alwaystransparent = yes
  background = { texture = "gfx/interface/hd_baiguan/frame_count_v1.png" margin = { -4 -4 } visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)3')))]" }
  background = { texture = "gfx/interface/hd_baiguan/frame_duke_v1.png" margin = { -4 -4 } visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)4')))]" }
  background = { texture = "gfx/interface/hd_baiguan/frame_kingdom_bronze_v2.png" margin = { -4 -4 } visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)5')))]" }
  background = { texture = "gfx/interface/hd_baiguan/frame_empire_chi_v2.png" margin = { -4 -4 } visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)6')))]" }
  background = { texture = "gfx/interface/hd_baiguan/frame_hegemony_v1.png" margin = { -4 -4 } visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.HasLandedTitles, EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)7')))]" }
 }

 type WJ_rank_native_background = widget {
  size = { 100% 100% }
  parentanchor = top|left
  widgetanchor = top|left
  alwaystransparent = yes
  widget = { size = { 100% 100% } alwaystransparent = yes visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), Not(And(Character.IsDiarchOf(Character.GetLiege), And(Character.IsValid, And(GreaterThanOrEqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)3'), LessThanOrEqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)7'))))))]" WJ_rank_background = {} }
  widget = {
   visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsDiarchOf(Character.GetLiege), And(Character.IsValid, And(GreaterThanOrEqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)3'), LessThanOrEqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)7')))))]"
   alwaystransparent = yes
   parentanchor = top|left
   widgetanchor = top|left
   block "rank_regency_bounds" { position = { 3 19 } size = { 81 69 } }
   background = { texture = "gfx/interface/hd_baiguan/rank_count_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)3'))]" }
   background = { texture = "gfx/interface/hd_baiguan/rank_duke_blue_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)4'))]" }
   background = { texture = "gfx/interface/hd_baiguan/rank_kingdom_hui_v2.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)5'))]" }
   background = { texture = "gfx/interface/hd_baiguan/rank_hegemony_v1.png" visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)7'))]" }
  }
  # Follow the old background layer/margins; retain its alpha beneath the native frame's shadows.
  background = {
   visible = "[And(And(Character.IsValid, Character.GetGovernment.IsType('celestial_government')), And(Character.IsDiarchOf(Character.GetLiege), EqualTo_int32(Character.GetPrimaryTitle.GetTierFrame, '(int32)6')))]"
   texture = "gfx/interface/hd_baiguan/rank_empire_cloud_muted_v3.png"
   margin = { -4 -4 }
   modify_texture = {
    texture = "gfx/portraits/portrait_rank_back.dds"
    framesize = { 196 194 }
    frame = "[Character.GetPrimaryTitle.GetTierFrame]"
    blend_mode = alphamultiply
   }
  }

 }
}
