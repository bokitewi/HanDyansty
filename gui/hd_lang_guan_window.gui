window = {
	name = "hd_lang_guan_window"
	size = { 1500 500 }
	parentanchor = center
	layer = top
	movable = yes
	min_dist_from_screen_edge = 200
	datacontext = "[AccessCouncilWindow]"
	visible = "[And( GetVariableSystem.HasValue( 'hd_lang_guan_visibility', 'true' ), And( GetVariableSystem.HasValue( 'hd_baiguan_visibility', 'true' ), And( IsGameViewOpen( 'council_window' ), CouncilWindow.GetCharacter.IsValid ) ) )]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		on_finish = "[GetVariableSystem.Clear( 'hd_lang_guan_visibility' )]"
	}

	icon = {
		name = "hd_lang_guan_background_art"
		position = { 0 0 }
		size = { 1500 500 }
		texture = "gfx/interface/hd_baiguan/hd_lang_guan_window.png"
		alwaystransparent = yes
	}

	button_close = {
		name = "hd_lang_guan_close_button"
		parentanchor = top|left
		position = { 1448 8 }
		size = { 32 32 }
		focuspolicy = click
		shortcut = close_window
		tooltip = CLOSE_TOOLTIP
		onclick = "[GetVariableSystem.Clear( 'hd_lang_guan_visibility' )]"
	}

	scrollarea = {
		name = "hd_lang_guan_characters_scroll_area"
		parentanchor = top|left
		position = { 30 135 }
		size = { 1440 230 }
		scrollbarpolicy_vertical = always_off
		scrollbarpolicy_horizontal = as_needed

		scrollbar_horizontal = {
			using = Scrollbar_Horizontal
		}

		scrollwidget = {
			hbox = {
			name = "hd_lang_guan_characters_list"
			datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList( 'hd_lang_guan_characters' )]"
			spacing = 6

			item = {
				vbox = {
					datacontext = "[Scope.Char]"
					size = { 90 116 }
					spacing = 2

					portrait_head_small = {
						size = { 85 90 }
						blockoverride "coa" {}
						blockoverride "opinion_box" {}
					}

					text_single = {
						name = "hd_lang_guan_character_name"
						size = { 90 20 }
						text = "[Character.GetShortUINameNoTooltip]"
						default_format = "#high"
						align = center|nobaseline
						autoresize = no
						max_width = 90
					}
				}
			}
		}
	}
}
}
