types hd_secondary_army_types
{
	# Scope.Char lists are characters, not CharacterListItem selection models.
	type hd_secondary_character_box = widget {
		size = { 500 110 }
		visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]"
		background = {
			texture = "gfx/interface/buttons/button_entry_characterlist.dds"
			framesize = { 252 80 } spriteType = Corneredtiled spriteborder = { 10 30 }
		}
		portrait_head_small = {
			position = { 8 8 }
			blockoverride "coa" {} blockoverride "opinion_box" {}
			blockoverride "show_portrait_status_icons" { visible = no }
		}
		button_standard_clean = {
			position = { 108 12 } size = { 336 38 }
			onclick = "[DefaultOnCharacterClick(Character.GetID)]"
			text_single = {
				size = { 336 38 } text = "[Character.Custom('WJ_GetUIName')]"
				fontsize = 17 autoresize = no align = left|vcenter alwaystransparent = yes
			}
		}
		button_standard = {
			position = { 112 66 } size = { 204 30 } text = WJ_mt_subordinates
			onclick = "[GetScriptedGui('WJ_mt_ui_subordinates').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End)]"
		}
		WJ_mt_menu_button = { position = { 454 62 } }
	}
	type hd_secondary_commander = widget {
		size = { 272 312 }
		layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
		block "command_visible" {
			visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]"
		}
		portrait_button = {
			position = { 32 72 } size = { 208 240 } using = portrait_base
			portrait_texture = "[Character.GetAnimatedPortrait('environment_torso', 'camera_torso', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			mask = "gfx/portraits/portrait_mask_torso.dds" effectname = "NoHighlight"
		}
		# Role lines are independent: a merged person keeps every held command.
		vbox = {
			position = { 0 0 } size = { 272 72 } spacing = 0 ignoreinvisible = yes
			layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
			text_single = {
				size = { 272 18 } text = WJ_inner_general fontsize = 16 align = center|nobaseline autoresize = no
				layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed fontcolor = { 0.18 0.12 0.10 1 }
				visible = "[ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal'))]"
			}
			text_single = {
				size = { 272 18 } text = WJ_inner_dasima fontsize = 16 align = center|nobaseline autoresize = no
				layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed fontcolor = { 0.18 0.12 0.10 1 }
				visible = "[And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char))]"
			}
			text_single = {
				size = { 272 18 } text = trait_WJ_zhongwai fontsize = 16 align = center|nobaseline autoresize = no
				layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed fontcolor = { 0.18 0.12 0.10 1 }
				visible = "[And(GetScriptedGui('hd_secondary_zw_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetDiarchy.GetDiarch))]"
			}
			text_single = {
				size = { 272 18 } text = "[Character.GetNameNoTooltip]" tooltip = "[Character.GetNameNoTooltip]"
				fontsize = 14 align = center|nobaseline autoresize = no
				layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed fontcolor = { 0.18 0.12 0.10 1 }
			}
		}
		button_round = {
			position = { 244 132 } size = { 24 24 }
			datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]"
			visible = "[And(ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter), And(ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal')), GuiCouncilPosition.CanPotentiallySelectCouncillor))]"
			enabled = "[GuiCouncilPosition.CanSelectCouncillor]"
			onclick = "[GuiCouncilPosition.SelectCouncillor]" tooltip = "[GuiCouncilPosition.GetSelectCouncillorTooltip]"
			button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
		}
		button_round = {
			position = { 244 166 } size = { 24 24 }
			visible = "[And(ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter), And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char)))]"
			enabled = "[GetScriptedGui('WJ_dasima_open_picker').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			onclick = "[GetScriptedGui('WJ_dasima_open_picker').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			tooltip = WJ_inner_select_dasima
			button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
		}
		WJ_mt_menu_button = { position = { 238 200 } }
		text_single = {
			position = { 0 218 } size = { 124 20 } text = WJ_mt_huangyue_status fontsize = 13 align = center|nobaseline
			fontcolor = { 0.18 0.12 0.10 1 }
			visible = "[And(GetScriptedGui('hd_secondary_huangyue_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetDiarchy.GetDiarch))]"
		}
	}
}

window = {
	name = "secondary_frame"
	enabled = "[Not(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
	# Keep native drag coordinates unscaled; only the content canvas is transformed.
	size = "[FloatToCVector2f(Multiply_float('(float)1448', ScaleToFitElementInside('(int32)1500', '(int32)1200')), Multiply_float('(float)1150', ScaleToFitElementInside('(int32)1500', '(int32)1200')))]"
	parentanchor = center widgetanchor = center layer = top alwaystransparent = no
	using = Window_Movable
	allow_outside = yes
	datacontext = "[AccessCouncilWindow]"
	# Hiding for a child window never clears the secondary open state.
	visible = "[And(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), And(GetPlayer.IsValid, And(CouncilWindow.GetCharacter.IsValid, And(Not(Or(GetPlayer.MakeScope.Var('wj_mt_open').IsSet, GetPlayer.MakeScope.Var('wj_mt_subordinate_head').IsSet)), Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes'))))))))]"
	state = { name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard }
	state = { name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard }
	widget = {
		name = "hd_secondary_canvas"
		size = { 1448 1150 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 }
		scale = "[ScaleToFitElementInside('(int32)1500', '(int32)1200')]"
		widget = {
			name = "hd_secondary_eligibility_guard" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
			state = { name = _show on_start = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]" }
		}
		widget = {
			name = "hd_secondary_roster_sync" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('WJ_mt_ui_roster_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			state = { name = _show on_start = "[GetScriptedGui('WJ_mt_ui_central').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
		}
		# Preserve the source dimensions; the last 187px are fully transparent.
		icon = {
			name = "hd_secondary_background" size = { 1448 1337 }
			texture = "gfx/interface/hd_baiguan/secondary_frame.png" alwaystransparent = yes
		}
		text_single = {
			position = { 210 428 } size = { 440 32 } text = WJ_baiguan_tab_army fontsize = 24
			fontcolor = { 0.18 0.12 0.10 1 } autoresize = no
		}
		button_close = {
			position = { 1336 428 } size = { 32 32 } shortcut = "[Select_CString(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), '', 'close_window')]" tooltip = CLOSE_TOOLTIP
			onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
		}
		scrollbox = {
			name = "hd_secondary_roster" position = { 205 465 } size = { 1085 270 }
			blockoverride "scrollbox_background" {}
			blockoverride "scrollbox_margins" { margin = { 8 4 } }
			blockoverride "scrollbox_content" { vbox = {
				layoutpolicy_horizontal = expanding spacing = 8 ignoreinvisible = yes
				widget = {
					name = "hd_secondary_transfer_header" size = { 1030 98 }
					WJ_mt_entries = { parentanchor = top|hcenter }
				}
				text_single = {
					size = { 1030 28 } text = WJ_mt_generals fontsize = 20 align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
				}
				text_single = {
					size = { 1030 28 } text = hd_secondary_no_generals fontsize = 16 align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
					visible = "[Not(GetScriptedGui('hd_secondary_generals_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				}
				dynamicgridbox = {
					name = "hd_secondary_generals" datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_generals')]"
					datamodel_wrap = 2 flipdirection = yes ignoreinvisible = yes
					item = { hd_secondary_character_box = { datacontext = "[Scope.Char]" } }
				}
				text_single = {
					size = { 1030 28 } text = hd_secondary_officials fontsize = 20 align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
				}
				text_single = {
					size = { 1030 28 } text = hd_secondary_no_officials fontsize = 16 align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
					visible = "[Not(GetScriptedGui('hd_secondary_officials_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				}
				dynamicgridbox = {
					name = "hd_secondary_officers" datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_officials')]"
					datamodel_wrap = 2 flipdirection = yes ignoreinvisible = yes
					item = { hd_secondary_character_box = { datacontext = "[Scope.Char]" } }
				}
			} }
		}
		widget = {
			name = "hd_secondary_command_band" position = { 296 738 } size = { 856 312 } alwaystransparent = yes
			text_single = {
				size = { 856 312 } text = hd_secondary_no_commanders fontsize = 20 align = center|vcenter
				fontcolor = { 0.18 0.12 0.10 1 }
				visible = "[Not(Or(And(CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal').IsValid, And(CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal').IsAlive, ObjectsEqual(CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal').GetTopLiege, CouncilWindow.GetCharacter))), Or(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), GetScriptedGui('hd_secondary_zw_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))))]"
			}
			hbox = {
				name = "hd_secondary_commanders" parentanchor = top|hcenter widgetanchor = top|hcenter
				layoutpolicy_horizontal = growing spacing = 20 ignoreinvisible = yes
				hd_secondary_commander = {
					name = "hd_secondary_dasima" datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char]"
					blockoverride "command_visible" {
						visible = "[And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), Not(ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal'))))]"
					}
				}
				hd_secondary_commander = {
					name = "hd_secondary_general"
					datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]"
					datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
					datacontext = "[ActiveCouncilTask.GetPositionType]"
					datacontext = "[ActiveCouncilTask.GetCouncillor]"
				}
				hd_secondary_commander = {
					name = "hd_secondary_zhongwai" datacontext = "[CouncilWindow.GetCharacter.GetDiarchy.GetDiarch]"
					blockoverride "command_visible" {
						visible = "[And(GetScriptedGui('hd_secondary_zw_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), And(Not(ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal'))), Not(And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char)))))]"
					}
				}
			}
		}
	}
}
