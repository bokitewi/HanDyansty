types hd_secondary_army_types
{
	# Scope.Char lists are characters, not CharacterListItem selection models.
 type hd_secondary_character_box = widget {
  size = { 512 114 }
  visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]"
  WJ_mt_small_person = { position = { 8 8 } }
  button_standard_clean = {
   position = { 106 4 } size = { 398 44 }
   tooltip = "[Character.Custom('WJ_GetUIName')]" onclick = "[DefaultOnCharacterClick(Character.GetID)]"
   text_multi = { size = { 398 44 } max_width = 398 multiline = yes text = "[Character.Custom('WJ_GetUIName')]" fontsize = 16 autoresize = no align = left|vcenter alwaystransparent = yes default_format = "#hd_black" }
  }
  text_single = { position = { 106 49 } size = { 398 20 } text = "[Character.GetPrimaryTitle.GetNameNoTooltip]" tooltip = "[Character.GetPrimaryTitle.GetNameNoTooltip]" fontsize = 14 autoresize = no default_format = "#hd_black" }
  WJ_mt_bright_button = {
   position = { 106 76 } size = { 260 30 } text = WJ_mt_subordinates
   enabled = "[GetScriptedGui('WJ_mt_ui_subordinates').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End)]"
   tooltip = "[Select_CString(GetScriptedGui('WJ_mt_ui_subordinates').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End), Localize('WJ_mt_subordinates'), GetScriptedGui('WJ_mt_ui_subordinates').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End))]"
   onclick = "[GetScriptedGui('WJ_mt_ui_subordinates').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End)]"
  }
 }
 type hd_secondary_commander = widget {
  size = { 352 244 } minimumsize = { 352 244 }
  layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed
  block "command_visible" { visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]" }
  hbox = {
   size = { 100% 100% } spacing = 12
   widget = {
    name = "hd_command_portrait_information" size = { 198 244 } layoutpolicy_horizontal = fixed
    WJ_mt_skills_strip = { position = { 0 0 } }
    WJ_mt_halfbody = { position = { 0 28 } }
   }
   vbox = {
    name = "hd_command_text_and_actions" size = { 0 244 } layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 4
    background = { texture = "gfx/interface/colors/white.dds" color = { 0.91 0.86 0.77 1 } alpha = 0.32 using = Mask_Rough_Edges }
    WJ_mt_name_age = { layoutpolicy_horizontal = expanding blockoverride "name_age_layout" { size = { 150 36 } } blockoverride "name_age_text_layout" { size = { 80 36 } maximumsize = { 80 36 } max_width = 80 fontsize = 20 } blockoverride "name_age_text" { text = "[Character.GetFirstNameNoTooltip]" } }

    hbox = {
     name = "hd_command_duties" size = { 0 160 } layoutpolicy_horizontal = expanding spacing = 10 ignoreinvisible = yes
      vbox = {
       name = "hd_command_general_duty" visible = "[ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal'))]"
       size = { 138 160 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed spacing = 4 ignoreinvisible = yes
       text_single = { datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]" datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]" layoutpolicy_horizontal = expanding size = { 138 48 } max_width = 138 maximumsize = { 138 48 } multiline = yes text = "[ActiveCouncilTask.GetPositionName]" tooltip = "[ActiveCouncilTask.GetPositionName]" fontsize = 23 fontsize_min = 21 autoresize = no default_format = "#hd_black" }
       text_multi = { layoutpolicy_horizontal = expanding size = { 138 0 } max_width = 138 text = WJ_mt_general_duty fontsize = 16 autoresize = yes default_format = "#hd_black" }
       text_multi = { layoutpolicy_horizontal = expanding size = { 138 0 } max_width = 138 text = WJ_mt_general_note fontsize = 14 autoresize = yes default_format = "#hd_black" }
      }
      vbox = {
       name = "hd_command_dasima_duty" visible = "[And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char))]"
       size = { 138 160 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed spacing = 4 ignoreinvisible = yes

       text_single = { layoutpolicy_horizontal = expanding size = { 138 48 } max_width = 138 maximumsize = { 138 48 } multiline = yes text = "[GetCourtPositionType('WJ_dasima_court_position').GetName]" tooltip = "[GetCourtPositionType('WJ_dasima_court_position').GetName]" fontsize = 23 fontsize_min = 21 autoresize = no default_format = "#hd_black" }
       text_multi = { layoutpolicy_horizontal = expanding size = { 138 0 } max_width = 138 text = WJ_mt_dasima_duty fontsize = 16 autoresize = yes default_format = "#hd_black" }
       text_multi = { layoutpolicy_horizontal = expanding size = { 138 0 } max_width = 138 text = WJ_mt_dasima_note fontsize = 14 autoresize = yes default_format = "#hd_black" }
      }
      vbox = {
       name = "hd_command_zhongwai_duty" visible = "[GetScriptedGui('hd_secondary_person_zhongwai').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
       size = { 138 160 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed spacing = 4 ignoreinvisible = yes

       text_single = { layoutpolicy_horizontal = expanding size = { 138 48 } max_width = 138 maximumsize = { 138 48 } multiline = yes text = "[GetTrait('WJ_zhongwai').GetName(Character.Self)]" tooltip = "[GetTrait('WJ_zhongwai').GetName(Character.Self)]" fontsize = 23 fontsize_min = 21 autoresize = no default_format = "#hd_black" }
       text_multi = { layoutpolicy_horizontal = expanding size = { 138 0 } max_width = 138 text = WJ_mt_zhongwai_duty fontsize = 16 autoresize = yes default_format = "#hd_black" }
       text_single = { layoutpolicy_horizontal = expanding size = { 0 20 } text = WJ_mt_huangyue_status fontsize = 14 default_format = "#hd_black" visible = "[GetScriptedGui('hd_secondary_huangyue_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]" }
      }
     expand = {}
    }
    WJ_mt_strength_actions = {
     name = "hd_command_actions" layoutpolicy_horizontal = expanding
     blockoverride "strength_row_layout" { size = { 150 32 } }
     blockoverride "strength_text_layout" { max_width = 40 fontsize = 16 }
     blockoverride "strength_menu_layout" { size = { 28 28 } }
     blockoverride "strength_extra_actions" {
		WJ_ty_council_change_entry = {
            size = { 24 24 }
            datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]"
            visible = "[ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal'))]"
        }
		button_round = {
			 size = { 24 24 }
			visible = "[And(GetScriptedGui('WJ_ty_native_appoint').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', GetCourtPositionType('WJ_dasima_court_position').MakeScope).End), And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char)))]"
			enabled = "[GetScriptedGui('WJ_ty_native_appoint').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', GetCourtPositionType('WJ_dasima_court_position').MakeScope).End)]"
			onclick = "[GetScriptedGui('WJ_ty_native_appoint').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_native_owner', CouncilWindow.GetCharacter.MakeScope).AddScope('wj_ty_native_court_type', GetCourtPositionType('WJ_dasima_court_position').MakeScope).End)]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
			onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
			tooltip = WJ_inner_select_dasima
			button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
		}
     }
    }


   }
  }
 }

}

window = {
	name = "secondary_frame"
	enabled = "[Not(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))]"
	# Keep native drag coordinates unscaled; only the content canvas is transformed.
	size = "[FloatToCVector2f(Multiply_float('(float)1448', ScaleToFitElementInside('(int32)1500', '(int32)1200')), Multiply_float('(float)1150', ScaleToFitElementInside('(int32)1500', '(int32)1200')))]"
	parentanchor = center widgetanchor = center layer = middle alwaystransparent = no
	position = { -48 0 }
	using = Window_Movable
	allow_outside = yes
	datacontext = "[AccessCouncilWindow]"
	# Hiding for a child window never clears the secondary open state.
	visible = "[And(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), And(GetPlayer.IsValid, And(Not(GetVariableSystem.Exists('hd_baiguan_native_cover')), And(CouncilWindow.GetCharacter.IsValid, And(Not(Or(GetPlayer.MakeScope.Var('wj_mt_open').IsSet, GetPlayer.MakeScope.Var('wj_mt_subordinate_head').IsSet)), Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes')))))))))]"
	state = { name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard }
	state = { name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard }
	widget = {
		name = "hd_secondary_canvas"
		size = { 1448 1150 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 }
		scale = "[ScaleToFitElementInside('(int32)1500', '(int32)1200')]"
		widget = {
			name = "hd_secondary_eligibility_guard" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
			state = { name = _show on_start = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]" }
		}
		widget = {
			name = "hd_secondary_roster_sync" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('WJ_mt_ui_roster_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			state = { name = _show on_start = "[GetScriptedGui('WJ_mt_ui_central').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
		}
		# Preserve the source dimensions; the last 187px are fully transparent.
		icon = {
			name = "hd_secondary_background" size = { 1448 1337 }
			texture = "gfx/interface/hd_baiguan/secondary_frame.png" alwaystransparent = yes
		}
		text_single = {
			position = { 205 403 } size = { 440 32 } text = WJ_baiguan_tab_army fontsize = 27
			fontcolor = { 0 0 0 1 } default_format = "#hd_black" autoresize = no
		}
		button_close = {
			position = { 1336 428 } size = { 32 32 } shortcut = "[Select_CString(Or(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End), Or(GetPlayer.MakeScope.Var('wj_mt_subordinate_head').IsSet, GetScriptedGui('WJ_dd_ui_officers_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))), '', 'close_window')]" tooltip = CLOSE_TOOLTIP
			onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
		}
		# Transfer entries stay pinned above the scrolling roster.
		widget = {
			name = "hd_secondary_transfer_header" position = { 205 448 } size = { 1085 82 }
			WJ_mt_entries = {
				parentanchor = top|left widgetanchor = top|left
				blockoverride "transfer_visible" { visible = yes }
				blockoverride "transfer_size" { size = { 1085 82 } }
				blockoverride "title_group_layout" { position = { 0 0 } size = { 525 82 } }
				blockoverride "title_source_layout" { position = { 12 0 } size = { 64 92 } scale = 0.8 }
				blockoverride "title_button_tooltip" { tooltip = "[Select_CString(GetScriptedGui('WJ_mt_ui_free').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_mt_ui_open_title').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('hd_secondary_transfer_no_authority'))]" }
				blockoverride "title_button_layout" { position = { 94 20 } size = { 330 38 } }
				blockoverride "title_receiver_layout" { position = { 458 0 } size = { 64 92 } scale = 0.8 }
				blockoverride "private_group_layout" { position = { 560 0 } size = { 525 82 } }
				blockoverride "private_source_layout" { position = { 12 0 } size = { 64 92 } scale = 0.8 }
				blockoverride "private_button_tooltip" { tooltip = "[Select_CString(GetScriptedGui('WJ_mt_ui_free').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_mt_ui_open_private').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('hd_secondary_transfer_no_authority'))]" }
				blockoverride "private_button_layout" { position = { 94 20 } size = { 330 38 } }
				blockoverride "private_receiver_layout" { position = { 458 0 } size = { 64 92 } scale = 0.8 }
			}
		}
		scrollbox = {
			name = "hd_secondary_roster" position = { 205 548 } size = { 1085 268 }
			blockoverride "scrollbox_background" {}
			blockoverride "scrollbox_margins" { margin = { 8 4 } }
			blockoverride "scrollbox_content" { vbox = {
				layoutpolicy_horizontal = expanding spacing = 4 ignoreinvisible = yes
				vbox = {
					name = "hd_secondary_generals_group" spacing = 4 ignoreinvisible = yes
					visible = "[GetScriptedGui('hd_secondary_generals_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						size = { 1056 20 } text = WJ_mt_generals fontsize = 19 align = center|nobaseline
						fontcolor = { 0 0 0 1 } default_format = "#hd_black"
					}
					dynamicgridbox = {
						name = "hd_secondary_generals" datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_generals')]"
						datamodel_wrap = 2 flipdirection = yes ignoreinvisible = yes
						item = { widget = { size = { 528 118 } hd_secondary_character_box = { datacontext = "[Scope.Char]" } } }
					}
				}
				vbox = {
					name = "hd_secondary_officials_group" spacing = 4 ignoreinvisible = yes
					visible = "[GetScriptedGui('hd_secondary_officials_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text_single = {
						size = { 1056 20 } text = hd_secondary_officials fontsize = 19 align = center|nobaseline
						fontcolor = { 0 0 0 1 } default_format = "#hd_black"
					}
					dynamicgridbox = {
						name = "hd_secondary_officers" datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_officials')]"
						datamodel_wrap = 2 flipdirection = yes ignoreinvisible = yes
						item = { widget = { size = { 528 118 } hd_secondary_character_box = { datacontext = "[Scope.Char]" } } }
					}
				}
				text_single = {
					size = { 1056 200 } text = hd_secondary_no_roster fontsize = 18 align = center|vcenter
					fontcolor = { 0 0 0 1 } default_format = "#hd_black"
					visible = "[Not(Or(GetScriptedGui('hd_secondary_generals_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('hd_secondary_officials_present').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
				}
			} }
		}
		icon = {
			name = "hd_secondary_command_rule" position = { 205 820 } size = { 1085 1 }
			texture = "gfx/interface/colors/white.dds" color = { 0.48 0.42 0.29 0.7 } alwaystransparent = yes
		}
		widget = {
			name = "hd_secondary_command_band" position = { 205 820 } size = { 1085 244 } alwaystransparent = yes
			text_single = {
				size = { 1085 244 } text = hd_secondary_no_commanders fontsize = 20 align = center|vcenter
				fontcolor = { 0 0 0 1 } default_format = "#hd_black"
				visible = "[Not(Or(And(CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal').IsValid, And(CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal').IsAlive, ObjectsEqual(CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal').GetTopLiege, CouncilWindow.GetCharacter))), Or(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), GetScriptedGui('hd_secondary_zw_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))))]"
			}
			hbox = {
				name = "hd_secondary_commanders" parentanchor = top|hcenter widgetanchor = top|hcenter
				position = { 0 0 } size = { 1085 244 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed spacing = 12 ignoreinvisible = yes
				hd_secondary_commander = {
					name = "hd_secondary_general"
					datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]"
					datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
					datacontext = "[ActiveCouncilTask.GetPositionType]"
					datacontext = "[ActiveCouncilTask.GetCouncillor]"
				}
				hd_secondary_commander = {
					name = "hd_secondary_dasima" datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char]"
					blockoverride "command_visible" {
						visible = "[And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), Not(ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal'))))]"
					}
				}
				hd_secondary_commander = {
					name = "hd_secondary_zhongwai" datacontext = "[CouncilWindow.GetCharacter.GetDiarchy.GetDiarch]"
					blockoverride "command_visible" {
						visible = "[And(GetScriptedGui('hd_secondary_zw_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), And(Not(ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.GetCouncillor('minister_grand_marshal'))), Not(And(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End), ObjectsEqual(Character.Self, CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char)))))]"
					}
				}
			}
		}
	}
}
