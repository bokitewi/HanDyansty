types hd_hev_types
{
	type hd_hev_group_header = hbox {
		layoutpolicy_horizontal = expanding
		margin_top = 8
		spacing = 6
		text_single = {
			block "grp_name" {}
			using = Font_Size_Medium
		}
		text_single = {
			block "grp_here" {}
			text = hd_hev_grp_here
			using = Font_Size_Medium
		}
		expand = {}
	}

	type hd_hev_row = hbox {
		layoutpolicy_horizontal = expanding
		margin_left = 12
		text_single = {
			block "row_name" {}
			size = { 560 24 }
			align = left|nobaseline
			alwaystransparent = no
			using = Font_Size_Small
		}
		expand = {}
		widget = {
			size = { 110 24 }
			text_single = {
				block "st_done" {}
				text = hd_hev_st_done
				parentanchor = vcenter
				using = Font_Size_Small
			}
			text_single = {
				block "st_wait" {}
				text = hd_hev_st_wait
				parentanchor = vcenter
				using = Font_Size_Small
			}
			text_single = {
				block "st_na" {}
				text = hd_hev_st_na
				parentanchor = vcenter
				using = Font_Size_Small
			}
		}
	}
