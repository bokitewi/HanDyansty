# 历史事件列表窗口（debug 模式）。按钮在 hud.gui 右侧主按钮列最下方，开关 GetVariableSystem 的 hd_hev_open。
# 行和组由生成器写出；状态：已触发＝行 gui；未触发＝适用但行 gui 为假；非本局＝适用 gui 为假。
window = {
	name = "hd_hev_window"
	parentanchor = center
	size = { 780 860 }
	layer = middle
	allow_outside = yes
	using = Window_Background
	using = Window_Decoration_Spike
	using = Window_Movable
	filter_mouse = all
	alwaystransparent = no
	visible = "[And(InDebugMode, And(GetPlayer.IsValid, GetVariableSystem.Exists('hd_hev_open')))]"
	vbox = {
		using = Window_Margins
		spacing = 4
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" { text = hd_hev_window_title }
			blockoverride "button_close" {
				name = "hd_hev_close"
				onclick = "[GetVariableSystem.Clear('hd_hev_open')]"
			}
		}
		text_multi = {
			text = hd_hev_window_help
			using = Font_Size_Small
			autoresize = yes
			max_width = 720
			min_width = 720
		}
		text_multi = {
			text = hd_hev_window_rule_off
			visible = "[GetScriptedGui('hd_hev_rule_off').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = Font_Size_Small
			autoresize = yes
			max_width = 720
			min_width = 720
		}
		scrollbox = {
			name = "hd_hev_body"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					hd_hev_group_header = {
						blockoverride "grp_name" { text = hd_hev_grp_22_name }
						blockoverride "grp_here" { visible = "[GetScriptedGui('hd_hev_grp_22').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
					}
					hd_hev_row = {
						blockoverride "row_name" { text = hd_hev_22_01_name tooltip = hd_hev_22_01_tt }
						blockoverride "st_done" { visible = "[GetScriptedGui('hd_hev_22_01').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						blockoverride "st_wait" { visible = "[And(GetScriptedGui('hd_hev_ap_s22').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui('hd_hev_22_01').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" }
						blockoverride "st_na" { visible = "[Not(GetScriptedGui('hd_hev_ap_s22').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
					}
					hd_hev_row = {
						blockoverride "row_name" { text = hd_hev_22_02_name tooltip = hd_hev_22_02_tt }
						blockoverride "st_done" { visible = "[GetScriptedGui('hd_hev_22_02').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						blockoverride "st_wait" { visible = "[And(GetScriptedGui('hd_hev_ap_s22').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui('hd_hev_22_02').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" }
						blockoverride "st_na" { visible = "[Not(GetScriptedGui('hd_hev_ap_s22').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
					}
					hd_hev_row = {
						blockoverride "row_name" { text = hd_hev_22_03_name tooltip = hd_hev_22_03_tt }
						blockoverride "st_done" { visible = "[GetScriptedGui('hd_hev_22_03').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
						blockoverride "st_wait" { visible = "[And(GetScriptedGui('hd_hev_ap_s22').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui('hd_hev_22_03').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" }
