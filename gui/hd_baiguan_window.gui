# Task 1: court page only. The master's scripted_widgets registration instantiates this name.
types hd_baiguan_types
{
 # Native council portrait camera/mask and search-list skill/health primitives.

 type WJ_inner_household_card = widget {
  size = { 260 180 }
  background = { using = Background_Area_Light }
  text_single = {
   position = { 10 6 } size = { 240 30 } default_format = "#high" align = center
   block "household_title" { text = WJ_inner_vacant }
  }
  widget = {
   position = { 6 40 } size = { 248 134 }
   block "household_person_visible" { visible = "[And(Character.IsValid, Character.IsAlive)]" }
   portrait_button = {
    position = { 0 0 } size = { 112 128 } using = portrait_base
    portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
    mask = "gfx/portraits/portrait_mask_council.dds" effectname = "NoHighlight"
   }
   widget = { position = { 38 100 } size = { 60 25 } portrait_opinion = {} }
   text_single = { position = { 118 14 } size = { 124 50 } text = "[SelectLocalization( Character.IsValid, 'WJ_UI_SHORT_NAME_VALID', '' )|U]" autoresize = no fontsize_min = 13 }
   widget = { position = { 118 82 } size = { 64 25 } character_age_health = {} }
  }
  text_single = {
   position = { 20 84 } size = { 220 30 } align = center text = WJ_inner_vacant
   block "household_vacant_visible" { visible = "[Not(And(Character.IsValid, Character.IsAlive))]" }
  }
 }
 type WJ_inner_person_card = widget {
  size = { 440 268 }
  # Exact garden illustration, rough edge mask and vignette used by the native chancellor card.
  background = {
   block "inner_scene" { texture = "gfx/interface/illustrations/event_scenes/tgp_garden_asia.dds" }
   fittype = centercrop alpha = 0.7 using = Mask_Rough_Edges
  }
  background = {
   texture = "gfx/interface/component_masks/mask_vignette.dds"
   color = { 0.15 0.15 0.15 1 } alpha = 0.3
  }
  widget = {
   name = "WJ_inner_header_backing" size = { 440 60 } alwaystransparent = yes
   background = { using = Text_Label_Background }
  }
  widget = {
   size = { 440 268 }
   block "inner_person_visible" { visible = "[And(Character.IsValid, Character.IsAlive)]" }
   portrait_button = {
    name = "WJ_inner_scene_portrait"
    position = { 10 50 } size = { 270 212 } using = portrait_base
    block "inner_animation" { portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', 'chancellor', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]" }
    mask = "gfx/portraits/portrait_mask_council.dds" effectname = "NoHighlight"
   }
   # Fixed regions, never an expanding hbox inside a card.
   text_single = {
    name = "WJ_inner_name" position = { 10 32 } size = { 272 26 }
    text = "[SelectLocalization( Character.IsValid, 'WJ_UI_SHORT_NAME_VALID', '' )|U]" default_format = "#high" autoresize = no fontsize_min = 13
    block "inner_name_font" { fontsize = 18 }
   }
   # Native layout types stay unpositioned; only the enclosing widget owns geometry.
   widget = {
    name = "WJ_inner_skills_box" position = { 272 8 } size = { 160 25 }
    hbox_skills_grid_character_model = {}
   }
   widget = {
    position = { 368 40 } size = { 64 28 }
    background = { using = Background_Area_Dark }
    character_age_health = {}
   }
   # Native clipped 16x60 status strip cannot spill into the bottom action bar.
   portrait_status_icons_small = { position = { 228 170 } }
   coa_realm_small_crown = { position = { 10 180 } visible = "[Character.HasLandedTitles]" }
   widget = { position = { 218 238 } size = { 64 25 } portrait_opinion = {} }
  }
  text_single = {
   position = { 30 130 } size = { 380 30 } text = WJ_inner_vacant align = center
   block "inner_vacant_font" { fontsize = 18 }
   block "inner_vacant_visible" { visible = "[Not(And(Character.IsValid, Character.IsAlive))]" }
  }
  widget = {
   size = { 260 30 }
   text_single = {
    position = { 10 6 } size = { 244 24 } default_format = "#high" autoresize = no fontsize_min = 14
    block "inner_title_font" { fontsize = 18 }
    block "inner_title" { text = WJ_inner_vacant }
   }
  }
  block "inner_appointment" {}
  # Native scene stays unobscured; inner court has no council contribution/task overlay.
  block "inner_footer" {}
 }

	# Character-only component. The twelve council instances supply all four native contexts.
	type WJ_baiguan_wide_card = widget {
		size = { 332 224 }
		background = { using = Background_Area_Light }
		text_single = {
			name = "WJ_baiguan_title"
			position = { 132 22 }
			size = { 188 28 }
			default_format = "#high"
			autoresize = no
			fontsize_min = 13
			block "office_label" { text = WJ_baiguan_text_vacant }
		}
		block "person_content" {
			widget = {
				name = "WJ_baiguan_person"
				size = { 100% 100% }
				block "person_visible" { visible = "[And( Character.IsValid, And( Character.IsAlive, ObjectsEqual( Character.GetTopLiege, CouncilWindow.GetCharacter ) ) )]" }
				widget = {
					name = "WJ_baiguan_portrait_box"
					position = { 8 20 }
					size = { 120 150 }
					# Native drawing is 195x225, not merely the outer 165x200.
					# At scale .6 its 117x135 drawing fits this reserved 120x150 box.
					portrait_torso = {
						parentanchor = center
						scale = 0.6
						blockoverride "coa" {}
						blockoverride "opinion_box" {}
						blockoverride "portrait_status_icons" {}
					}
				}
				text_single = {
					name = "WJ_baiguan_name"
					position = { 132 64 }
					size = { 188 44 }
					text = "[SelectLocalization( Character.IsValid, 'WJ_UI_SHORT_NAME_VALID', '' )|U]"
					default_format = "#high"
					autoresize = no
					fontsize_min = 13
				}
			}
			text_single = {
				name = "WJ_baiguan_vacant"
				position = { 132 70 }
				size = { 188 32 }
				block "vacant_visible" { visible = "[Not( And( Character.IsValid, And( Character.IsAlive, ObjectsEqual( Character.GetTopLiege, CouncilWindow.GetCharacter ) ) ) )]" }
				block "vacancy_text" { text = WJ_baiguan_text_vacant }
				default_format = "#weak"
				autoresize = no
			}
		}
	}

	type hd_baiguan_office_slot = widget {
		size = { 76 116 }
		allow_outside = yes

		widget = {
			name = "fixed_empty_frame"
			parentanchor = top|hcenter
			size = { 68 72 }
			background = {
				using = Background_Area_Dark
				alpha = 0.82
			}
		}

		block "slot_portrait" {}

		block "slot_label" {
			text_single = {
				parentanchor = top|hcenter
				position = { 0 74 }
				size = { 76 20 }
				text = ""
				default_format = "#high"
				align = center|nobaseline
				autoresize = no
				max_width = 76
			}
		}

		block "slot_mufu" {}
	}
}

window = {
	name = "hd_baiguan_window"
	size = { 100% 100% }
	parentanchor = center
	layer = middle
	movable = no
	alwaystransparent = yes
	datacontext = "[AccessCouncilWindow]"
	# A closed native council has no character. Keep typed scripted-GUI polling
	# inside the visible shell; And() does not protect an invalid root scope.
	visible = "[And( GetVariableSystem.HasValue( 'hd_baiguan_visibility', 'true' ), And( IsDefaultGUIMode, CouncilWindow.GetCharacter.IsValid ) )]"
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	# Only the shell owns open/close state. Switching law/content cannot clear it.
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		on_finish = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
	}
	widget = {
		name = "WJ_baiguan_hanjin_scale"
		visible = "[GetScriptedGui('hd_baiguan_open_effect').IsShown( GuiScope.SetRoot( CouncilWindow.GetCharacter.MakeScope ).End )]"
		state = {
			name = _hide
			on_finish = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
		}
		size = { 1480 960 }
		parentanchor = center
		alwaystransparent = yes
		scale = "[ScaleToFitElementInside('(int32)1600', '(int32)1200')]"

		window = {
			name = "WJ_baiguan_hanjin_page"
			layer = middle
			filter_mouse = all
			size = { 1480 960 }
			parentanchor = center
			alwaystransparent = no
			allow_outside = yes
			using = Window_Background
			using = Window_Decoration
			using = Window_Movable
			visible = "[GetScriptedGui('WJ_hanjin_law_active').IsShown( GuiScope.SetRoot( CouncilWindow.GetCharacter.MakeScope ).End )]"

			# Cover the native background's 23/17px outer margins, including the painted left border.
			# Behind controls and attached to this panel, never a fullscreen map blocker.
			widget = {
				name = "WJ_baiguan_panel_input"
				position = { -23 -17 } size = { 1526 994 }
				alwaystransparent = no filter_mouse = all
			}

# LANGGUAN PAUSED: button_standard = {
# LANGGUAN PAUSED: 	   name = "hd_baiguan_lang_guan_shu_button"
# LANGGUAN PAUSED: 	   position = { 656 16 } size = { 256 32 }
# LANGGUAN PAUSED: 	   text = hd_baiguan_lang_guan_shu
# LANGGUAN PAUSED: 	   visible = "[GetScriptedGui('WJ_langguan_roster_open').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('langguan_court', CouncilWindow.GetCharacter.MakeScope).End)]"
# LANGGUAN PAUSED: 	   enabled = "[GetScriptedGui('WJ_langguan_roster_open').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('langguan_court', CouncilWindow.GetCharacter.MakeScope).End)]"
# LANGGUAN PAUSED: 	   onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
# LANGGUAN PAUSED: 	   onclick = "[GetVariableSystem.Set('hd_lang_guan_visibility', 'true')]"
# LANGGUAN PAUSED: 	   onclick = "[GetScriptedGui('WJ_langguan_roster_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('langguan_court', CouncilWindow.GetCharacter.MakeScope).End)]"
# LANGGUAN PAUSED: 	  }
			button_standard = {
				name = "WJ_baiguan_cheng_xiang_entry_button"
				position = { 928 16 }
				size = { 272 32 }
				datacontext = "[GetDecisionWithKey( 'wj_create_cheng_xiang_decision' )]"
				text = "[Decision.GetTitleForPlayer]"
				visible = no # Temporarily paused by user.
				enabled = no
				onclick = "[OpenGameViewData( 'decision_detail', Decision.Self )]"
			}

			text_single = {
				position = { 24 16 }
				size = { 600 32 }
				text = "[SelectLocalization(GetVariableSystem.HasValue('WJ_baiguan_page', 'inner'), 'WJ_baiguan_tab_inner', 'WJ_baiguan_text_court')]"
				default_format = "#high"
				autoresize = no
			}
   # Native show transition: write the three display pointers only when stale.
   # No polling state, timer, realm scan, or effect in a visible expression.
   widget = {
    name = "WJ_baiguan_display_sync" size = { 0 0 } alwaystransparent = yes
    visible = "[Not(GetScriptedGui('WJ_baiguan_display_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
    state = {
     name = _show
     on_start = "[GetScriptedGui('hd_baiguan_rebuild_effect').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
    }
   }
			button_close = {
				name = "hd_baiguan_close_button"
				position = { 1424 16 }
				size = { 32 32 }
				focuspolicy = click
				shortcut = close_window
				tooltip = CLOSE_TOOLTIP
				onclick = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
			}
			widget = {
				name = "WJ_baiguan_household"
    visible = "[Not(GetVariableSystem.HasValue('WJ_baiguan_page', 'inner'))]"
				position = { 24 64 }
				size = { 1408 180 }

						WJ_baiguan_wide_card = {
							name = "WJ_baiguan_diarch_card"
							position = { 0 0 }
							size = { 340 180 }
							datacontext = "[CouncilWindow.GetCharacter.GetDiarchy.GetDiarch]"
							blockoverride "office_label" { text = WJ_baiguan_label_diarch }

							blockoverride "person_visible" { visible = "[And( CouncilWindow.GetCharacter.HasActiveDiarchy, And( Character.IsValid, And( Character.IsAlive, ObjectsEqual( Character.GetTopLiege, CouncilWindow.GetCharacter ) ) ) )]" }
							blockoverride "vacant_visible" { visible = "[Not( And( CouncilWindow.GetCharacter.HasActiveDiarchy, And( Character.IsValid, And( Character.IsAlive, ObjectsEqual( Character.GetTopLiege, CouncilWindow.GetCharacter ) ) ) ) )]" }

						}
						WJ_baiguan_wide_card = {
							name = "WJ_baiguan_emperor_card"
							position = { 356 0 }
							size = { 340 180 }
							datacontext = "[CouncilWindow.GetCharacter]"
							blockoverride "office_label" { text = WJ_baiguan_label_emperor }
       WJ_mt_menu_button = {
        position = { 298 142 }
        visible = "[Character.IsValid]"
       }

						}
						WJ_baiguan_wide_card = {
							name = "WJ_baiguan_empress_card"
							position = { 712 0 }
							size = { 340 180 }
							datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_empress').Char]"
							blockoverride "office_label" { text = WJ_baiguan_label_empress }

						}
						WJ_baiguan_wide_card = {
							name = "WJ_baiguan_crown_prince_card"
							position = { 1068 0 }
							size = { 340 180 }
							datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_crown_prince').Char]"
							blockoverride "office_label" { text = WJ_baiguan_label_crown_prince }
							blockoverride "vacancy_text" { text = WJ_baiguan_text_undesignated }

						}
			}

   widget = {
    name = "WJ_inner_household" position = { 24 64 } size = { 1408 180 }
    visible = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'inner')]"
    WJ_inner_household_card = {
     position = { 132 0 } datacontext = "[CouncilWindow.GetCharacter.GetDiarchy.GetDiarch]"
     blockoverride "household_title" { text = WJ_inner_diarch }
     blockoverride "household_person_visible" { visible = "[And(CouncilWindow.GetCharacter.HasActiveDiarchy, And(Character.IsValid, Character.IsAlive))]" }
     blockoverride "household_vacant_visible" { visible = "[Not(And(CouncilWindow.GetCharacter.HasActiveDiarchy, And(Character.IsValid, Character.IsAlive)))]" }
    }
    WJ_inner_household_card = {
     position = { 574 0 } datacontext = "[CouncilWindow.GetCharacter]"
     blockoverride "household_title" { text = WJ_baiguan_label_emperor }
     WJ_mt_menu_button = { position = { 220 142 } visible = "[Character.IsValid]" }
    }
    WJ_inner_household_card = {
     position = { 850 0 } datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_empress').Char]"
     blockoverride "household_title" { text = WJ_baiguan_label_empress }
    }
    WJ_inner_household_card = {
     position = { 1126 0 } datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_crown_prince').Char]"
     blockoverride "household_title" { text = WJ_baiguan_label_crown_prince }
    }
   }
			widget = {
				name = "WJ_baiguan_navigation"
				position = { 24 264 }
				size = { 1408 42 }
				# Seven equal tabs: 7 * 196 + 6 * 6 = 1408; no reserved Waiqi slot.

				button_tab = {
					name = "WJ_baiguan_inner_tab"
					position = { 0 0 }
					size = { 196 42 }
					layoutpolicy_horizontal = fixed
					enabled = yes
					down = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'inner')]"
     onclick = "[GetVariableSystem.Set('WJ_baiguan_page', 'inner')]"
					blockoverride "tab_label" { text = WJ_baiguan_tab_inner }
					tooltip = WJ_inner_tab_desc
				}

				button_tab = {
					name = "WJ_baiguan_army_tab"
					position = { 202 0 }
					size = { 196 42 }
					layoutpolicy_horizontal = fixed
					enabled = yes
					down = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'army')]"
     onclick = "[GetScriptedGui('WJ_mt_ui_central').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Set('WJ_baiguan_page', 'army')]"
					blockoverride "tab_label" { text = WJ_baiguan_tab_army }
					tooltip = WJ_mt_central_desc
				}

				button_tab = {
					name = "WJ_baiguan_nobles_tab"
					position = { 404 0 }
					size = { 196 42 }
					layoutpolicy_horizontal = fixed
					enabled = yes
					down = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'nobles')]"
                    onclick = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
                    onclick = "[GetVariableSystem.Set('WJ_baiguan_page', 'nobles')]"
					blockoverride "tab_label" { text = WJ_baiguan_tab_nobles }
					tooltip = WJ_royal_pages_help
				}

				button_tab = {
					name = "WJ_baiguan_court_tab"
     onclick = "[GetVariableSystem.Clear('WJ_baiguan_page')]"
					position = { 606 0 }
					size = { 196 42 }
					layoutpolicy_horizontal = fixed
					enabled = yes
					down = "[Not(GetVariableSystem.Exists('WJ_baiguan_page'))]"
					blockoverride "tab_label" { text = WJ_baiguan_tab_court }
				}

				button_tab = {
					name = "WJ_baiguan_east_palace_tab"
					position = { 808 0 }
					size = { 196 42 }
					layoutpolicy_horizontal = fixed
					enabled = yes
					down = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'east_palace')]"
                    onclick = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
                    onclick = "[GetVariableSystem.Set('WJ_baiguan_page', 'east_palace')]"
					blockoverride "tab_label" { text = WJ_baiguan_tab_east_palace }
					tooltip = WJ_royal_pages_help
				}

				button_tab = {
					name = "WJ_baiguan_clan_tab"
					position = { 1010 0 }
					size = { 196 42 }
					layoutpolicy_horizontal = fixed
					enabled = yes
					down = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'clan')]"
                    onclick = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
                    onclick = "[GetVariableSystem.Set('WJ_baiguan_page', 'clan')]"
					blockoverride "tab_label" { text = WJ_baiguan_tab_clan }
					tooltip = WJ_royal_pages_help
				}

				button_tab = {
					name = "WJ_baiguan_harem_tab"
					position = { 1212 0 }
					size = { 196 42 }
					layoutpolicy_horizontal = fixed
					enabled = yes
					down = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'harem')]"
                    onclick = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
                    onclick = "[GetVariableSystem.Set('WJ_baiguan_page', 'harem')]"
					blockoverride "tab_label" { text = WJ_baiguan_tab_harem }
					tooltip = WJ_royal_pages_help
				}
    # Waiqi is suspended; the remaining seven tabs fill this row.
			}

   WJ_royal_pages_body = { position = { 24 326 } }
   widget = {
    name = "WJ_inner_court_body"
    position = { 24 326 } size = { 1408 606 }
    visible = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'inner')]"
    WJ_inner_person_card = {
     name = "WJ_inner_dasima" position = { 8 8 } size = { 440 268 }
     datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char]"
     blockoverride "inner_title" { text = WJ_inner_dasima }
