       tooltip = WJ_inner_select_dasima
       button_change = { parentanchor = center alwaystransparent = yes }
      }
     }
blockoverride "inner_footer" {}
    }
    WJ_inner_person_card = {
     name = "WJ_inner_diarch" position = { 480 8 } size = { 440 268 }
     datacontext = "[CouncilWindow.GetCharacter.GetDiarchy.GetDiarch]"
     blockoverride "inner_title" { text = WJ_inner_diarch }
     blockoverride "inner_person_visible" { visible = "[And(CouncilWindow.GetCharacter.HasActiveDiarchy, And(Character.IsValid, Character.IsAlive))]" }
     blockoverride "inner_vacant_visible" { visible = "[Not(And(CouncilWindow.GetCharacter.HasActiveDiarchy, And(Character.IsValid, Character.IsAlive)))]" }
blockoverride "inner_footer" {}
    }
    WJ_inner_person_card = {
     name = "WJ_inner_general" position = { 952 8 } size = { 440 268 }
     datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]"
 datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
 datacontext = "[ActiveCouncilTask.GetPositionType]"
 datacontext = "[ActiveCouncilTask.GetCouncillor]"
     blockoverride "inner_title" { text = WJ_inner_general }
     blockoverride "inner_scene" { texture = "gfx/interface/illustrations/event_scenes/tgp_courtyard_asia.dds" }
     blockoverride "inner_animation" { portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', CouncilPositionType.GetPortraitAnimation, PdxGetWidgetScreenSize(PdxGuiWidget.Self))]" }
     blockoverride "inner_appointment" { button_round = {
position = { 396 230 } size = { 32 32 }
 visible = "[GuiCouncilPosition.CanPotentiallySelectCouncillor]"
 enabled = "[GuiCouncilPosition.CanSelectCouncillor]"
 onclick = "[GuiCouncilPosition.SelectCouncillor]"
 tooltip = "[GuiCouncilPosition.GetSelectCouncillorTooltip]"
 button_change = { parentanchor = center alwaystransparent = yes }
} }
    }
    widget = {
     name = "WJ_inner_shizhong" position = { 8 318 } size = { 440 268 }
     # Enumerate the displayed owner's actual court positions, never the player's court.
     hbox = {
      size = { 440 268 }
      ignoreinvisible = yes
      datamodel = "[CouncilWindow.GetCharacter.GetEmployedCourtPositions]"
      item = {
       WJ_inner_person_card = {
        visible = "[ObjectsEqual(CourtPosition.GetPositionType, GetCourtPositionType('favored_minister_court_position'))]"
        datacontext = "[CourtPosition.GetEmployee]"
        blockoverride "inner_title" { text = "[CourtPosition.GetNameNoTooltip]" }
        blockoverride "inner_appointment" {
         button_round = {
position = { 396 230 } size = { 32 32 }
          visible = "[ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter)]"
          onclick = "[GetScriptedGui('WJ_inner_shizhong_open_native').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).AddScope('actor', GetPlayer.MakeScope).End)]"
          tooltip = "COURT_POSITION_REPLACE"
          button_change = { parentanchor = center alwaystransparent = yes }
         }
        }
       }
      }
