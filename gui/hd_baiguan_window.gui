types hd_baiguan_types
{
	type hd_baiguan_office_slot = widget {
		size = { 76 116 }
		allow_outside = yes

		widget = {
			name = "fixed_empty_frame"
			parentanchor = top|hcenter
			size = { 68 72 }
			background = {
				using = Background_Area_Dark
				alpha = 0.82
			}
		}

		block "slot_portrait" {}

		block "slot_label" {
			text_single = {
				parentanchor = top|hcenter
				position = { 0 74 }
				size = { 76 20 }
				text = ""
				default_format = "#high"
				align = center|nobaseline
				autoresize = no
				max_width = 76
			}
		}

		block "slot_mufu" {}
	}
}

window = {
	name = "hd_baiguan_window"
	size = { 1747 984 }
	parentanchor = center
	layer = middle
	allow_outside = yes
	alwaystransparent = no
	datacontext = "[AccessCouncilWindow]"
	visible = "[And( GetVariableSystem.HasValue( 'hd_baiguan_visibility', 'true' ), And( IsGameViewOpen( 'council_window' ), CouncilWindow.GetCharacter.IsValid ) )]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		on_finish = "[GetScriptedGui('hd_baiguan_rebuild_effect').Execute( GuiScope.SetRoot( CouncilWindow.GetCharacter.MakeScope ).End )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		on_finish = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
	}

	icon = {
		name = "hd_baiguan_unchanged_background_art"
		position = { 0 11 }
		size = { 1747 962 }
		texture = "gfx/interface/hd_baiguan/ui1.png"
		alwaystransparent = yes
	}

	button_close = {
		name = "hd_baiguan_close_button"
		parentanchor = top|left
		position = { 1608 271 }
		size = { 32 32 }
		focuspolicy = click
		shortcut = close_window
		tooltip = CLOSE_TOOLTIP
		onclick = "[GetVariableSystem.Clear( 'hd_baiguan_visibility' )]"
	}

	portrait_torso = {
		name = "hd_baiguan_emperor_portrait"
		datacontext = "[CouncilWindow.GetCharacter]"
		parentanchor = top|left
		position = { 792 96 }
		size = { 165 200 }
		blockoverride "coa" {}
		blockoverride "opinion_box" {}
		blockoverride "portrait_status_icons" {}
	}

	# Imperial household
	hd_baiguan_office_slot = {
