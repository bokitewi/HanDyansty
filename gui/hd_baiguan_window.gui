     blockoverride "inner_animation" { portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', 'marshal', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]" }
     blockoverride "inner_appointment" {
      button_round = {
position = { 396 230 } size = { 32 32 }
       visible = "[ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter)]"
