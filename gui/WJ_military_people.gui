  blockoverride "native_court_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetMartialSkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_missing_detail" { WJ_mt_detail_text = { text = WJ_mt_martial_direct_detail } }
 }
 type WJ_mt_stewardship_detail_tooltip = WJ_mt_native_detail_tooltip {
  blockoverride "native_self_detail" { WJ_mt_detail_text = { text = WJ_mt_stewardship_direct_detail } }
  blockoverride "native_powerful_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetStewardshipSkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_regular_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetStewardshipSkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_court_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetStewardshipSkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_missing_detail" { WJ_mt_detail_text = { text = WJ_mt_stewardship_direct_detail } }
 }
 type WJ_mt_intrigue_detail_tooltip = WJ_mt_native_detail_tooltip {
  blockoverride "native_self_detail" { WJ_mt_detail_text = { text = WJ_mt_intrigue_direct_detail } }
  blockoverride "native_powerful_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetIntrigueSkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_regular_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetIntrigueSkill]" text = "SKILL_ITEM_TOOLTIP" } }
