types WJMilitaryPeopleTypes {
 type WJ_mt_gold_portrait = portrait_head_small {
  allow_outside = yes
  # Keep the complete native portrait/status/CoA chain. Reserve the corner for the interaction.
  blockoverride "opinion_box" {
   widget = { size = { 45 18 } allow_outside = yes scissor = no
    portrait_opinion_small = { parentanchor = left|vcenter widgetanchor = left|vcenter position = { -3 -8 } }
   }
  }
 }
 type WJ_mt_small_person = widget {
  size = { 85 90 } allow_outside = yes scissor = no
  WJ_mt_gold_portrait = {}
  # A circle centred on this corner has one quarter inside the portrait.
  WJ_mt_menu_button = { block "small_person_menu_layout" { position = { 85 90 } size = { 24 24 } } widgetanchor = center }
 }
 type WJ_mt_bright_button = button_standard {
  # Native button state atlas: the disabled frame has no hover glow.
  highlight_icon = {
   size = { 100% 100% } alwaystransparent = yes
   texture = "gfx/interface/buttons/button_mouseover.dds" framesize = { 238 63 }
   spriteType = Corneredstretched spriteborder = { 20 20 }
   gfxtype = togglepushbuttongfx effectname = "NoHighlight"
   upframe = 1 uphoverframe = 2 uppressedframe = 2
   downframe = 1 downhoverframe = 2 downpressedframe = 2 disableframe = 1
   color = { 1 0.78 0.3 1 } alpha = 1
  }
 }
 type WJ_mt_people_frame = widget {
  size = { 907.5 646 } alwaystransparent = yes
  # The approved preview uses one continuous image, without nine-slice paper seams.
  icon = { size = { 907.5 646 } texture = "gfx/interface/hd_baiguan/wj_military_people_frame_v1.png" alwaystransparent = yes }
 }

 type WJ_mt_halfbody = widget {
  size = { 176.8 216 }
  portrait_button = {
   block "halfbody_portrait_layout" { position = { 0 0 } size = { 176.8 204 } }
   using = portrait_base
   portrait_texture = "[Character.GetAnimatedPortrait('environment_torso', 'camera_torso', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
   mask = "gfx/portraits/portrait_mask_torso.dds" effectname = "NoHighlight"
  }

  portrait_status_icons_small = {
   name = "WJ_mt_status_icons"
   block "halfbody_status_layout" { position = { 0 98 } scale = 1.25 }
  }
  portrait_opinion = {
   name = "WJ_mt_halfbody_opinion"
   parentanchor = bottom|hcenter widgetanchor = bottom|hcenter
   block "halfbody_opinion_layout" { position = { 0 -2 } }
  }
  coa_realm_small_crown = {
   visible = "[Character.HasLandedTitles]"
   parentanchor = bottom|right widgetanchor = bottom|right
   block "halfbody_coa_layout" { position = { -3 -12 } scale = 0.9 }
  }
 }
 type WJ_mt_name_age = hbox {
  parentanchor = top|left widgetanchor = top|left position = { 0 0 }
  block "name_age_layout" { size = { 232 44 } }
  layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed spacing = 6
  text_single = {
   block "name_age_text_layout" { size = { 152 44 } maximumsize = { 152 44 } max_width = 152 fontsize = 19 }
   block "name_age_text" { text = WJ_mt_primary_name }
   tooltip = "[Character.Custom('WJ_GetUIName')]"
   multiline = yes fontsize_min = 16 autoresize = no default_format = "#hd_black" align = left|vcenter
   layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
  }
  widget = { size = { 38.4 17 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed widget = { size = { 64 28 } scale = 0.6 parentanchor = center widgetanchor = center character_age_health = {} } }
  expand = {}
 }

 # Reuse the realm's actual CharacterListItem, matched to this card's Character.
 # ponytail: this hover lookup scans the native vassal/court pools; a direct per-character
 # factory would remove the lookup and cover characters outside these native pools.
 type WJ_mt_detail_text = text_multi {
  using = DefaultTooltipText
  size = { 356 0 } minimumsize = { 356 1 } max_width = 356
  layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing
 }
 type WJ_mt_native_detail_tooltip = widget {
  size = { 380 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing
  using = DefaultTooltipBackground using = GeneralTooltipSetup
  vbox = {
   set_parent_size_to_minimum = yes margin = { 12 10 } size = { 356 0 }
   layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing ignoreinvisible = yes
  widget = {
   visible = "[ObjectsEqual(Character.Self, GetPlayer)]"
   size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing
   block "native_self_detail" {
    WJ_mt_detail_text = { datacontext = "[GetPlayerArmyComposition]" text = "[ArmyComposition.GetArmyCompositionTooltip]" }
   }
  }
  vbox = {
   datacontext = "[AccessMyRealmWindow.GetPowerfulVassals]"
   datamodel = "[CharacterSelectionList.GetList]"
   size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing ignoreinvisible = yes
   item = { vbox = {
    visible = "[And(Not(ObjectsEqual(Character.Self, GetPlayer)), ObjectsEqual(CharacterListItem.GetCharacter, Character.Self))]"
    size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing ignoreinvisible = yes
    block "native_powerful_detail" { WJ_mt_detail_text = { text = "[CharacterListItem.GetMilitaryStrengthTooltip]" } }
   } }
  }
  vbox = {
   datacontext = "[AccessMyRealmWindow.GetRegularVassals]"
   visible = "[StringIsEmpty(DataModelJoinList(AccessMyRealmWindow.GetPowerfulVassals.GetList, 'WJ_mt_native_detail_match', 'WJ_mt_native_detail_separator'))]"
   datamodel = "[CharacterSelectionList.GetList]"
   size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing ignoreinvisible = yes
   item = { vbox = {
    visible = "[And(Not(ObjectsEqual(Character.Self, GetPlayer)), ObjectsEqual(CharacterListItem.GetCharacter, Character.Self))]"
    size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing ignoreinvisible = yes
    block "native_regular_detail" { WJ_mt_detail_text = { text = "[CharacterListItem.GetMilitaryStrengthTooltip]" } }
   } }
  }
  vbox = {
   datacontext = "[AccessCourtWindow.GetCourt]"
   visible = "[And(StringIsEmpty(DataModelJoinList(AccessMyRealmWindow.GetPowerfulVassals.GetList, 'WJ_mt_native_detail_match', 'WJ_mt_native_detail_separator')), StringIsEmpty(DataModelJoinList(AccessMyRealmWindow.GetRegularVassals.GetList, 'WJ_mt_native_detail_match', 'WJ_mt_native_detail_separator')))]"
   datamodel = "[CharacterSelectionList.GetList]"
   size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing ignoreinvisible = yes
   item = { vbox = {
    visible = "[And(Not(ObjectsEqual(Character.Self, GetPlayer)), ObjectsEqual(CharacterListItem.GetCharacter, Character.Self))]"
    size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing ignoreinvisible = yes
    block "native_court_detail" { WJ_mt_detail_text = { text = "[CharacterListItem.GetMilitaryStrengthTooltip]" } }
   } }
  }
  vbox = {
   visible = "[And(Not(ObjectsEqual(Character.Self, GetPlayer)), And(And(StringIsEmpty(DataModelJoinList(AccessMyRealmWindow.GetPowerfulVassals.GetList, 'WJ_mt_native_detail_match', 'WJ_mt_native_detail_separator')), StringIsEmpty(DataModelJoinList(AccessMyRealmWindow.GetRegularVassals.GetList, 'WJ_mt_native_detail_match', 'WJ_mt_native_detail_separator'))), StringIsEmpty(DataModelJoinList(AccessCourtWindow.GetCourt.GetList, 'WJ_mt_native_detail_match', 'WJ_mt_native_detail_separator'))))]"
   size = { 356 0 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = growing
   block "native_missing_detail" { WJ_mt_detail_text = { text = WJ_mt_military_detail_unavailable } }
  }
  }
 }
 type WJ_mt_diplomacy_detail_tooltip = WJ_mt_native_detail_tooltip {
  blockoverride "native_self_detail" { WJ_mt_detail_text = { text = WJ_mt_diplomacy_direct_detail } }
  blockoverride "native_powerful_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetDiplomacySkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_regular_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetDiplomacySkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_court_detail" { WJ_mt_detail_text = { datacontext = "[CharacterListItem.GetDiplomacySkill]" text = "SKILL_ITEM_TOOLTIP" } }
  blockoverride "native_missing_detail" { WJ_mt_detail_text = { text = WJ_mt_diplomacy_direct_detail } }
 }
