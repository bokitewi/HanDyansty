# 列表为人物scope；只有草稿列表为story scope。所有执行入口root=GetPlayer。
window = {
 name = "WJ_kaoke_table_window"
 parentanchor = top|right
 position = { -50 65 }
 layer = middle
 allow_outside = yes
 using = Window_Size_CharacterList
 using = Window_Background
 using = Window_Decoration_Spike
 using = Window_Movable
 filter_mouse = all
 alwaystransparent = no
 visible = "[GetScriptedGui('WJ_kaoke_table_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 state = { name = _show on_start = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]" }
 widget = {
  name = "WJ_kaoke_panel"
  size = { 100% 100% }
  vbox = {
   using = Window_Margins
   spacing = 3
   header_pattern = {
    layoutpolicy_horizontal = expanding
    blockoverride "header_text" { text = WJ_kaoke_table_title }
    blockoverride "button_close" {
     name = "WJ_kaoke_close"
     onclick = "[GetScriptedGui('WJ_kaoke_table_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
   }
   hbox = {
    layoutpolicy_horizontal = expanding spacing = 8
    button = {
     name = "WJ_kaoke_tier_filter" size = { 190 34 }
     onclick = "[GetVariableSystem.Set('wj_kaoke_filter_menu', 'tier')]"
     button_drop = { alwaystransparent = yes size = { 100% 100% } text = WJ_kaoke_filter_tier_label }
    }
    button = {
     name = "WJ_kaoke_grade_filter" size = { 190 34 }
     onclick = "[GetVariableSystem.Set('wj_kaoke_filter_menu', 'grade')]"
     button_drop = { alwaystransparent = yes size = { 100% 100% } text = WJ_kaoke_filter_grade_label }
    }
    button_standard = {
     name = "WJ_kaoke_reset_filter" size = { 110 34 } text = WJ_kaoke_filter_all
     onclick = "[GetScriptedGui('WJ_kaoke_filter_reset').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    button_standard = {
     name = "WJ_kaoke_refresh" size = { 135 34 } text = WJ_kaoke_refresh
     onclick = "[GetScriptedGui('WJ_kaoke_table_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     tooltip = WJ_kaoke_table_help
    }
   }
   button_standard = {
    name = "WJ_kaoke_relations_filter" size = { 260 28 }
    text = WJ_kaoke_relations_filter_label
    tooltip = WJ_kaoke_relations_filter_tt
    onclick = "[GetScriptedGui('WJ_kaoke_filter_relations').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
   scrollbox = {
    name = "WJ_kaoke_body"
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    blockoverride "scrollbox_content" {
     fixedgridbox = {
      name = "WJ_kaoke_rows"
      addcolumn = 630
      addrow = 128
      datamodel_reuse_widgets = yes
      datamodel = "[GetPlayer.MakeScope.GetList('wj_kaoke_page_roster')]"
      item = {
       widget = {
        name = "WJ_kaoke_row" datacontext = "[Scope.Char]"
        size = { 630 128 }
        # 名单已先筛选，最多20行；此门禁只防开窗后人物身份变化，不再承担全朝过滤。
        visible = "[GetScriptedGui('WJ_kaoke_row_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
        hbox = {
         vbox = {
          layoutpolicy_vertical = expanding margin_top = 4
          portrait_head_small = { name = "WJ_kaoke_portrait" }
          expand = {}
         }
         vbox = {
          layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding margin_top = 5
          hbox = {
           layoutpolicy_horizontal = expanding margin = { 0 3 } margin_left = 5 margin_right = 10
           background = { using = Background_Area_Characterlist }
           background = {
            using = Background_Area_Dark
            modify_texture = { texture = "gfx/interface/component_masks/mask_fade_vertical.dds" blend_mode = alphamultiply alpha = 1 rotate_uv = 90 mirror = vertical }
           }
           text_single = {
            name = "WJ_kaoke_name" layoutpolicy_horizontal = expanding
            text = "[Character.Custom('WJ_GetUIName')]" using = Font_Size_Medium
            autoresize = no fontsize_min = 14 align = nobaseline
           }
           hbox = { name = "WJ_kaoke_age" using = character_age_or_death_text }
          }
          hbox = {
           layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
           vbox = {
            layoutpolicy_horizontal = expanding spacing = 2
            hbox = {
             name = "WJ_kaoke_identity" layoutpolicy_horizontal = expanding spacing = 5
             widget = {
              size = { 38 32 }
              coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.6 }
             }
             icon = {
              size = { 28 28 } datacontext = "[Character.GetFaith]" texture = "[Faith.GetIcon]"
              tooltipwidget = { faith_tooltip = {} } using = tooltip_se
             }
             hbox = {
              datacontext = "[Character.GetCulture]" spacing = 3
              tooltipwidget = { culture_tooltip = {} } using = tooltip_se
              icon = { size = { 24 24 } texture = "gfx/interface/icons/icon_culture.dds" }
              text_single = { size = { 64 28 } text = "[Culture.GetNameNoTooltip]" autoresize = no fontsize_min = 14 align = nobaseline }
             }
             WJ_luzhi_glyph = { size = { 28 28 } tooltip = "[Character.Custom('WJ_BandWordPlain')]" }
             expand = {}
             text_single = { text = WJ_kaoke_efficiency_short using = Font_Size_Small align = nobaseline }
             text_single = {
              name = "WJ_kaoke_efficiency" size = { 65 28 } align = nobaseline
              visible = "[GetScriptedGui('WJ_kaoke_efficiency_applicable').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
              text = ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_VALUE tooltip = ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_TT
             }
             text_single = {
              name = "WJ_kaoke_efficiency_na" size = { 65 28 } text = WJ_kaoke_not_applicable
              visible = "[Not(GetScriptedGui('WJ_kaoke_efficiency_applicable').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End))]"
             }
            }
            hbox = {
             name = "WJ_kaoke_metrics" layoutpolicy_horizontal = expanding spacing = 5 margin_left = 5
             text_single = { name = "WJ_kaoke_due" size = { 145 26 } text = WJ_kaoke_due_compact using = Font_Size_Small align = nobaseline }
             text_single = { text = WJ_kaoke_score_short using = Font_Size_Small align = nobaseline }
             text_single = { name = "WJ_kaoke_score" size = { 38 26 } text = "[Character.MakeScope.ScriptValue('WJ_kaoke_score_value')|0]" align = nobaseline tooltip = WJ_ai_kaoke_sources_tt }
             hbox = {
              name = "WJ_kaoke_draft_preview"
              datamodel = "[GetPlayer.MakeScope.GetList('wj_kaoke_drafts')]"
              item = {
               text_single = {
                name = "WJ_kaoke_draft_delta" size = { 46 26 } align = nobaseline
                visible = "[ObjectsEqual(Scope.Var('wj_kaoke_target').Char.Self, Character.Self)]"
                text = "[Scope.Var('wj_kaoke_delta').GetValue|+=0]"
               }
              }
             }
            }
            hbox = {
             name = "WJ_kaoke_period_grades" layoutpolicy_horizontal = expanding spacing = 5 margin_left = 5
             expand = {}
             text_single = { text = WJ_kaoke_period_previous_label using = Font_Size_Small align = nobaseline }
             text_single = { name = "WJ_kaoke_previous_grade" size = { 28 26 } text = WJ_kaoke_period_previous_value align = nobaseline }
             spacer = { size = { 35 26 } }
             text_single = { text = WJ_kaoke_period_current_label using = Font_Size_Small align = nobaseline }
             text_single = { name = "WJ_kaoke_grade" size = { 28 26 } text = "[Character.Custom('WJKaokeCurrentGrade')]" align = nobaseline }
             widget = {
              name = "WJ_kaoke_grade_forecast"
              # 永久保留右侧宽度；Scope是草稿story，Character仍是外层名单人物。
              size = { 40 26 }
              hbox = {
               datamodel = "[GetPlayer.MakeScope.GetList('wj_kaoke_drafts')]"
               item = {
                text_single = {
                 size = { 30 26 } align = nobaseline
                 visible = "[And(ObjectsEqual(Scope.Var('wj_kaoke_target').Char.Self, Character.Self), Or(GreaterThan_CFixedPoint(Scope.ScriptValue('WJ_kaoke_preview_grade_change_value'), '(CFixedPoint)0'), LessThan_CFixedPoint(Scope.ScriptValue('WJ_kaoke_preview_grade_change_value'), '(CFixedPoint)0')))]"
                 text = WJ_kaoke_grade_forecast_text
                }
               }
              }
             }
            }
           }
           vbox = {
            margin_left = 8 margin_right = 4 spacing = 2
            button_standard = {
             name = "WJ_kaoke_plus" size = { 30 26 } text = ""
             icon = {
              parentanchor = center size = { 22 22 } alwaystransparent = yes
              texture = "gfx/interface/icons/symbols/icon_arrow_green_down.dds"
              mirror = vertical
             }
             visible = "[GetScriptedGui('WJ_kaoke_can_operate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
             enabled = "[GetScriptedGui('WJ_kaoke_preview_plus').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
             onclick = "[GetScriptedGui('WJ_kaoke_preview_plus').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
             tooltip = WJ_kaoke_step_tt
            }
            button_standard = {
             name = "WJ_kaoke_minus" size = { 30 26 } text = ""
             icon = {
              parentanchor = center size = { 22 22 } alwaystransparent = yes
              texture = "gfx/interface/icons/symbols/icon_arrow_up.dds"
              mirror = vertical
             }
             visible = "[GetScriptedGui('WJ_kaoke_can_operate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
             enabled = "[GetScriptedGui('WJ_kaoke_preview_minus').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
             onclick = "[GetScriptedGui('WJ_kaoke_preview_minus').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
             tooltip = WJ_kaoke_step_tt
            }
           }
          }
         }
        }
       }
      }
     }
    }
    blockoverride "scrollbox_empty" { visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_kaoke_page_roster'))]" text = WJ_kaoke_empty }
   }
   vbox = {
    name = "WJ_kaoke_footer" layoutpolicy_horizontal = expanding spacing = 4
    hbox = {
     layoutpolicy_horizontal = expanding spacing = 8
     button_standard = {
      name = "WJ_kaoke_previous" size = { 90 28 } text = WJ_kaoke_previous
      enabled = "[GetScriptedGui('WJ_kaoke_page_previous').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetScriptedGui('WJ_kaoke_page_previous').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     }
     text_single = { layoutpolicy_horizontal = expanding text = WJ_kaoke_page_status using = Font_Size_Small align = center|nobaseline }
     button_standard = {
      name = "WJ_kaoke_next" size = { 90 28 } text = WJ_kaoke_next
      enabled = "[GetScriptedGui('WJ_kaoke_page_next').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetScriptedGui('WJ_kaoke_page_next').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     }
    }
    vbox = {
     layoutpolicy_horizontal = expanding spacing = 3
     visible = "[GetScriptedGui('WJ_kaoke_can_operate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     hbox = {
      layoutpolicy_horizontal = expanding spacing = 8
      text_single = { layoutpolicy_horizontal = expanding text = WJ_kaoke_batch_status using = Font_Size_Small }
      button_standard = {
       name = "WJ_kaoke_reset_preview" size = { 125 30 } text = WJ_kaoke_reset_preview tooltip = WJ_kaoke_reset_preview_tt
       visible = "[GetScriptedGui('WJ_kaoke_can_operate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
       onclick = "[GetScriptedGui('WJ_kaoke_preview_reset').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
      button_standard = {
       name = "WJ_kaoke_confirm_button" size = { 85 30 } text = WJ_kaoke_confirm
       visible = "[GetScriptedGui('WJ_kaoke_can_operate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
       enabled = "[GetScriptedGui('WJ_kaoke_confirm_open').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
       onclick = "[GetScriptedGui('WJ_kaoke_confirm_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
     }
     progressbar = {
      name = "WJ_kaoke_risk_bar"
      min = 0
      max = 100
      layoutpolicy_horizontal = expanding size = { 0 12 }
      visible = "[GetScriptedGui('WJ_kaoke_risk_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      tooltip = WJ_kaoke_risk_help
      value = "[GetPlayer.MakeScope.ScriptValue('WJ_kaoke_batch_progress_value')]"
      progresstexture = "gfx/interface/progressbars/war_progress_blue.dds"
      noprogresstexture = "gfx/interface/progressbars/war_progress_noprogress.dds"
      direction = horizontal
     }
     text_single = { name = "WJ_kaoke_risk_text" layoutpolicy_horizontal = expanding text = WJ_kaoke_risk_status using = Font_Size_Small visible = "[GetScriptedGui('WJ_kaoke_risk_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = WJ_kaoke_risk_help }
     text_multi = { layoutpolicy_horizontal = expanding autoresize = yes text = "[GetPlayer.Custom('WJKaokeCooldown')]" using = Font_Size_Small }
    }
   }
  }
 }
  # 原版过滤器控件与菜单背景；数据只绑定本mod五等/爵级，勿套任命窗口候选人作用域。
  button = {
   size = { 100% 100% }
   visible = "[GetVariableSystem.Exists('wj_kaoke_filter_menu')]"
   onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
  }
  widget = {
   name = "WJ_kaoke_tier_menu" position = { 40 108 } size = { 190 144 }
   visible = "[GetVariableSystem.HasValue('wj_kaoke_filter_menu', 'tier')]"
   using = Background_DropDown filter_mouse = all
   vbox = {
    margin = { 4 4 } spacing = 0
    button = {
     name = "WJ_kaoke_tier_option_0" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_tier_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_all
     }
    }
    button = {
     name = "WJ_kaoke_tier_option_2" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_tier_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_county
     }
    }
    button = {
     name = "WJ_kaoke_tier_option_3" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_tier_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_duchy
     }
    }
    button = {
     name = "WJ_kaoke_tier_option_4" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_tier_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_kingdom
     }
    }
   }
  }
  widget = {
   name = "WJ_kaoke_grade_menu" position = { 238 108 } size = { 190 212 }
   visible = "[GetVariableSystem.HasValue('wj_kaoke_filter_menu', 'grade')]"
   using = Background_DropDown filter_mouse = all
   vbox = {
    margin = { 4 4 } spacing = 0
    button = {
     name = "WJ_kaoke_grade_option_0" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_grade_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_all
     }
    }
    button = {
     name = "WJ_kaoke_grade_option_1" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_grade_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_lie
     }
    }
    button = {
     name = "WJ_kaoke_grade_option_2" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_grade_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_cha
     }
    }
    button = {
     name = "WJ_kaoke_grade_option_3" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_grade_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_ping
     }
    }
    button = {
     name = "WJ_kaoke_grade_option_4" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_grade_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_liang
     }
    }
    button = {
     name = "WJ_kaoke_grade_option_5" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_kaoke_filter_grade_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_kaoke_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_you
     }
    }
   }
  }
}

# Independent movable confirmation: no full-table dimming or input backdrop.
window = {
  name = "WJ_kaoke_confirmation"
  parentanchor = center
  size = { 760 580 }
  layer = top
  allow_outside = yes
  using = Window_Movable
  using = Window_Background
  using = Window_Decoration
  filter_mouse = all
  alwaystransparent = no
  visible = "[GetScriptedGui('WJ_kaoke_confirm_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  widget = {
   size = { 100% 100% }
   text_single = { position = { 24 16 } size = { 712 32 } autoresize = no text = WJ_kaoke_confirm_title align = center }
   text_single = {
    name = "WJ_kaoke_stale_warning" position = { 24 68 } size = { 712 40 }
    visible = "[Not(GetScriptedGui('WJ_kaoke_confirm_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
    text = WJ_kaoke_batch_invalid
   }
   widget = {
    position = { 24 64 } size = { 712 430 }
    visible = "[GetScriptedGui('WJ_kaoke_confirm_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    text_multi = {
     name = "WJ_kaoke_summary_cell" position = { 0 0 } size = { 712 60 }
     autoresize = no align = center fontsize = 18 text = WJ_kaoke_confirm_summary
    }
    text_single = {
     name = "WJ_kaoke_confirm_risk" position = { 0 60 } size = { 712 28 }
     autoresize = no align = center text = WJ_kaoke_risk_status
     visible = "[GetScriptedGui('WJ_kaoke_risk_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    scrollbox = {
     name = "WJ_kaoke_confirmation_body" position = { 0 100 } size = { 712 326 }
     blockoverride "scrollbox_content" {
      fixedgridbox = {
       addcolumn = 688 addrow = 110 maxhorizontalslots = 1
       datamodel_reuse_widgets = yes
       datamodel = "[GetPlayer.MakeScope.GetList('wj_kaoke_confirmation_drafts')]"
       item = {
        widget = {
         name = "WJ_kaoke_confirmation_card" size = { 688 110 }
         datacontext = "[Scope.Var('wj_kaoke_target').Char]"
         background = { using = Background_Area_Dark }
         portrait_head_small = { position = { 6 8 } }
         text_single = { position = { 104 6 } size = { 574 30 } autoresize = no text = "[Character.Custom('WJ_GetUIName')]" using = Font_Size_Medium }
         widget = {
          position = { 104 44 } size = { 38 36 }
          coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.6 }
         }
         text_multi = { position = { 150 40 } size = { 400 64 } autoresize = no text = WJ_kaoke_confirm_result fontsize = 16 align = left|vcenter }
         text_single = { position = { 560 44 } size = { 118 40 } autoresize = no text = WJ_kaoke_confirm_delta align = center using = Font_Size_Medium }
        }
       }
      }
     }
    }
   }
   button_standard = {
 name = "WJ_kaoke_cancel_button" position = { 24 520 } size = { 190 36 }
 text = WJ_kaoke_confirm_cancel
 
 
 onclick = "[GetScriptedGui('WJ_kaoke_confirm_cancel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = WJ_kaoke_table_help
}

   button_standard = {
 name = "WJ_kaoke_commit_button" position = { 522 520 } size = { 214 36 }
 text = WJ_kaoke_commit
 visible = "[GetScriptedGui('WJ_kaoke_can_operate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 enabled = "[GetScriptedGui('WJ_kaoke_confirm_commit').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('WJ_kaoke_confirm_commit').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = WJ_kaoke_table_help
}

  }
 }
