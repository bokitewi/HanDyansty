types PeaceDealsExpanded150 {
 type hd_peace_amount_button = button_tertiary_push {
  size = { 47 28 }
  buttonText = {
   text_single = { using = Font_Size_Tiny 
    
    size = { 100% 100% }
    autoresize = no
    margin = { 2 0 }
    align = center|nobaseline
    default_format = "#clickable"
    alwaystransparent = yes
   }
  }
 }
 type hd_peace_filter_tab = hd_peace_amount_button {
  size = { 135 34 }
 }
 type hd_peace_peace_tab = button_tab {
  size = { 0 42 }
  buttonText = {
   text_single = { using = Font_Size_Small 
    
    size = { 100% 100% }
    autoresize = no
    margin_left = 34
    margin_right = 8
    align = center|nobaseline
    default_format = "#clickable"
    alwaystransparent = yes
   }
  }
 }
 # Independence picker: eligible lords (count tier or higher) and selection.
 type hd_peace_release_vassal_picker = widget {
	size = { 940 500 }
	background = { using = Background_Area_Dark }

	widget = {
		position = { 8 6 }
		size = { 924 52 }
		background = {
			texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
			spriteType = Corneredtiled
			spriteborder = { 18 18 }
			alpha = 0.85
		}
		icon = { texture = "gfx/interface/icons/casus_bellis/independence_faction_war.dds" position = { 14 11 } size = { 30 30 } alwaystransparent = yes }
		text_single = { using = Font_Size_Big text = "hd_peace_release_demand_title" visible = "[GetVariableSystem.Exists('hd_peace_treaty_demand_tab')]" position = { 56 3 } size = { 700 28 } align = left|vcenter default_format = "#negative_value" autoresize = no }
		text_single = { using = Font_Size_Big text = "hd_peace_release_offer_title" visible = "[GetVariableSystem.Exists('hd_peace_treaty_offer_tab')]" position = { 56 3 } size = { 700 28 } align = left|vcenter default_format = "#positive_value" autoresize = no }
		text_single = { using = Font_Size_Tiny text = "hd_peace_release_picker_desc" position = { 56 29 } size = { 760 20 } align = left|vcenter default_format = "#low" autoresize = no }
		button_expand = { parentanchor = right|vcenter position = { -50 0 } onclick = "[GetVariableSystem.Set('hd_peace_overview_collapsed', 'true')]" tooltip = "hd_peace_collapse_war_panel_tt" }
		button_close = { parentanchor = right|vcenter position = { -10 0 } onclick = "[GetVariableSystem.Clear('hd_peace_release_select')]" tooltip = "hd_peace_finish_release_selection" }
	}

	widget = {
		position = { 8 456 }
		size = { 924 40 }
		background = {
			texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
			spriteType = Corneredtiled
			spriteborder = { 18 18 }
			alpha = 0.85
		}
	}

	text_multi = {
		visible = "[And(GetVariableSystem.Exists('hd_peace_treaty_demand_tab'), LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_release_candidate_count_value'), '(CFixedPoint)1'))]"
		using = Font_Size_Small
		text = "hd_peace_no_release_candidates"
		position = { 40 150 }
		size = { 540 120 }
		align = hcenter|top
		default_format = "#low"
		autoresize = no
	}
	scrollbox = {
		visible = "[GetVariableSystem.Exists('hd_peace_treaty_demand_tab')]"
		position = { 8 64 }
		size = { 604 386 }
		blockoverride "scrollbox_margins" {
			margin_top = 2
			margin_bottom = 8
			margin_left = 6
			margin_right = 18
		}
		blockoverride "scrollbox_content" {
			vbox = {
				datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_demand_release_candidates')]"
				layoutpolicy_horizontal = expanding
				spacing = 3
				item = {
					button_standard_list = {
						datacontext = "[Scope.Char]"
						size = { 578 54 }
						down = "[GetScriptedGui('hd_peace_demand_release_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]"
						enabled = "[GetScriptedGui('hd_peace_demand_release_toggle_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]"
						onclick = "[GetScriptedGui('hd_peace_demand_release_toggle_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]"
						tooltip = "hd_peace_release_row_tt"
						using = tooltip_ws
						coa_title_tiny_crown = { datacontext = "[Character.GetPrimaryTitle]" position = { 8 4 } }
						text_single = { using = Font_Size_Small text = "[Character.GetTitledFirstName]" position = { 56 6 } size = { 370 22 } align = left|vcenter default_format = "#high" alwaystransparent = yes autoresize = no }
						text_single = { using = Font_Size_Tiny text = "hd_peace_release_row_detail" position = { 56 29 } size = { 370 19 } align = left|vcenter default_format = "#low" alwaystransparent = yes autoresize = no }
						text_single = { using = Font_Size_Medium raw_text = "[Character.MakeScope.ScriptValue('hd_peace_release_vassal_price_value')|0]" position = { 440 0 } size = { 70 54 } align = right|vcenter default_format = "#negative_value" alwaystransparent = yes autoresize = no }
						icon = { texture = "gfx/interface/icons/symbols/icon_check.dds" position = { 530 15 } size = { 24 24 } visible = "[GetScriptedGui('hd_peace_demand_release_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]" alwaystransparent = yes }
					}
				}
			}
		}
	}
	text_multi = {
		visible = "[And(GetVariableSystem.Exists('hd_peace_treaty_offer_tab'), LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_release_candidate_count_value'), '(CFixedPoint)1'))]"
		using = Font_Size_Small
		text = "hd_peace_no_release_candidates"
		position = { 40 150 }
		size = { 540 120 }
		align = hcenter|top
		default_format = "#low"
		autoresize = no
	}
	scrollbox = {
		visible = "[GetVariableSystem.Exists('hd_peace_treaty_offer_tab')]"
		position = { 8 64 }
		size = { 604 386 }
		blockoverride "scrollbox_margins" {
			margin_top = 2
			margin_bottom = 8
			margin_left = 6
			margin_right = 18
		}
		blockoverride "scrollbox_content" {
			vbox = {
				datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_offer_release_candidates')]"
				layoutpolicy_horizontal = expanding
				spacing = 3
				item = {
					button_standard_list = {
						datacontext = "[Scope.Char]"
						size = { 578 54 }
						down = "[GetScriptedGui('hd_peace_offer_release_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]"
						enabled = "[GetScriptedGui('hd_peace_offer_release_toggle_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]"
						onclick = "[GetScriptedGui('hd_peace_offer_release_toggle_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]"
						tooltip = "hd_peace_release_row_tt"
						using = tooltip_ws
						coa_title_tiny_crown = { datacontext = "[Character.GetPrimaryTitle]" position = { 8 4 } }
						text_single = { using = Font_Size_Small text = "[Character.GetTitledFirstName]" position = { 56 6 } size = { 370 22 } align = left|vcenter default_format = "#high" alwaystransparent = yes autoresize = no }
						text_single = { using = Font_Size_Tiny text = "hd_peace_release_row_detail" position = { 56 29 } size = { 370 19 } align = left|vcenter default_format = "#low" alwaystransparent = yes autoresize = no }
						text_single = { using = Font_Size_Medium raw_text = "[Character.MakeScope.ScriptValue('hd_peace_release_vassal_price_value')|0]" position = { 440 0 } size = { 70 54 } align = right|vcenter default_format = "#positive_value" alwaystransparent = yes autoresize = no }
						icon = { texture = "gfx/interface/icons/symbols/icon_check.dds" position = { 530 15 } size = { 24 24 } visible = "[GetScriptedGui('hd_peace_offer_release_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]" alwaystransparent = yes }
					}
				}
			}
		}
	}

	widget = {
		visible = "[GetVariableSystem.Exists('hd_peace_treaty_demand_tab')]"
		position = { 620 64 }
		size = { 312 386 }
		background = {
			texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
			spriteType = Corneredtiled
			spriteborder = { 18 18 }
			alpha = 0.75
		}
		hd_peace_ui_column_title = { text = "hd_peace_selection_title" size = { 200 28 } }
		text_single = { using = Font_Size_Medium raw_text = "[GetPlayer.MakeScope.ScriptValue('hd_peace_demand_release_count_value')|0] / 3" position = { 200 4 } size = { 98 28 } align = right|vcenter default_format = "#high" autoresize = no }
		divider_light = { position = { 12 34 } size = { 288 2 } }
		text_multi = {
			visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_release_count_value'), '(CFixedPoint)0'))]"
			using = Font_Size_Small
			text = "hd_peace_selection_empty_vassals"
			position = { 20 56 }
			size = { 272 90 }
			align = hcenter|top
			default_format = "#low"
			autoresize = no
		}
		vbox = {
			position = { 8 42 }
			spacing = 3
			datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_demand_released_vassals')]"
			item = {
				button_standard_list = {
					datacontext = "[Scope.Char]"
					size = { 296 34 }
					onclick = "[GetScriptedGui('hd_peace_demand_release_toggle_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vassal', Character.MakeScope).End)]"
					tooltip = "hd_peace_selection_remove_tt"
					text_single = { using = Font_Size_Small text = "[Character.GetTitledFirstName]" position = { 10 0 } size = { 212 34 } align = left|vcenter default_format = "#high" alwaystransparent = yes autoresize = no }
					text_single = { using = Font_Size_Small raw_text = "[Character.MakeScope.ScriptValue('hd_peace_release_vassal_price_value')|0]" position = { 222 0 } size = { 44 34 } align = right|vcenter default_format = "#negative_value" alwaystransparent = yes autoresize = no }
					icon = { texture = "gfx/interface/icons/symbols/icon_cross.dds" position = { 274 9 } size = { 16 16 } alpha = 0.6 alwaystransparent = yes }
				}
			}
		}
		divider_light = { position = { 12 232 } size = { 288 2 } }
		text_single = { using = Font_Size_Small text = "hd_peace_selection_release_cost" position = { 14 240 } size = { 200 24 } autoresize = no align = left|vcenter default_format = "#medium" }
		text_single = { using = Font_Size_Small raw_text = "[GetPlayer.MakeScope.ScriptValue('hd_peace_demand_release_cost_value')|0]" position = { 214 240 } size = { 84 24 } autoresize = no align = right|vcenter default_format = "#high" }
		widget = {
			position = { 8 272 }
			size = { 296 54 }
			widget = {
				size = { 296 54 }
				widget = { visible = "[GetScriptedGui('hd_peace_ai_would_accept_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 100% 100% } background = { using = Status_Good } }
				widget = { visible = "[GetScriptedGui('hd_peace_ai_would_refuse_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" size = { 100% 100% } background = { using = Status_Bad } }
				text_single = { using = Font_Size_Small text = "hd_peace_deal_progress" position = { 10 2 } size = { 100 26 } autoresize = no align = left|vcenter default_format = "#high" tooltip = "hd_peace_acceptance_balance_tt" }
				text_single = { using = Font_Size_Big raw_text = "[GetPlayer.MakeScope.ScriptValue('hd_peace_deal_acceptance_value')|0]" position = { 194 0 } size = { 92 30 } autoresize = no align = right|vcenter default_format = "#high" tooltip = "hd_peace_acceptance_balance_tt" }
				text_single = { using = Font_Size_Tiny text = "hd_peace_verdict_accept" visible = "[GetScriptedGui('hd_peace_ai_would_accept_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" position = { 10 26 } size = { 276 18 } autoresize = no align = left|vcenter default_format = "#positive_value" }
				text_single = { using = Font_Size_Tiny text = "hd_peace_verdict_human" visible = "[GetScriptedGui('hd_peace_human_opponent_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" position = { 10 26 } size = { 276 18 } autoresize = no align = left|vcenter default_format = "#medium" }
				text_single = { using = Font_Size_Tiny text = "hd_peace_verdict_refuse" visible = "[GetScriptedGui('hd_peace_ai_would_refuse_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" position = { 10 26 } size = { 276 18 } autoresize = no align = left|vcenter default_format = "#negative_value" }
				hd_peace_ui_acceptance_bar = { position = { 10 45 } size = { 276 6 } }
			}
		}
		text_multi = { using = Font_Size_Tiny text = "hd_peace_release_eligibility_hint" position = { 14 334 } size = { 284 48 } autoresize = no align = left default_format = "#low" }
	}
	button_tertiary = { visible = "[GetVariableSystem.Exists('hd_peace_treaty_demand_tab')]" position = { 16 460 } size = { 140 32 } text = "hd_peace_clear" datacontext = "[GetScriptedGui('hd_peace_clear_demand_release_gui')]" enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
	widget = {
		visible = "[GetVariableSystem.Exists('hd_peace_treaty_offer_tab')]"
		position = { 620 64 }
		size = { 312 386 }
		background = {
			texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
			spriteType = Corneredtiled
