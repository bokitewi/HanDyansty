# Derived from the assessment page: same character information/filter/paging, selection only.
# 列表为人物scope；只有草稿列表为story scope。所有执行入口root=GetPlayer。
window = {
 button = { name = "WJ_ty_local_escape_menu" size = { 0 0 } shortcut = "close_window" visible = "[GetVariableSystem.Exists('wj_ty_local_filter_menu')]" onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]" }
 button = { name = "WJ_ty_local_escape_picker" size = { 0 0 } shortcut = "close_window" visible = "[Not(GetVariableSystem.Exists('wj_ty_local_filter_menu'))]" onclick = "[GetScriptedGui('WJ_ty_gui_cancel_picker').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 name = "WJ_ty_local_table_window"
 parentanchor = top|right
 position = { -50 65 }
 layer = top
 allow_outside = yes
 using = Window_Size_CharacterList
 using = Window_Background
 using = Window_Decoration_Spike
 using = Window_Movable
 filter_mouse = all
 alwaystransparent = no
 visible = "[GetScriptedGui('WJ_ty_local_picker_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)]"
 state = { name = _show on_start = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]" }
 widget = {
  name = "WJ_ty_local_panel"
  size = { 100% 100% }
  vbox = {
   using = Window_Margins
   spacing = 3
   header_pattern = {
    layoutpolicy_horizontal = expanding
    blockoverride "header_text" { text = WJ_ty_local_table_title }
    blockoverride "button_close" {
     name = "WJ_ty_local_close"
     onclick = "[GetScriptedGui('WJ_ty_gui_cancel_picker').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
   }
   hbox = {
    layoutpolicy_horizontal = expanding spacing = 8
    button = {
     name = "WJ_ty_local_tier_filter" size = { 190 34 }
     onclick = "[GetVariableSystem.Set('wj_ty_local_filter_menu', 'tier')]"
     button_drop = { alwaystransparent = yes size = { 100% 100% } text = WJ_ty_local_filter_tier_label }
    }
    button = {
     name = "WJ_ty_local_grade_filter" size = { 190 34 }
     onclick = "[GetVariableSystem.Set('wj_ty_local_filter_menu', 'grade')]"
     button_drop = { alwaystransparent = yes size = { 100% 100% } text = WJ_ty_local_filter_grade_label }
    }
    button_standard = {
     name = "WJ_ty_local_reset_filter" size = { 110 34 } text = WJ_kaoke_filter_all
     onclick = "[GetScriptedGui('WJ_ty_local_filter_reset').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    button_standard = {
     name = "WJ_ty_local_refresh" size = { 135 34 } text = WJ_kaoke_refresh
     onclick = "[GetScriptedGui('WJ_ty_local_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     tooltip = WJ_ty_local_table_help
    }
   }
   button_standard = {
    name = "WJ_ty_local_relations_filter" size = { 260 28 }
    text = WJ_ty_local_relations_filter_label
    tooltip = WJ_kaoke_relations_filter_tt
    onclick = "[GetScriptedGui('WJ_ty_local_filter_relations').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
   scrollbox = {
    name = "WJ_ty_local_body"
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    blockoverride "scrollbox_content" {
     fixedgridbox = {
      name = "WJ_ty_local_rows"
      addcolumn = 630
      addrow = 128
      datamodel_reuse_widgets = yes
      datamodel = "[GetPlayer.MakeScope.GetList('wj_ty_local_page_roster')]"
      item = {
       widget = {
        name = "WJ_ty_local_row" datacontext = "[Scope.Char]"
        size = { 630 128 }
        # 名单已先筛选，最多20行；此门禁只防开窗后人物身份变化，不再承担全朝过滤。
        visible = "[GetScriptedGui('WJ_ty_local_row_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
        hbox = {
         vbox = {
          layoutpolicy_vertical = expanding margin_top = 4
          portrait_head_small = { name = "WJ_ty_local_portrait" }
          expand = {}
         }
         vbox = {
          layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding margin_top = 5
          hbox = {
           layoutpolicy_horizontal = expanding margin = { 0 3 } margin_left = 5 margin_right = 10
           background = { using = Background_Area_Characterlist }
           background = {
            using = Background_Area_Dark
            modify_texture = { texture = "gfx/interface/component_masks/mask_fade_vertical.dds" blend_mode = alphamultiply alpha = 1 rotate_uv = 90 mirror = vertical }
           }
           text_single = {
            name = "WJ_ty_local_name" layoutpolicy_horizontal = expanding
            text = "[Character.Custom('WJ_GetUIName')]" using = Font_Size_Medium
            autoresize = no fontsize_min = 14 align = nobaseline
           }
           hbox = { name = "WJ_ty_local_age" using = character_age_or_death_text }
          }
          hbox = {
           layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
           vbox = {
            layoutpolicy_horizontal = expanding spacing = 2
            hbox = {
             name = "WJ_ty_local_identity" layoutpolicy_horizontal = expanding spacing = 5
             widget = {
              size = { 38 32 }
              coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.6 }
             }
             icon = {
              size = { 28 28 } datacontext = "[Character.GetFaith]" texture = "[Faith.GetIcon]"
              tooltipwidget = { faith_tooltip = {} } using = tooltip_se
             }
             hbox = {
              datacontext = "[Character.GetCulture]" spacing = 3
              tooltipwidget = { culture_tooltip = {} } using = tooltip_se
              icon = { size = { 24 24 } texture = "gfx/interface/icons/icon_culture.dds" }
              text_single = { size = { 64 28 } text = "[Culture.GetNameNoTooltip]" autoresize = no fontsize_min = 14 align = nobaseline }
             }
             WJ_luzhi_glyph = { size = { 28 28 } tooltip = "[Character.Custom('WJ_BandWordPlain')]" }
             expand = {}
             text_single = { text = WJ_kaoke_efficiency_short using = Font_Size_Small align = nobaseline }
             text_single = {
              name = "WJ_ty_local_efficiency" size = { 65 28 } align = nobaseline
              visible = "[GetScriptedGui('WJ_kaoke_efficiency_applicable').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
              text = ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_VALUE tooltip = ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_TT
             }
             text_single = {
              name = "WJ_ty_local_efficiency_na" size = { 65 28 } text = WJ_kaoke_not_applicable
              visible = "[Not(GetScriptedGui('WJ_kaoke_efficiency_applicable').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End))]"
             }
            }
            hbox = {
             name = "WJ_ty_local_metrics" layoutpolicy_horizontal = expanding spacing = 5 margin_left = 5
             text_single = { name = "WJ_ty_local_due" size = { 145 26 } text = WJ_kaoke_due_compact using = Font_Size_Small align = nobaseline }
             text_single = { text = WJ_kaoke_score_short using = Font_Size_Small align = nobaseline }
             text_single = { name = "WJ_ty_local_score" size = { 38 26 } text = "[Character.MakeScope.ScriptValue('WJ_kaoke_score_value')|0]" align = nobaseline tooltip = WJ_ai_kaoke_sources_tt }
             
            }
            hbox = {
             name = "WJ_ty_local_period_grades" layoutpolicy_horizontal = expanding spacing = 5 margin_left = 5
             expand = {}
             text_single = { text = WJ_kaoke_period_previous_label using = Font_Size_Small align = nobaseline }
             text_single = { name = "WJ_ty_local_previous_grade" size = { 28 26 } text = WJ_kaoke_period_previous_value align = nobaseline }
             spacer = { size = { 35 26 } }
             text_single = { text = WJ_kaoke_period_current_label using = Font_Size_Small align = nobaseline }
             text_single = { name = "WJ_ty_local_grade" size = { 28 26 } text = "[Character.Custom('WJKaokeCurrentGrade')]" align = nobaseline }
             
            button_standard = { name = "WJ_ty_local_select" size = { 60 26 } text = WJ_ty_local_confirm
  enabled = "[GetScriptedGui('WJ_ty_gui_target').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Character.MakeScope).End)]"
  onclick = "[GetScriptedGui('WJ_ty_gui_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Character.MakeScope).End)]"
  tooltip = "[GetScriptedGui('WJ_ty_gui_target').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Character.MakeScope).End)]"
 }
}
           }
           
          }
         }
        }
       }
      }
     }
    }
    blockoverride "scrollbox_empty" { visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_ty_local_page_roster'))]" text = WJ_kaoke_empty }
   }
   vbox = {
    name = "WJ_ty_local_footer" layoutpolicy_horizontal = expanding spacing = 4
    hbox = {
     layoutpolicy_horizontal = expanding spacing = 8
     button_standard = {
      name = "WJ_ty_local_previous" size = { 90 28 } text = WJ_kaoke_previous
      enabled = "[GetScriptedGui('WJ_ty_local_page_previous').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetScriptedGui('WJ_ty_local_page_previous').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     }
     text_single = { layoutpolicy_horizontal = expanding text = WJ_ty_local_page_status using = Font_Size_Small align = center|nobaseline }
     button_standard = {
      name = "WJ_ty_local_next" size = { 90 28 } text = WJ_kaoke_next
      enabled = "[GetScriptedGui('WJ_ty_local_page_next').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetScriptedGui('WJ_ty_local_page_next').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     }
    }
    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes text = WJ_ty_local_real_fief_blocked using = Font_Size_Small }
   }
  }
 }
  # 原版过滤器控件与菜单背景；数据只绑定本mod五等/爵级，勿套任命窗口候选人作用域。
  button = {
   size = { 100% 100% }
   visible = "[GetVariableSystem.Exists('wj_ty_local_filter_menu')]"
   onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
  }
  widget = {
   name = "WJ_ty_local_tier_menu" position = { 40 108 } size = { 190 144 }
   visible = "[GetVariableSystem.HasValue('wj_ty_local_filter_menu', 'tier')]"
   using = Background_DropDown filter_mouse = all
   vbox = {
    margin = { 4 4 } spacing = 0
    button = {
     name = "WJ_ty_local_tier_option_0" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_tier_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_all
     }
    }
    button = {
     name = "WJ_ty_local_tier_option_2" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_tier_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_county
     }
    }
    button = {
     name = "WJ_ty_local_tier_option_3" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_tier_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_duchy
     }
    }
    button = {
     name = "WJ_ty_local_tier_option_4" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_tier_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_tier_kingdom
     }
    }
   }
  }
  widget = {
   name = "WJ_ty_local_grade_menu" position = { 238 108 } size = { 190 212 }
   visible = "[GetVariableSystem.HasValue('wj_ty_local_filter_menu', 'grade')]"
   using = Background_DropDown filter_mouse = all
   vbox = {
    margin = { 4 4 } spacing = 0
    button = {
     name = "WJ_ty_local_grade_option_0" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_grade_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_all
     }
    }
    button = {
     name = "WJ_ty_local_grade_option_1" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_grade_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_lie
     }
    }
    button = {
     name = "WJ_ty_local_grade_option_2" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_grade_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_cha
     }
    }
    button = {
     name = "WJ_ty_local_grade_option_3" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_grade_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_ping
     }
    }
    button = {
     name = "WJ_ty_local_grade_option_4" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_grade_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_liang
     }
    }
    button = {
     name = "WJ_ty_local_grade_option_5" size = { 182 34 }
     onclick = "[GetScriptedGui('WJ_ty_local_filter_grade_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     onclick = "[GetVariableSystem.Clear('wj_ty_local_filter_menu')]"
    
     # 原版菜单皮肤不接点击；外层原生button接收，避免继承button_trigger=none。
     button_dropdown = {
      alwaystransparent = yes
      size = { 100% 100% }
      text = WJ_kaoke_grade_you
     }
    }
   }
  }
}

