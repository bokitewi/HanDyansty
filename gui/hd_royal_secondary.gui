types hd_royal_secondary_types
{
	type hd_royal_character_box = widget {
		size = { 350 110 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
		visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]"
		background = {
			texture = "gfx/interface/buttons/button_entry_characterlist.dds"
			framesize = { 252 80 } spriteType = Corneredtiled spriteborder = { 10 30 }
		}
		portrait_head_small = {
			position = { 8 8 } size = { 85 90 }
			blockoverride "coa" {} blockoverride "opinion_box" {}
			blockoverride "show_portrait_status_icons" { visible = no }
		}
		text_single = {
			position = { 104 8 } size = { 236 32 } autoresize = no fontsize = 17
			text = "[Character.Custom('WJ_GetUIName')]" tooltip = "[Character.Custom('WJ_GetUIName')]"
			fontcolor = { 0.18 0.12 0.10 1 }
		}
		text_single = {
			position = { 104 44 } size = { 236 24 } autoresize = no fontsize = 14
			text = "[Character.GetAge] · [Character.Custom2('WJ_RelationToViewer', CouncilWindow.GetCharacter)]"
			tooltip = "[Character.GetAge] · [Character.Custom2('WJ_RelationToViewer', CouncilWindow.GetCharacter)]"
			fontcolor = { 0.18 0.12 0.10 1 }
		}
		button_standard = {
			position = { 104 76 } size = { 108 28 } text = hd_secondary_royal_actions
			onclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
		}
	}
	type hd_royal_roster_group = vbox {
		layoutpolicy_horizontal = expanding spacing = 6 ignoreinvisible = yes
		text_single = {
			size = { 350 26 } fontsize = 18 autoresize = no align = center|nobaseline
			fontcolor = { 0.18 0.12 0.10 1 }
			block "group_title" { text = WJ_royal_group_sons }
		}
		dynamicgridbox = {
			block "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_sons')]" }
			datamodel_wrap = 1 flipdirection = yes ignoreinvisible = yes
			item = { hd_royal_character_box = { datacontext = "[Scope.GetCharacter]" } }
		}
	}
	type hd_royal_focus = widget {
		size = { 280 312 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed alwaystransparent = yes
		text_single = {
			position = { 0 0 } size = { 280 24 } fontsize = 20 autoresize = no align = center|nobaseline
			fontcolor = { 0.18 0.12 0.10 1 }
			block "focus_title" { text = hd_baiguan_office_tai_zi }
		}
		text_single = {
			position = { 0 24 } size = { 280 24 } fontsize = 17 autoresize = no align = center|nobaseline
			text = "[Character.GetNameNoTooltip]" tooltip = "[Character.GetNameNoTooltip]"
			fontcolor = { 0.18 0.12 0.10 1 }
		}
		portrait_button = {
			position = { 36 48 } using = portrait_base
			block "focus_portrait_size" { size = { 208 264 } }
			portrait_texture = "[Character.GetAnimatedPortrait('environment_torso', 'camera_torso', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			mask = "gfx/portraits/portrait_mask_torso.dds" effectname = "NoHighlight"
		}
	}
}

window = {
	name = "hd_royal_secondary_frame"
	enabled = "[Not(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
	# Native drag coordinates stay unscaled; the ordinary inner canvas scales as one.
	size = "[FloatToCVector2f(Multiply_float('(float)1448', ScaleToFitElementInside('(int32)1500', '(int32)1200')), Multiply_float('(float)1150', ScaleToFitElementInside('(int32)1500', '(int32)1200')))]"
	parentanchor = center widgetanchor = center layer = top alwaystransparent = no
	using = Window_Movable allow_outside = yes datacontext = "[AccessCouncilWindow]"
	visible = "[And(Or(GetVariableSystem.HasValue('hd_secondary_royal_page', 'harem'), GetVariableSystem.HasValue('hd_secondary_royal_page', 'clan')), And(Not(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true')), And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), And(GetPlayer.IsValid, And(CouncilWindow.GetCharacter.IsValid, And(Not(IsInteractionConfirmationWindowOpen), Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes')))))))))]"
	# Returning from interaction confirmation shows this root again and refreshes both views.
	state = {
		name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard
		on_start = "[GetScriptedGui('hd_baiguan_rebuild_effect').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
		on_start = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
	}
	state = { name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard }
	widget = {
		name = "hd_royal_secondary_canvas" size = { 1448 1150 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 }
		scale = "[ScaleToFitElementInside('(int32)1500', '(int32)1200')]"
		widget = {
			name = "hd_royal_secondary_eligibility_guard" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
			state = { name = _show on_start = "[GetVariableSystem.Clear('hd_secondary_royal_page')]" }
		}
		icon = {
			size = { 1448 1337 } texture = "gfx/interface/hd_baiguan/secondary_frame.png" alwaystransparent = yes
		}
		text_single = {
			position = { 210 414 } size = { 440 32 } text = WJ_baiguan_tab_harem fontsize = 24 autoresize = no
			fontcolor = { 0.18 0.12 0.10 1 } visible = "[GetVariableSystem.HasValue('hd_secondary_royal_page', 'harem')]"
		}
		text_single = {
			position = { 210 414 } size = { 440 32 } text = WJ_baiguan_tab_clan fontsize = 24 autoresize = no
			fontcolor = { 0.18 0.12 0.10 1 } visible = "[GetVariableSystem.HasValue('hd_secondary_royal_page', 'clan')]"
		}
		button_standard = {
			position = { 1120 414 } size = { 150 30 } text = WJ_royal_refresh
			onclick = "[GetScriptedGui('hd_baiguan_rebuild_effect').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
			onclick = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
		}
		button_close = {
			position = { 1336 428 } size = { 32 32 } tooltip = CLOSE_TOOLTIP
			shortcut = "[Select_CString(Or(IsInteractionConfirmationWindowOpen, GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), '', 'close_window')]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
		}
		widget = {
			name = "hd_royal_harem_layout" size = { 1448 1150 } alwaystransparent = yes
			visible = "[GetVariableSystem.HasValue('hd_secondary_royal_page', 'harem')]"
			widget = {
				name = "hd_royal_consort_column" position = { 205 455 } size = { 395 530 }
				text_single = {
					size = { 395 28 } text = WJ_royal_group_consorts fontsize = 19 autoresize = no align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
				}
				scrollbox = {
					position = { 0 36 } size = { 395 494 }
					blockoverride "scrollbox_background" {}
					blockoverride "scrollbox_margins" { margin = { 8 4 } }
					blockoverride "scrollbox_content" { vbox = {
						layoutpolicy_horizontal = expanding spacing = 8 ignoreinvisible = yes
						text_single = {
							size = { 350 28 } text = hd_secondary_royal_empty fontsize = 16 fontcolor = { 0.18 0.12 0.10 1 }
							visible = "[Not(GetScriptedGui('hd_royal_consorts_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
						}
						dynamicgridbox = {
							datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_consorts')]"
							datamodel_wrap = 1 flipdirection = yes ignoreinvisible = yes
							item = { hd_royal_character_box = { datacontext = "[Scope.GetCharacter]" } }
						}
					} }
				}
			}
			widget = {
				name = "hd_royal_former_column" position = { 925 455 } size = { 395 530 }
				text_single = {
					size = { 395 28 } text = WJ_royal_former_harem fontsize = 19 autoresize = no align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
				}
				scrollbox = {
					position = { 0 36 } size = { 395 494 }
					blockoverride "scrollbox_background" {}
					blockoverride "scrollbox_margins" { margin = { 8 4 } }
					blockoverride "scrollbox_content" { vbox = {
						layoutpolicy_horizontal = expanding spacing = 8 ignoreinvisible = yes
						text_single = {
							size = { 350 28 } text = hd_secondary_royal_empty fontsize = 16 fontcolor = { 0.18 0.12 0.10 1 }
							visible = "[Not(GetScriptedGui('hd_royal_former_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
						}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_royal_group_grand_dowagers }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_grand_dowagers')]" }
						}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_royal_group_dowagers }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_dowagers')]" }
						}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_royal_group_widows }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_widows')]" }
						}
					} }
				}
			}
			widget = {
				name = "hd_royal_empress" position = { 620 750 } size = { 280 300 } alwaystransparent = yes
				widget = {
					size = { 280 300 } alwaystransparent = yes
					visible = "[GetScriptedGui('hd_dragon_empress_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
					hd_royal_focus = {
						size = { 280 300 } datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_empress').Char]"
						blockoverride "focus_title" { text = hd_baiguan_office_huang_hou }
						blockoverride "focus_portrait_size" { size = { 208 252 } }
					}
				}
				text_single = {
					size = { 280 300 } text = hd_secondary_no_empress fontsize = 20 align = center|vcenter fontcolor = { 0.18 0.12 0.10 1 }
					visible = "[Not(GetScriptedGui('hd_dragon_empress_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
				}
			}
		}
		widget = {
			name = "hd_royal_clan_layout" size = { 1448 1150 } alwaystransparent = yes
			visible = "[GetVariableSystem.HasValue('hd_secondary_royal_page', 'clan')]"
			widget = {
				name = "hd_royal_clan_column" position = { 205 460 } size = { 395 420 }
				text_single = {
					size = { 395 28 } text = WJ_baiguan_tab_clan fontsize = 20 autoresize = no align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
				}
				scrollbox = {
					position = { 0 36 } size = { 395 384 }
					blockoverride "scrollbox_background" {}
					blockoverride "scrollbox_margins" { margin = { 8 4 } }
					blockoverride "scrollbox_content" { vbox = {
						layoutpolicy_horizontal = expanding spacing = 8 ignoreinvisible = yes
						text_single = {
							size = { 350 28 } text = hd_secondary_royal_empty fontsize = 16 fontcolor = { 0.18 0.12 0.10 1 }
							visible = "[Not(GetScriptedGui('hd_royal_clan_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
						}
						hd_royal_roster_group = {}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_royal_group_daughters }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_daughters')]" }
						}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_royal_group_kings }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_kings')]" }
						}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_peer_princess_name }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_princesses')]" }
						}
					} }
				}
			}
			widget = {
				name = "hd_royal_east_column" position = { 925 460 } size = { 395 420 }
				text_single = {
					size = { 395 28 } text = WJ_baiguan_tab_east_palace fontsize = 20 autoresize = no align = center|nobaseline
					fontcolor = { 0.18 0.12 0.10 1 }
				}
				scrollbox = {
					position = { 0 36 } size = { 395 384 } scrollbaralign_vertical = left
					blockoverride "scrollbox_background" {}
					blockoverride "scrollbox_margins" { margin = { 8 4 } }
					blockoverride "scrollbox_content" { vbox = {
						layoutpolicy_horizontal = expanding spacing = 8 ignoreinvisible = yes
						text_single = {
							size = { 350 28 } text = hd_secondary_royal_empty fontsize = 16 fontcolor = { 0.18 0.12 0.10 1 }
							visible = "[Not(GetScriptedGui('hd_royal_east_present').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
						}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_royal_group_heir_spouses }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_heir_spouses')]" }
						}
						hd_royal_roster_group = {
							blockoverride "group_title" { text = WJ_royal_group_heir_children }
							blockoverride "group_roster" { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_heir_children')]" }
						}
					} }
				}
			}
			widget = {
				name = "hd_royal_heir" position = { 620 738 } size = { 280 312 } alwaystransparent = yes
				widget = {
					size = { 280 312 } alwaystransparent = yes
					visible = "[GetScriptedGui('hd_dragon_heir_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
					hd_royal_focus = { datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_crown_prince').Char]" }
				}
				text_single = {
					size = { 280 312 } text = hd_secondary_no_heir fontsize = 20 align = center|vcenter fontcolor = { 0.18 0.12 0.10 1 }
					visible = "[Not(GetScriptedGui('hd_dragon_heir_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
				}
			}
		}
	}
}
