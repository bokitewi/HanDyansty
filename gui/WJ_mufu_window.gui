     visible = "[GetScriptedGui('WJ_mufu_assign_2').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     enabled = "[GetScriptedGui('WJ_mufu_assign_2').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
