# Independent of the visible window: temporary hiding never clears the view.
widget = {
	name = "hd_mufu_close_guard" size = { 0 0 } alwaystransparent = yes
	visible = "[And(GetPlayer.IsValid, And(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End), Or(Not(GetScriptedGui('WJ_mufu_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)), Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes')))))]"
	state = { name = _show on_start = "[GetScriptedGui('WJ_mufu_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
}
