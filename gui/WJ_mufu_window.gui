     onclick = "[GetScriptedGui('WJ_mufu_assign_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
    }
    button_standard = {
     position = { 448 24 } size = { 150 35 } text = WJ_mufu_select
     visible = "[GetScriptedGui('WJ_mufu_assign_4').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     enabled = "[GetScriptedGui('WJ_mufu_assign_4').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
     onclick = "[GetScriptedGui('WJ_mufu_assign_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
    }
