 # An opaque input barrier blocks the main panel while either child dialog is open.
 window = {
  name = "WJ_mufu_modal_barrier" size = { 100% 100% }
  layer = confirmation movable = no filter_mouse = all alwaystransparent = no
  visible = "[Or(GetScriptedGui('WJ_mufu_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_mufu_confirm_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
  using = Background_Fade
  widget = {
   name = "WJ_mufu_assignment_picker"
   parentanchor = center size = { 650 580 } using = Window_Background_Popup
   filter_mouse = all alwaystransparent = no
   visible = "[GetScriptedGui('WJ_mufu_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   text_multi = { position = { 20 12 } size = { 610 52 } text = WJ_mufu_picker_hint }
   widget = {
    name = "WJ_mufu_candidate_1" position = { 20 70 } size = { 610 86 }
    datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_1').Char]"
    visible = "[Character.IsValid]"
    background = { using = Background_Area_Characterlist }
    portrait_head_small = { position = { 0 0 } scale = 0.8 }
    button = {
     position = { 92 8 } size = { 344 26 } using = character_tooltip
     onclick = "[DefaultOnCharacterClick(Character.GetID)]"
     button_ignore = none
     text_single = { size = { 100% 100% } text = "[Character.Custom('WJ_GetShortUIName')]" autoresize = no alwaystransparent = yes }
    }
    widget = { position = { 92 45 } size = { 160 25 } hbox_skills_grid_character_model = {} }
    button_standard = {
     position = { 448 24 } size = { 150 35 } text = WJ_mufu_select
     visible = "[GetScriptedGui('WJ_mufu_assign_1').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     enabled = "[GetScriptedGui('WJ_mufu_assign_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
     onclick = "[GetScriptedGui('WJ_mufu_assign_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
    }
    button_standard = {
