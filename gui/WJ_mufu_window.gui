types hd_mufu_types
{
	type hd_mufu_person_menu = button_round {
		size = { 32 32 } tooltip = hd_secondary_royal_actions
		onclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
		button_icon = { parentanchor = center size = { 25 25 } texture = "gfx/interface/icons/flat_icons/character_interactions.dds" alwaystransparent = yes }
	}
	type hd_mufu_staff_card = widget {
		size = { 268 168 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
		background = { texture = "gfx/interface/colors/black.dds" alpha = 0.55 }
		text_single = {
			position = { 10 6 } size = { 248 30 } fontsize = 20 autoresize = no fontcolor = { 0.93 0.88 0.77 1 }
			block "staff_role" { text = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.Custom('WJ_mufu_role_1')]" }
		}
		widget = {
			name = "hd_mufu_staff_person" size = { 268 168 }
			block "staff_current" { visible = "[GetScriptedGui('hd_mufu_slot_1_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			portrait_button = {
				position = { 8 42 } size = { 108 120 } using = portrait_base
				portrait_texture = "[Character.GetAnimatedPortrait('environment_torso', 'camera_torso', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
				mask = "gfx/portraits/portrait_mask_torso.dds" effectname = "NoHighlight"
			}
			text_single = {
				position = { 124 40 } size = { 134 28 } fontsize = 16 autoresize = no
				text = "[Character.Custom('WJ_GetShortUIName')]" tooltip = "[Character.Custom('WJ_GetUIName')]" fontcolor = { 0.93 0.88 0.77 1 }
			}
			text_single = {
				position = { 124 74 } size = { 134 24 } fontsize = 14 autoresize = no text = WJ_mufu_card_salary fontcolor = { 0.93 0.88 0.77 1 }
			}
			text_single = {
				position = { 124 102 } size = { 134 24 } fontsize = 14 autoresize = no fontcolor = { 0.93 0.88 0.77 1 }
				tooltip = "[Character.Custom('WJ_mufu_tenure')]" block "staff_bonus" { text = WJ_mufu_card_bonus_1 }
			}
			hd_mufu_person_menu = { position = { 124 132 } }
			button_standard = {
				position = { 196 136 } size = { 62 26 } text = WJ_mufu_dismiss_label
				visible = "[GetScriptedGui('WJ_mufu_manage').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = "[GetScriptedGui('WJ_mufu_dismiss').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
				onclick = "[GetScriptedGui('WJ_mufu_dismiss').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
			}
		}
		text_single = {
			position = { 12 64 } size = { 244 42 } fontsize = 18 autoresize = no align = center|nobaseline
			text = WJ_inner_vacant tooltip = WJ_mufu_empty_card fontcolor = { 0.93 0.88 0.77 1 }
			block "staff_vacant" { visible = "[Not(GetScriptedGui('hd_mufu_slot_1_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
		}
		button_round = {
			position = { 160 132 } size = { 32 32 } tooltip = WJ_mufu_assign_existing
			visible = "[GetScriptedGui('WJ_mufu_manage').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			block "staff_assign" { onclick = "[GetScriptedGui('WJ_mufu_picker_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			button_change = { parentanchor = center alwaystransparent = yes }
		}
	}
}

window = {
	name = "WJ_mufu_window"
	# Native drag coordinates stay unscaled; only the ordinary canvas scales.
	size = "[FloatToCVector2f(Multiply_float('(float)1179', ScaleToFitElementInside('(int32)1250', '(int32)960')), Multiply_float('(float)900', ScaleToFitElementInside('(int32)1250', '(int32)960')))]"
	parentanchor = center widgetanchor = center layer = confirmation allow_outside = yes
	using = Window_Movable filter_mouse = all alwaystransparent = no
	visible = "[And(GetPlayer.IsValid, And(GetScriptedGui('WJ_mufu_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End), And(Not(IsInteractionConfirmationWindowOpen), Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes'))))))]"
	datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char]"
	state = { name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard }
	state = { name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard }
	widget = {
		name = "hd_mufu_canvas" size = { 1179 900 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 } scale = "[ScaleToFitElementInside('(int32)1250', '(int32)960')]"
		widget = {
			name = "WJ_mufu_main_panel" size = { 1179 900 }
			enabled = "[Not(Or(GetScriptedGui('WJ_mufu_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_mufu_confirm_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
			icon = { size = { 1179 900 } texture = "gfx/interface/hd_baiguan/ui4.png" alwaystransparent = yes }
			text_single = {
				position = { 450 166 } size = { 280 30 } text = WJ_mufu_title fontsize = 22 autoresize = no align = center|nobaseline
				fontcolor = { 0.18 0.12 0.10 1 } tooltip = hd_mufu_window_help
			}
			button_close = {
				name = "WJ_mufu_close_button" position = { 1108 422 } size = { 32 32 } tooltip = CLOSE_TOOLTIP
				shortcut = "[Select_CString(Or(IsInteractionConfirmationWindowOpen, Or(GetScriptedGui('WJ_mufu_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_mufu_confirm_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))), '', 'close_window')]"
				onclick = "[GetScriptedGui('WJ_mufu_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			widget = {
				name = "WJ_mufu_owner" position = { 482 198 } size = { 230 246 }
				background = { texture = "gfx/interface/colors/black.dds" alpha = 0.55 }
				text_single = {
					position = { 12 8 } size = { 206 26 } fontsize = 20 autoresize = no
					text = "[Character.Custom('WJ_MufuOfficeStem')]" tooltip = hd_mufu_owner_help fontcolor = { 0.93 0.88 0.77 1 }
				}
				text_single = {
					position = { 12 34 } size = { 206 22 } fontsize = 16 autoresize = no
					text = "[Character.Custom('WJ_GetShortUIName')]" tooltip = "[Character.Custom('WJ_GetUIName')]" fontcolor = { 0.93 0.88 0.77 1 }
				}
				portrait_button = {
					position = { 12 56 } size = { 160 182 } using = portrait_base
					portrait_texture = "[Character.GetAnimatedPortrait('environment_torso', 'camera_torso', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
					mask = "gfx/portraits/portrait_mask_torso.dds" effectname = "NoHighlight"
				}
				hd_mufu_person_menu = { position = { 186 204 } }
			}
			hd_mufu_staff_card = {
				name = "WJ_mufu_card_1" position = { 170 456 }
				datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_1').Char]"
			}
			hd_mufu_staff_card = {
				name = "WJ_mufu_card_2" position = { 456 456 }
				datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_2').Char]"
				blockoverride "staff_role" { text = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.Custom('WJ_mufu_role_2')]" }
				blockoverride "staff_current" { visible = "[GetScriptedGui('hd_mufu_slot_2_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "staff_vacant" { visible = "[Not(GetScriptedGui('hd_mufu_slot_2_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
				blockoverride "staff_bonus" { text = WJ_mufu_card_bonus_2 }
				blockoverride "staff_assign" { onclick = "[GetScriptedGui('WJ_mufu_picker_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}
			hd_mufu_staff_card = {
				name = "WJ_mufu_card_3" position = { 742 456 }
				datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_3').Char]"
				blockoverride "staff_role" { text = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.Custom('WJ_mufu_role_3')]" }
				blockoverride "staff_current" { visible = "[GetScriptedGui('hd_mufu_slot_3_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "staff_vacant" { visible = "[Not(GetScriptedGui('hd_mufu_slot_3_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
				blockoverride "staff_bonus" { text = WJ_mufu_card_bonus_3 }
				blockoverride "staff_assign" { onclick = "[GetScriptedGui('WJ_mufu_picker_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}
			hd_mufu_staff_card = {
				name = "WJ_mufu_card_4" position = { 313 636 }
				datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_4').Char]"
				blockoverride "staff_role" { text = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.Custom('WJ_mufu_role_4')]" }
				blockoverride "staff_current" { visible = "[GetScriptedGui('hd_mufu_slot_4_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "staff_vacant" { visible = "[Not(GetScriptedGui('hd_mufu_slot_4_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
				blockoverride "staff_bonus" { text = WJ_mufu_card_bonus_4 }
				blockoverride "staff_assign" { onclick = "[GetScriptedGui('WJ_mufu_picker_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}
			hd_mufu_staff_card = {
				name = "WJ_mufu_card_5" position = { 599 636 }
				datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_5').Char]"
				blockoverride "staff_role" { text = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.Custom('WJ_mufu_role_5')]" }
				blockoverride "staff_current" { visible = "[GetScriptedGui('hd_mufu_slot_5_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "staff_vacant" { visible = "[Not(GetScriptedGui('hd_mufu_slot_5_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
				blockoverride "staff_bonus" { text = WJ_mufu_card_bonus_5 }
				blockoverride "staff_assign" { onclick = "[GetScriptedGui('WJ_mufu_picker_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
			}
			button_standard = {
				position = { 174 768 } size = { 130 30 } text = WJ_mufu_resign_label
				visible = "[GetScriptedGui('WJ_mufu_resign').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = "[GetScriptedGui('WJ_mufu_resign').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "[GetPlayer.Custom('WJ_mufu_tenure')]"
				onclick = "[GetScriptedGui('WJ_mufu_resign').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
 # An opaque input barrier blocks the main panel while either child dialog is open.
 window = {
  name = "WJ_mufu_modal_barrier" size = { 100% 100% }
  layer = confirmation movable = no filter_mouse = all alwaystransparent = no
  visible = "[Or(GetScriptedGui('WJ_mufu_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_mufu_confirm_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
  using = Background_Fade
  widget = {
   name = "WJ_mufu_assignment_picker"
   parentanchor = center size = { 650 580 } using = Window_Background_Popup
   filter_mouse = all alwaystransparent = no
