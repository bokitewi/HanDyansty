  # Native shared/dialogs.gui confirmation layout/art; only callbacks differ.
  widget = {
   name = "WJ_mufu_confirmation"
   parentanchor = center size = { 480 235 } using = Window_Background_Popup
   filter_mouse = all alwaystransparent = no
   visible = "[GetScriptedGui('WJ_mufu_confirm_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_confirm_target').Char]"
   vbox = {
    margin = { 15 10 } spacing = 10
    header_standard = {
     layoutpolicy_horizontal = expanding
     blockoverride "header_text" { text = WJ_mufu_confirm_label }
     blockoverride "button_close" { visible = no }
    }
    text_multi = { size = { 440 95 } text = WJ_mufu_confirm_text using = Font_Size_Small }
    hbox = {
     spacing = 15
     button_standard = { size = { 205 34 } text = WJ_mufu_cancel onclick = "[GetScriptedGui('WJ_mufu_confirm_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
     button_primary = {
      size = { 205 34 } text = WJ_mufu_confirm_label
      enabled = "[GetScriptedGui('WJ_mufu_confirm').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetScriptedGui('WJ_mufu_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
     }
    }
   }
