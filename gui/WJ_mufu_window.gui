# Shares the same native council-scene card as the inner court.
window = {
 name = "WJ_mufu_window"
 size = { 1120 730 } parentanchor = center
 layer = middle allow_outside = yes
 using = Window_Background using = Window_Decoration_Spike using = Window_Movable
 filter_mouse = all alwaystransparent = no
 visible = "[GetScriptedGui('WJ_mufu_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char]"
 widget = {
  name = "WJ_mufu_main_panel" size = { 100% 100% }
  enabled = "[Not(Or(GetScriptedGui('WJ_mufu_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('WJ_mufu_confirm_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
  widget = {
   position = { 20 10 } size = { 1080 50 }
   header_pattern = {
    blockoverride "size" { size = { 1080 50 } }
    blockoverride "header_text" { text = WJ_mufu_title }
    blockoverride "button_close" { name = "WJ_mufu_close_button" onclick = "[GetScriptedGui('WJ_mufu_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
   }
  }
  widget = {
   # The whole window already requires a real Han/Jin mufu owner; Tang has no mufu layout.
   name = "WJ_mufu_owner" position = { 35 62 } size = { 600 116 }
   background = { using = Background_Area_Characterlist }
   background = {
    using = Background_Area_Dark
    modify_texture = { texture = "gfx/interface/component_masks/mask_fade_vertical.dds" blend_mode = alphamultiply alpha = 1 rotate_uv = 90 mirror = vertical }
   }
   # Native card includes the title shield, character actions, status and opinion toward the player.
   portrait_head_small = { name = "WJ_mufu_owner_portrait" position = { 6 16 } }
   button = {
    position = { 104 4 } size = { 480 52 } using = character_tooltip
    onclick = "[DefaultOnCharacterClick(Character.GetID)]" button_ignore = none
    # Fixed left-column budget: wrapping cannot enlarge the card or push the history panel.
    textbox = {
     name = "WJ_mufu_owner_name"
     using = Font_Type_Standard
     multiline = yes autoresize = yes max_width = 480 max_height = 52
     elide = none align = top|left default_format = "#high" alwaystransparent = yes
     text = "[Character.Custom('WJ_GetUIName')]"
     fontsize = "[Select_int32(GreaterThan_float(Multiply_float(GetY_CVector2f(PdxGetWidgetScreenSize(PdxGuiWidget.FindChild('WJ_mufu_name_wrap_probe'))), GetInvParentScale(PdxGuiWidget.Self)), '(float)52'), '(int32)14', '(int32)18')]"
     fontsize_min = "[Select_int32(GreaterThan_float(Multiply_float(GetY_CVector2f(PdxGetWidgetScreenSize(PdxGuiWidget.FindChild('WJ_mufu_name_wrap_probe'))), GetInvParentScale(PdxGuiWidget.Self)), '(float)52'), '(int32)14', '(int32)18')]"
     # Fixed width, independent of parent measurement: cannot expand the card or the history column.
     textbox = {
      name = "WJ_mufu_name_wrap_probe"
      using = Font_Type_Standard
      text = "[Character.Custom('WJ_GetUIName')]"
      multiline = yes autoresize = yes max_width = 480
      fontsize = 18 fontsize_min = 18 align = top|left default_format = "#high"
      alpha = 0 alwaystransparent = yes
     }
    }
   }
   widget = {
    name = "WJ_mufu_owner_identity" position = { 104 58 } size = { 480 28 }
    hbox = {
     spacing = 8
     widget = { size = { 64 25 } character_age_health = {} }
     widget = {
      size = { 32 28 }
      coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.5 }
     }
     icon = {
      size = { 28 28 } datacontext = "[Character.GetFaith]" texture = "[Faith.GetIcon]"
      tooltipwidget = { faith_tooltip = {} } using = tooltip_se
     }
     hbox = {
      datacontext = "[Character.GetCulture]" spacing = 3
      tooltipwidget = { culture_tooltip = {} } using = tooltip_se
      icon = { size = { 24 24 } texture = "gfx/interface/icons/icon_culture.dds" }
      text_single = { size = { 94 28 } text = "[Culture.GetNameNoTooltip]" autoresize = no fontsize = 16 fontsize_min = 14 align = nobaseline }
     }
     WJ_luzhi_glyph = { size = { 28 28 } tooltip = "[Character.Custom('WJ_BandWordPlain')]" }
     text_single = { size = { 120 28 } text = "[Character.Custom('WJ_BandWordPlain')]" autoresize = no fontsize = 16 fontsize_min = 14 align = nobaseline }
    }
   }
   widget = {
    name = "WJ_mufu_owner_skills" position = { 104 89 } size = { 480 25 }
    hbox = {
     spacing = 12
     widget = { size = { 160 25 } hbox_skills_grid_character_model = {} }
     hbox = {
      spacing = 3 tooltip = prowess_concept
      icon = { size = { 24 24 } texture = "gfx/interface/icons/icon_prowess.dds" }
      text_single = { size = { 40 25 } text = "[Character.GetProwess|0]" autoresize = no align = nobaseline }
     }
    }
   }
  }
  widget = {
   name = "WJ_mufu_history" position = { 655 62 } size = { 430 116 }
   background = { using = Text_Label_Background }
   text_multi = { position = { 10 4 } size = { 410 108 } text = WJ_mufu_history_intro fontsize = 16 autoresize = no tooltip = WJ_mufu_history_detail }
  }
  widget = {
   name = "WJ_mufu_card_1" position = { 35 185 } size = { 330 230 }
   WJ_inner_person_card = {
    parentanchor = top|left widgetanchor = top|left scale = 0.75
    datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_1').Char]"
    blockoverride "inner_title" { text = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.Custom('WJ_mufu_role_1')]" }
    blockoverride "inner_title_font" { fontsize = 22 }
    blockoverride "inner_name_font" { fontsize = 22 }
    blockoverride "inner_vacant_font" { fontsize = 22 }
    blockoverride "inner_scene" { texture = "gfx/interface/illustrations/event_scenes/tgp_examination_room.dds" }
    blockoverride "inner_appointment" {
     button_round = {
      position = { 396 230 } size = { 32 32 }
      visible = "[GetScriptedGui('WJ_mufu_manage').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetScriptedGui('WJ_mufu_picker_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      tooltip = WJ_mufu_assign_existing
      button_change = { parentanchor = center alwaystransparent = yes }
     }
    }
    blockoverride "inner_footer" {
     widget = {
      position = { 286 86 } size = { 146 32 } visible = "[Character.IsValid]"
      background = { using = Text_Label_Background }
      icon = { position = { 0 2 } size = { 20 24 } texture = "gfx/interface/icons/symbols/icon_arrow_up.dds" alwaystransparent = yes }
      text_single = { position = { 23 2 } size = { 123 27 } text = "WJ_mufu_card_bonus_1" tooltip = "[Character.Custom('WJ_mufu_tenure')]" autoresize = no }
     }
    }
   }
   text_single = {
    position = { 8 203 } size = { 196 24 } text = WJ_mufu_card_salary
    visible = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_1').Char.IsValid]"
   }
   button_standard = {
    position = { 242 203 } size = { 86 26 } text = WJ_mufu_dismiss_label
    datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_1').Char]"
    visible = "[And(Character.IsValid, GetScriptedGui('WJ_mufu_manage').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
    enabled = "[GetScriptedGui('WJ_mufu_dismiss').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
    onclick = "[GetScriptedGui('WJ_mufu_dismiss').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
   }
   text_single = {
    position = { 8 204 } size = { 316 24 } text = WJ_mufu_empty_short tooltip = WJ_mufu_empty_card
    visible = "[Not(GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_1').Char.IsValid)]"
   }
  }
  widget = {
   name = "WJ_mufu_card_2" position = { 395 185 } size = { 330 230 }
   WJ_inner_person_card = {
    parentanchor = top|left widgetanchor = top|left scale = 0.75
    datacontext = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.MakeScope.Var('wj_mufu_slot_2').Char]"
    blockoverride "inner_title" { text = "[GetPlayer.MakeScope.Var('wj_mufu_view').Char.Custom('WJ_mufu_role_2')]" }
