 type WJ_mt_menu_button = button_round {
  size = { 32 32 } tooltip = WJ_dd_ui_officer_actions
  onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, Select_CString(ObjectsEqual(Character.Self, GetPlayer.GetTopLiege), 'wj_military_transfer', 'wj_district_management'))]"
  tooltip_visible = "[Not(IsInteractionMenuOpenForCharacterWithFilter(Character.Self, Select_CString(ObjectsEqual(Character.Self, GetPlayer.GetTopLiege), 'wj_military_transfer', 'wj_district_management')))]"
  button_icon = { parentanchor = center size = { 25 25 } texture = "gfx/interface/icons/flat_icons/character_interactions.dds" alwaystransparent = yes }
  text_single = {
   parentanchor = bottom|hcenter position = { 0 3 } default_format = "#high"
   text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, Select_CString(ObjectsEqual(Character.Self, GetPlayer.GetTopLiege), 'wj_military_transfer', 'wj_district_management'))]"
  }
 }
 type WJ_mt_officer_card = widget {
  size = { 268 284 }
  WJ_dd_officer_card = { parentanchor = top|hcenter blockoverride "officer_actions" {} }
  WJ_mt_menu_button = { position = { 232 246 } }
  button_standard = { position = { 22 246 } size = { 202 30 } text = WJ_mt_subordinates
   onclick = "[GetScriptedGui('WJ_mt_ui_subordinates').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End)]"
  }
 }
 type WJ_mt_regiment_card = container {
  datacontext = "[Scope.Regiment]" using = tooltip_es
  background = { texture = "[Regiment.GetMAAType.GetHorizontalImage]" alpha = 0.5 fittype = centercrop margin = { -2 -2 } }
  button_standard_clean = {
   size = { 132 100 }
   block "regiment_click" {}
   vbox = { margin = { 4 2 } expand = {}
    hbox = { layoutpolicy_horizontal = expanding spacing = 3 background = { using = Background_Area_Dark }
     icon = { texture = "[Regiment.GetMAAType.GetIcon]" size = { 16 16 } }
     text_single = { text = "[Regiment.GetName]" using = Font_Size_Small max_width = 100 }
    }
    text_single = { text = MAA_CURRENT_SIZE default_format = "#high" using = Font_Size_Small }
   }
  }
  tooltipwidget = { using = regiment_container_text_tooltip }
 }
}
window = {
 name = WJ_military_transfer size = { 1000 790 } parentanchor = center layer = top
 using = Window_Background using = Window_Decoration_Spike using = Window_Movable
 filter_mouse = all allow_outside = yes
 visible = "[GetPlayer.MakeScope.Var('wj_mt_open').IsSet]"
 widget = { position = { 20 8 } size = { 960 48 }
  header_pattern = {
   blockoverride "size" { size = { 960 48 } }
   blockoverride "header_text" { text = WJ_mt_window_title }
   blockoverride "button_close" { onclick = "[GetScriptedGui('WJ_mt_ui_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
  }
 }
 widget = {
  name = "transfer_a_column" position = { 24 62 } size = { 462 466 }
  portrait_head_small = {
   parentanchor = top|hcenter position = { 0 0 }
   datacontext = "[GetPlayer.MakeScope.Var('wj_mt_a').Char]" blockoverride "opinion_box" {}
  }
  text_single = {
   position = { 12 96 } size = { 438 28 } autoresize = no fontsize = 16 align = center
   text = "[GetPlayer.MakeScope.Var('wj_mt_a').Char.Custom('WJ_GetUIName')]"
  }
  text_single = { position = { 12 126 } size = { 438 24 } autoresize = no fontsize = 15 text = WJ_mt_a_heading align = center default_format = "#high" }
  scrollbox = { position = { 0 154 } size = { 462 84 }
   blockoverride "scrollbox_margins" { margin = { 4 4 } }
   visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('wj_mt_mode').GetValue, '(CFixedPoint)1')]"
   blockoverride "scrollbox_content" { vbox = {
    spacing = 4 datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_titles_a')]"
    item = { button_standard = {
     datacontext = "[Scope.Title]" size = { 438 36 }
     onclick = "[GetScriptedGui('WJ_mt_ui_title_a').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('title', Title.MakeScope).End)]"
     down = "[ObjectsEqual(Title.Self, GetPlayer.MakeScope.Var('wj_mt_title_a').Title)]"
     widget = { position = { 12 2 } size = { 36 32 } alwaystransparent = yes
      coa_title_tiny_crown = { parentanchor = center alwaystransparent = yes }
     }
     text_single = {
      position = { 58 0 } size = { 364 36 } autoresize = no align = left|vcenter fontsize = 16
      text = "[Title.GetNameNoTooltip]" alwaystransparent = yes
     }
    } }
   } }
  }
  text_multi = {
   position = { 18 162 } size = { 426 64 } autoresize = no fontsize = 16
   visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('wj_mt_mode').GetValue, '(CFixedPoint)2')]"
   text = WJ_mt_private_source_hint
  }
  scrollbox = { position = { 0 244 } size = { 462 164 }
   blockoverride "scrollbox_margins" { margin = { 4 4 } }
   blockoverride "scrollbox_content" { fixedgridbox = {
    datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_available')]"
    datamodel_wrap = 3 flipdirection = yes addcolumn = 145 addrow = 108
    item = { WJ_mt_regiment_card = {
     blockoverride "regiment_click" { onclick = "[GetScriptedGui('WJ_mt_ui_add').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('regiment', Regiment.MakeScope).End)]" }
    } }
   } }
  }
  text_multi = {
   position = { 20 270 } size = { 410 84 } autoresize = no fontsize = 15
   visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_mt_available'))]"
   text = WJ_mt_a_empty default_format = "#weak"
  }
  button_standard = {
   position = { 86 420 } size = { 290 32 } text = WJ_mt_a_all
   onclick = "[GetScriptedGui('WJ_mt_ui_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
 }
 widget = {
  name = "transfer_b_column" position = { 514 62 } size = { 462 466 }
  portrait_head_small = {
   parentanchor = top|hcenter position = { 0 0 }
   datacontext = "[GetPlayer.MakeScope.Var('wj_mt_b').Char]" blockoverride "opinion_box" {}
  }
  text_single = {
   position = { 12 96 } size = { 438 28 } autoresize = no fontsize = 16 align = center
   text = "[GetPlayer.MakeScope.Var('wj_mt_b').Char.Custom('WJ_GetUIName')]"
  }
  text_single = { position = { 12 126 } size = { 438 24 } autoresize = no fontsize = 15 text = WJ_mt_b_heading align = center default_format = "#high" }
  scrollbox = { position = { 0 154 } size = { 462 84 }
   blockoverride "scrollbox_margins" { margin = { 4 4 } }
   blockoverride "scrollbox_content" { vbox = {
    spacing = 4 datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_titles_b')]"
    item = { button_standard = {
     datacontext = "[Scope.Title]" size = { 438 36 }
     onclick = "[GetScriptedGui('WJ_mt_ui_title_b').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('title', Title.MakeScope).End)]"
     down = "[ObjectsEqual(Title.Self, GetPlayer.MakeScope.Var('wj_mt_title_b').Title)]"
     widget = { position = { 12 2 } size = { 36 32 } alwaystransparent = yes
      coa_title_tiny_crown = { parentanchor = center alwaystransparent = yes }
     }
     text_single = {
      position = { 58 0 } size = { 364 36 } autoresize = no align = left|vcenter fontsize = 16
      text = "[Title.GetNameNoTooltip]" alwaystransparent = yes
     }
    } }
   } }
  }
  
  scrollbox = { position = { 0 244 } size = { 462 164 }
   blockoverride "scrollbox_margins" { margin = { 4 4 } }
   blockoverride "scrollbox_content" { fixedgridbox = {
    datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_pending')]"
    datamodel_wrap = 3 flipdirection = yes addcolumn = 145 addrow = 108
    item = { WJ_mt_regiment_card = {
     blockoverride "regiment_click" { onclick = "[GetScriptedGui('WJ_mt_ui_remove').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('regiment', Regiment.MakeScope).End)]" }
    } }
   } }
  }
  text_multi = {
   position = { 20 270 } size = { 410 84 } autoresize = no fontsize = 15
   visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_mt_pending'))]"
   text = WJ_mt_b_empty default_format = "#weak"
  }
  button_standard = {
   position = { 86 420 } size = { 290 32 } text = WJ_mt_b_all
   onclick = "[GetScriptedGui('WJ_mt_ui_none').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }
 }
 widget = {
  name = "transfer_order_summary" position = { 24 530 } size = { 952 86 }
  background = { using = Background_Area_Dark }
  text_single = { position = { 16 4 } size = { 920 26 } autoresize = no fontsize = 16 text = WJ_mt_pending_line }
  text_single = { position = { 16 30 } size = { 920 26 } autoresize = no fontsize = 16 text = WJ_mt_compensation_line }
  text_single = { position = { 16 56 } size = { 920 26 } autoresize = no fontsize = 15 text = WJ_mt_preview_line default_format = "#weak" }
 }
 # Native interaction_templates.gui answer_chance visuals; no confirmation-window context in this custom draft window.
 widget = {
  name = "transfer_acceptance" position = { 335 626 } size = { 330 46 }
  tooltip = "[GetScriptedGui('WJ_mt_ui_chance_details').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  background = { using = Background_Area_Dark }
  hbox = {
   parentanchor = center spacing = 4
   icon = { texture = "gfx/interface/icons/symbols/icon_check.dds" size = { 30 30 } alwaystransparent = yes }
   text_single = { text = WJ_mt_acceptance_label using = Font_Size_Medium align = nobaseline alwaystransparent = yes }
   text_single = { text = WJ_mt_acceptance_percent using = Font_Size_Medium align = nobaseline default_format = "#positive_value" alwaystransparent = yes }
  }
  progressbar_standard = {
   position = { 0 3 } size = { 324 10 } parentanchor = bottom|hcenter alwaystransparent = yes
   value = "[FixedPointToFloat(GetPlayer.MakeScope.Var('wj_mt_chance').GetValue)]"
  }
 }
 button_standard = { position = { 338 686 } size = { 324 40 } text = WJ_mt_confirm
  enabled = "[GetScriptedGui('WJ_mt_ui_confirm').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  tooltip = "[GetScriptedGui('WJ_mt_ui_confirm').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  onclick = "[GetScriptedGui('WJ_mt_ui_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
 button_standard = { position = { 818 690 } size = { 144 32 } text = WJ_mt_refresh_label
  tooltip = WJ_mt_refresh_desc
  onclick = "[GetScriptedGui('WJ_mt_ui_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
 widget = {
  name = "transfer_rules" position = { 32 736 } size = { 930 42 }
  text_multi = { size = { 930 42 } text = WJ_mt_preview_hint fontsize = 14 autoresize = no default_format = "#weak" }
 }
}
window = {
 name = WJ_military_subordinates size = { 1000 730 } parentanchor = center layer = top
 using = Window_Background using = Window_Decoration_Spike using = Window_Movable filter_mouse = all allow_outside = yes
 visible = "[GetPlayer.MakeScope.Var('wj_mt_subordinate_head').IsSet]"
 datacontext = "[GetPlayer.MakeScope.Var('wj_mt_subordinate_head').Char]"
 text_single = { position = { 24 12 } size = { 900 36 } text = WJ_mt_subordinates_title default_format = "#high" autoresize = no }
 button_close = { position = { 946 12 } onclick = "[GetScriptedGui('WJ_mt_ui_subordinates_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 scrollbox = { position = { 24 64 } size = { 952 636 }
  blockoverride "scrollbox_margins" { margin = { 4 4 } }
  blockoverride "scrollbox_content" { vbox = { spacing = 14
   text_single = { size = { 910 32 } text = WJ_mt_rank_kingdom align = center default_format = "#high" background = { using = Background_Area_Dark } }
   dynamicgridbox = {
    datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_subordinates_kingdom')]"
    datamodel_wrap = 7 flipdirection = yes
    item = { widget = { size = { 133 238 } datacontext = "[Scope.Char]" WJ_dd_officer_card = {} } }
   }
   text_single = { size = { 910 32 } text = WJ_mt_rank_duchy align = center default_format = "#high" background = { using = Background_Area_Dark } }
   dynamicgridbox = {
    datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_subordinates_duchy')]"
    datamodel_wrap = 7 flipdirection = yes
    item = { widget = { size = { 133 238 } datacontext = "[Scope.Char]" WJ_dd_officer_card = {} } }
   }
   text_single = { size = { 910 32 } text = WJ_mt_rank_county align = center default_format = "#high" background = { using = Background_Area_Dark } }
   dynamicgridbox = {
    datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_subordinates_county')]"
    datamodel_wrap = 7 flipdirection = yes
    item = { widget = { size = { 133 238 } datacontext = "[Scope.Char]" WJ_dd_officer_card = {} } }
   }
  } }
 }
