types WJMilitaryTransferTypes {
 type WJ_mt_entries = widget {
  size = { 744 98 }
widget = { position = { 0 0 } size = { 362 98 }
 widget = { position = { 0 0 } size = { 64 92 }
 text_single = { size = { 64 22 } text = WJ_mt_source_label align = center fontsize = 14 }
 portrait_head_small = { position = { 4 27 } scale = 0.65 datacontext = "[GetPlayer.MakeScope.Var('wj_mt_title_source').Char]"
  blockoverride "coa" {} blockoverride "opinion_box" {} blockoverride "show_portrait_status_icons" { visible = no }
 }
}
 button_standard = { position = { 70 35 } size = { 220 42 } text = WJ_mt_title_label
  enabled = "[GetScriptedGui('WJ_mt_ui_open_title').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  tooltip = "[GetScriptedGui('WJ_mt_ui_open_title').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  onclick = "[GetScriptedGui('WJ_mt_ui_open_title').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
