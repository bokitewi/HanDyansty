 visible = "[GetScriptedGui('WJ_royal_unmarried_hint').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
} } }
}
}
vbox = { layoutpolicy_horizontal = expanding spacing = 8
 text_label_center = { text = WJ_peer_princess_name }
 dynamicgridbox = { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_princesses')]"
