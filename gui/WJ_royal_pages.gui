types WJ_royal_pages_types {
 # Source SanGong.gui: portrait grids, grouped ranks/kin and real character interactions.
 # The independent source window and unrelated political/land-transfer buttons are not imported.
 type WJ_royal_person_card = widget {
  size = { 228 304 } visible = "[And(Character.IsValid, Character.IsAlive)]"
  portrait_shoulders = { position = { 4 0 } size = { 220 180 } blockoverride "highlight_icon" {} blockoverride "opinion_box" {} }
  textbox = { position = { 4 182 } size = { 220 50 } multiline = yes autoresize = no fontsize = 18 fontsize_min = 17
   text = "[Character.Custom('WJ_GetUIName')]" tooltip = "[Character.Custom('WJ_GetUIName')]" default_format = "#high"
  }
  text_single = { position = { 4 234 } size = { 220 26 } text = "[Character.GetAge] · [Character.Custom2('WJ_RelationToViewer', CouncilWindow.GetCharacter)]" fontsize = 14 }
  hbox = { position = { 4 266 } size = { 220 30 } spacing = 2 ignoreinvisible = yes
   block "royal_actions" {
   button_standard = { size = { 48 28 } text = WJ_royal_action_CeLi_taizi_interaction
    visible = "[Character.IsPlayerInteractionShown('CeLi_taizi_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('CeLi_taizi_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('CeLi_taizi_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('CeLi_taizi_interaction')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_FeiChu_taizi_interaction
    visible = "[Character.IsPlayerInteractionShown('FeiChu_taizi_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('FeiChu_taizi_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('FeiChu_taizi_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('FeiChu_taizi_interaction')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_SanGong_CeliHuanghou_interaction
    visible = "[Character.IsPlayerInteractionShown('SanGong_CeliHuanghou_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('SanGong_CeliHuanghou_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('SanGong_CeliHuanghou_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('SanGong_CeliHuanghou_interaction')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_SanGong_divorce_character_interaction
    visible = "[Character.IsPlayerInteractionShown('SanGong_divorce_character_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('SanGong_divorce_character_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('SanGong_divorce_character_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('SanGong_divorce_character_interaction')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_WJ_harem_rank_interaction
    visible = "[Character.IsPlayerInteractionShown('WJ_harem_rank_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('WJ_harem_rank_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('WJ_harem_rank_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('WJ_harem_rank_interaction')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_QianSan_chuGong_interaction
    visible = "[Character.IsPlayerInteractionShown('QianSan_chuGong_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('QianSan_chuGong_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('QianSan_chuGong_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('QianSan_chuGong_interaction')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_SanGong_ShiQin
    visible = "[Character.IsPlayerInteractionShown('SanGong_ShiQin')]"
    enabled = "[Character.IsPlayerInteractionValid('SanGong_ShiQin')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('SanGong_ShiQin')]"
    onclick = "[Character.OpenPlayerInteraction('SanGong_ShiQin')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_WJ_peer_grant_interaction
    visible = "[Character.IsPlayerInteractionShown('WJ_peer_grant_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('WJ_peer_grant_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('WJ_peer_grant_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('WJ_peer_grant_interaction')]"
   }
button_standard = { size = { 48 28 } text = WJ_royal_action_WJ_peer_revoke_interaction
    visible = "[Character.IsPlayerInteractionShown('WJ_peer_revoke_interaction')]"
    enabled = "[Character.IsPlayerInteractionValid('WJ_peer_revoke_interaction')]"
    tooltip = "[Character.GetPlayerInteractionTooltip('WJ_peer_revoke_interaction')]"
    onclick = "[Character.OpenPlayerInteraction('WJ_peer_revoke_interaction')]"
   }
  }
 }
 }
 type WJ_royal_pages_body = widget {
 size = { 1408 606 }
widget = { size = { 1408 606 } visible = "[GetVariableSystem.HasValue('WJ_baiguan_page', 'east_palace')]"
 button_standard = { position = { 1250 0 } size = { 150 30 } text = WJ_royal_refresh
 onclick = "[GetScriptedGui('WJ_royal_pages_refresh').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
}
 scrollbox = { position = { 0 38 } size = { 1408 568 }
 blockoverride "scrollbox_content" { vbox = { layoutpolicy_horizontal = expanding spacing = 12
vbox = { layoutpolicy_horizontal = expanding spacing = 8
 text_label_center = { text = WJ_royal_group_heir }
 dynamicgridbox = { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_heir')]"
 datamodel_wrap = 1 layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
 item = { WJ_royal_person_card = { datacontext = "[Scope.GetCharacter]"  } }
}
}vbox = { layoutpolicy_horizontal = expanding spacing = 8
 text_label_center = { text = WJ_royal_group_heir_spouses }
 dynamicgridbox = { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_heir_spouses')]"
 datamodel_wrap = 5 layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
 item = { WJ_royal_person_card = { datacontext = "[Scope.GetCharacter]"  } }
}
}vbox = { layoutpolicy_horizontal = expanding spacing = 8
 text_label_center = { text = WJ_royal_group_heir_children }
 dynamicgridbox = { datamodel = "[CouncilWindow.GetCharacter.MakeScope.GetList('wj_roster_heir_children')]"
 datamodel_wrap = 5 layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
 item = { WJ_royal_person_card = { datacontext = "[Scope.GetCharacter]"  } }
}
}
 } }
}
}
