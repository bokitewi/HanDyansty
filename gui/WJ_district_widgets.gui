# Native contract interactions and vanilla diplomacy/war primitives.
types WJDistrictWidgets {
 type WJ_dd_status_checkbox = button_checkbox_label {
  size = { 72 32 }
  block "contract_actions" {
   enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), And(Character.IsPlayerInteractionShown(Select_CString(GetScriptedGui('WJ_mt_ui_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'wj_dd_adjust_jie_interaction', 'admin_liege_modify_vassal_contract_interaction')), Character.IsPlayerInteractionValid(Select_CString(GetScriptedGui('WJ_mt_ui_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'wj_dd_adjust_jie_interaction', 'admin_liege_modify_vassal_contract_interaction'))))]"
   onclick = "[Character.OpenPlayerInteraction(Select_CString(GetScriptedGui('WJ_mt_ui_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'wj_dd_adjust_jie_interaction', 'admin_liege_modify_vassal_contract_interaction'))]"
   tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip(Select_CString(GetScriptedGui('WJ_mt_ui_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'wj_dd_adjust_jie_interaction', 'admin_liege_modify_vassal_contract_interaction')), Localize('WJ_zw_takeover_notice'))]"
  }
 }
 type WJ_dd_status_self_checkbox = WJ_dd_status_checkbox {
  blockoverride "contract_actions" {
   enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), And(Character.GetLiege.IsPlayerInteractionShown('admin_vassal_modify_vassal_contract_interaction'), Character.GetLiege.IsPlayerInteractionValid('admin_vassal_modify_vassal_contract_interaction')))]"
   onclick = "[Character.GetLiege.OpenPlayerInteraction('admin_vassal_modify_vassal_contract_interaction')]"
   tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetLiege.GetPlayerInteractionTooltip('admin_vassal_modify_vassal_contract_interaction'), Localize('WJ_zw_takeover_notice'))]"
  }
 }
 type WJ_dd_vertical_separator = widget {
  size = { 10 30 }
  icon = { parentanchor = center size = { 1 26 } texture = "gfx/interface/colors/white.dds" color = { 0.6 0.5 0.3 0.7 } alwaystransparent = yes }
 }
 type WJ_dd_contract_liege_strip = hbox {
  spacing = 0
  visible = "[Or(Not(ObjectsEqual(Character.Self, GetPlayer)), GetScriptedGui('WJ_mt_ui_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
  WJ_dd_status_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_jiajie').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_jiajie default_format = "" }
  }
  WJ_dd_status_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_chijie').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_chijie default_format = "" }
  }
  WJ_dd_status_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_shichijie').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_shichijie default_format = "" }
  }
  WJ_dd_vertical_separator = {}
  WJ_dd_status_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_kaifu').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_kaifu default_format = "" }
  }
 }
 type WJ_dd_contract_self_strip = hbox {
  spacing = 0
  visible = "[And(ObjectsEqual(Character.Self, GetPlayer), Not(GetScriptedGui('WJ_mt_ui_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
  WJ_dd_status_self_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_jiajie').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_jiajie default_format = "" }
  }
  WJ_dd_status_self_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_chijie').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_chijie default_format = "" }
  }
  WJ_dd_status_self_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_shichijie').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_shichijie default_format = "" }
  }
  WJ_dd_vertical_separator = {}
  WJ_dd_status_self_checkbox = {
   blockoverride "checkbox" { checked = "[GetScriptedGui('WJ_dd_ui_kaifu').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" }
   blockoverride "text" { text = WJ_dd_ui_kaifu default_format = "" }
  }
 }
 type WJ_dd_officer_card = vbox {
  size = { 125 238 } spacing = 3
  background = { using = Background_Area_Dark }
  text_multi = { layoutpolicy_horizontal = expanding size = { 125 36 } text = "[Character.Custom('WJ_GetUIName')]" align = center fontsize = 14 autoresize = no }
  portrait_shoulders = { size = { 125 160 } }
  block "officer_actions" {
   widget = { size = { 125 32 } WJ_mt_menu_button = { parentanchor = center } }
  }
 }
 type WJ_dd_war_attack_icon = button_standard_hover {
  size = { 48 60 }
  datacontext = "[Scope.War]"
  visible = "[War.IsValid]"
  onclick = "[LedgerWindow.OpenWarOverview(War.Self)]"
  tooltip = WJ_dd_ui_attack_war_tooltip
  coa_realm_small = {
   datacontext = "[War.GetActiveCasusBelli.GetDefender]" parentanchor = center scale = 0.7 alwaystransparent = yes
   blockoverride "coa_button" { button_ignore = both alwaystransparent = yes }
   blockoverride "coa_realm_mouse_entry" {}
  }
  text_single = { parentanchor = bottom|hcenter text = WJ_dd_ui_attack_score fontsize = 13 alwaystransparent = yes }
 }
 type WJ_dd_war_defence_icon = button_standard_hover {
  size = { 48 60 }
  datacontext = "[Scope.War]"
  visible = "[War.IsValid]"
  onclick = "[LedgerWindow.OpenWarOverview(War.Self)]"
  tooltip = WJ_dd_ui_defend_war_tooltip
  coa_realm_small = {
   datacontext = "[War.GetActiveCasusBelli.GetAttacker]" parentanchor = center scale = 0.7 alwaystransparent = yes
   blockoverride "coa_button" { button_ignore = both alwaystransparent = yes }
   blockoverride "coa_realm_mouse_entry" {}
  }
  text_single = { parentanchor = bottom|hcenter text = WJ_dd_ui_defend_score fontsize = 13 alwaystransparent = yes }
 }
 type WJ_dd_war_side_icon = widget {
  size = { 48 60 }
  datacontext = "[Scope.War]"
  WJ_dd_war_attack_icon = {
   visible = "[And(War.IsValid, GetScriptedGui('WJ_dd_war_officer_is_attacker').IsShown(GuiScope.SetRoot(Character.MakeScope).AddScope('war', War.MakeScope).End))]"
  }
  WJ_dd_war_defence_icon = {
   visible = "[And(War.IsValid, Not(GetScriptedGui('WJ_dd_war_officer_is_attacker').IsShown(GuiScope.SetRoot(Character.MakeScope).AddScope('war', War.MakeScope).End)))]"
  }
 }
}
