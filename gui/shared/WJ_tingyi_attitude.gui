 }
 type WJ_ty_attitude_breakdown_tooltip = widget {
  using = GeneralTooltipSetup using = DefaultTooltipBackground alwaystransparent = no
  vbox = {
   set_parent_size_to_minimum = yes margin = { 8 8 } spacing = 2 ignoreinvisible = yes
   hbox = {
    name = "heading" layoutpolicy_horizontal = expanding margin = { 8 8 } spacing = 6
    background = { using = Background_Area }
    text_single = {
     using = Font_Size_Medium align = nobaseline fonttintcolor = "[TooltipInfo.GetTintColor]"
     block "header_text" {}
    }
    text_single = {
     background = {
      texture = "gfx/interface/component_tiles/solid_black_label.dds"
      spritetype = Corneredtiled spriteborder = { 20 20 } texture_density = 2 margin = { 3 1 }
     }
     align = nobaseline default_format = "#true_white" using = Font_Size_Medium
     block "attitude_summary" {}
    }
    expand = {}
   }
   text_single = {
    visible = "[And(Not(EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_mode'), '(CFixedPoint)0')), Not(EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_mode'), '(CFixedPoint)3')))]"
    text = WJ_ty_row_forced margin = { 8 0 } align = left|nobaseline layoutpolicy_horizontal = expanding fonttintcolor = "[TooltipInfo.GetTintColor]"
   }
   vbox = {
    size = { 0 0 } minimumsize = { 0 0 } layoutpolicy_vertical = shrinking layoutpolicy_horizontal = expanding
    visible = "[Or(EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_mode'), '(CFixedPoint)0'), EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_mode'), '(CFixedPoint)3'))]"
    margin = { 8 0 } spacing = 0 ignoreinvisible = yes

    vbox = {
     size = { 0 0 } minimumsize = { 0 0 } layoutpolicy_vertical = shrinking layoutpolicy_horizontal = expanding spacing = 0 ignoreinvisible = yes
     datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_observer', TopScope.sCharacter('wj_ty_observer').MakeScope).AddScope('wj_ty_row_section', MakeScopeValue('(CFixedPoint)1'))]"
     block "proposer_visible" { }
     hbox = {
      layoutpolicy_horizontal = expanding spacing = 6 margin = { 4 4 } margin_top = 4
      background = { using = Background_Area }
      text_single = { text = WJ_ty_section_proposer using = Font_Size_Medium default_format = "#bold" align = left|nobaseline max_width = 400 }
      text_single = { using = Font_Size_Medium default_format = "#true_white" align = left|nobaseline block "proposer_summary" { } }
      expand = {}
     }
vbox = { size = { 0 0 } minimumsize = { 0 0 } layoutpolicy_vertical = shrinking visible = "[And(GetPlayer.MakeScope.Var('wj_ty_proposer').Char.IsValid, Not(EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_activity'), '(CFixedPoint)0')))]" layoutpolicy_horizontal = expanding ignoreinvisible = yes spacing = 0
     datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_observer', TopScope.sCharacter('wj_ty_observer').MakeScope).AddScope('wj_ty_detail_subject', GetPlayer.MakeScope.Var('wj_ty_proposer').Char.MakeScope).AddScope('wj_ty_row_group', MakeScopeValue('(CFixedPoint)1'))]"
     WJ_ty_social_rows = {}
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_controlled'))]" blockoverride "row_label" { text = WJ_ty_row_controlled } }
    }
vbox = { size = { 0 0 } minimumsize = { 0 0 } layoutpolicy_vertical = shrinking visible = "[And(TopScope.sCharacter('wj_ty_observer').IsValid, Not(EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_activity'), '(CFixedPoint)0')))]" layoutpolicy_horizontal = expanding ignoreinvisible = yes spacing = 0
     datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_observer', TopScope.sCharacter('wj_ty_observer').MakeScope).AddScope('wj_ty_detail_subject', TopScope.sCharacter('wj_ty_observer').MakeScope).AddScope('wj_ty_row_group', MakeScopeValue('(CFixedPoint)9'))]"
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_support'))]" blockoverride "row_label" { text = WJ_ty_row_support } }
    }
    }
    vbox = {
     size = { 0 0 } minimumsize = { 0 0 } layoutpolicy_vertical = shrinking layoutpolicy_horizontal = expanding spacing = 0 ignoreinvisible = yes
     datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_observer', TopScope.sCharacter('wj_ty_observer').MakeScope).AddScope('wj_ty_row_section', MakeScopeValue('(CFixedPoint)2'))]"
     block "issue_visible" { }
     divider_light = { size = { 100% 1 } margin = { 0 5 } layoutpolicy_horizontal = expanding alwaystransparent = yes }
     hbox = {
      layoutpolicy_horizontal = expanding spacing = 6 margin = { 4 4 } margin_top = 4
      background = { using = Background_Area }
      text_single = { text = WJ_ty_section_issue using = Font_Size_Medium default_format = "#bold" align = left|nobaseline max_width = 400 }
      text_single = { using = Font_Size_Medium default_format = "#true_white" align = left|nobaseline block "issue_summary" { } }
      expand = {}
     }
vbox = { size = { 0 0 } minimumsize = { 0 0 } layoutpolicy_vertical = shrinking visible = "[And(GetPlayer.MakeScope.Var('wj_ty_target').Char.IsValid, Not(EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_activity'), '(CFixedPoint)0')))]" layoutpolicy_horizontal = expanding ignoreinvisible = yes spacing = 0
     datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_ty_observer', TopScope.sCharacter('wj_ty_observer').MakeScope).AddScope('wj_ty_detail_subject', GetPlayer.MakeScope.Var('wj_ty_target').Char.MakeScope).AddScope('wj_ty_row_group', MakeScopeValue('(CFixedPoint)2'))]"
