types WJ_tingyi_attitude_types {
 # Rows retain the production projections. Geometry follows character_opinion_tooltip.
 type WJ_ty_attitude_row = hbox {
  size = { 0 0 } minimumsize = { 0 0 }
  layoutpolicy_vertical = shrinking layoutpolicy_horizontal = expanding spacing = 2
  visible = "[Not(EqualTo_CFixedPoint(TopScope.ScriptValue('WJ_ty_row_value'), '(CFixedPoint)0'))]"
  text_single = {
   max_width = 400 align = left|nobaseline using = Font_Size_Small
   fonttintcolor = "[TooltipInfo.GetTintColor]"
   tooltip = WJ_ty_row_source_person
   block "row_label" {}
  }
  text_single = {
   align = left|nobaseline using = Font_Size_Small
   fonttintcolor = "[TooltipInfo.GetTintColor]"
   text = "[TopScope.ScriptValue('WJ_ty_row_value')|=+2]"
  }
  expand = {}
 }
 type WJ_ty_social_rows = vbox {
  size = { 0 0 } minimumsize = { 0 0 } layoutpolicy_vertical = shrinking layoutpolicy_horizontal = expanding spacing = 0 ignoreinvisible = yes
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_opinion'))]" blockoverride "row_label" { text = WJ_ty_row_opinion } }
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_relation_parent'))]" blockoverride "row_label" { text = WJ_ty_row_relation_parent } }
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_relation_child'))]" blockoverride "row_label" { text = WJ_ty_row_relation_child } }
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_relation_sibling'))]" blockoverride "row_label" { text = WJ_ty_row_relation_sibling } }
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_relation_spouse'))]" blockoverride "row_label" { text = WJ_ty_row_relation_spouse } }
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_relation_dynasty'))]" blockoverride "row_label" { text = WJ_ty_row_relation_dynasty } }
     WJ_ty_attitude_row = { datacontext = "[TopScope.AddScope('wj_ty_row_source', MakeScopeFlag('WJ_ty_bd_relation_friend'))]" blockoverride "row_label" { text = WJ_ty_row_relation_friend } }
