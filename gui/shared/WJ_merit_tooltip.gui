# One source for HUD and arbitrary-Character tooltip layout and marker art.
# Native defaults are the original WJ_merit_hud_tooltip; only named data slots differ.
types WJ_merit_shared_types {
	type WJ_merit_level_marker = widget_level_marker {
		block "WJ_marker_visibility" {
			visible = "[And( GreaterThan_int32( ComplexBarItem.GetIndex, '(int32)0' ), And( LessThan_int32( PdxGuiWidget.GetIndexInDataModel, GetDataModelSize( ComplexBar.GetItems ) ), Or( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)1' ), Or( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)3' ), Or( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)5' ), Or( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)7' ), EqualTo_int32( ComplexBarItem.GetIndex, '(int32)9' ) ) ) ) ) ) )]"
		}
		scale = 0.75

		blockoverride "marker_size" {
			size = { 55 55 }
		}

		blockoverride "marker_size_inactive" {
			size = { 45 45 }
		}

		blockoverride "marker_addon" {
			icon = {
				texture = "gfx/interface/colors/white.dds"
				using = Mask_Rough_Edges
				position = { -4 42 }
				size = { 8 23 }
				alpha = 0.3
				block "WJ_marker_tick_visibility" {
					visible = "[GreaterThan_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' )]"
				}
			}

			widget = {
				size = { 52 52 }
				position = { -26 24 }
				block "WJ_marker_lock_visibility" {
					visible = "[Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)1' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)1' ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)3' ), And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)0' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)3' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)5' ), And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)2' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)5' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)7' ), And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)4' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)7' ) ) ), And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)9' ), And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)6' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)9' ) ) ) ) ) ) )]"
				}
				tooltip = "WJ_merit_cap_tooltip_hanjin"

				icon = {
					size = { 100% 100% }
					texture = "gfx/interface/window_legend_chronicle/pin_under_expected_legitimacy.dds"
				}

				icon_flat_standard_red = {
					parentanchor = center
					size = { 26 26 }
					texture = "gfx/interface/icons/domicile_building/domicile_lock_wagons.dds"
				}
			}
		}

		blockoverride "visible_active" {
			visible = "[Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)1' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)1' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)2' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)3' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)3' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)4' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)5' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)5' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)6' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)7' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)7' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)8' ) ) ), And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)9' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)9' ) ) ) ) ) )]"
		}

		blockoverride "level_inactive_style" {
			datacontext = "[ComplexBarItem]"
			allow_outside = yes
			datacontext_from_model = {
				datamodel = "[MeritItem.GetLevels]"
				index = "[PdxGuiWidget.GetIndexInDataModel]"
			}
			modify_texture = {
				visible = "[GreaterThan_int32( ComplexBarItem.GetIndex, PlayerValueItem.GetMaxLevelIndex( Character.Self ) )]"
				texture = "gfx/interface/colors/black.dds"
				blend_mode = multiply
				alpha = 0.1
			}
		}

		blockoverride "visible_inactive" {
			visible = "[Not( Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)1' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)1' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)2' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)3' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)3' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)4' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)5' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)5' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)6' ) ) ), Or( And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)7' ), Or( EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)7' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)8' ) ) ), And( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)9' ), EqualTo_int32( MeritItem.GetCurrentLevel, '(int32)9' ) ) ) ) ) ) )]"
		}

		blockoverride "marker_tooltip" {
			datacontext = "[ComplexBarItem]"
			datacontext_from_model = {
				datamodel = "[MeritItem.GetLevels]"
				index = "[PdxGuiWidget.GetIndexInDataModel]"
			}
			tooltip = "WJ_XIANWANG_PROGRESSBAR_MARKER_TOOLTIP"
			using = tooltip_se
		}

		blockoverride "marker_text" {
			text = "[SelectLocalization( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)1' ), 'WJ_XIANWANG_NODE_XIAN', SelectLocalization( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)3' ), 'WJ_XIANWANG_NODE_JUN', SelectLocalization( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)5' ), 'WJ_XIANWANG_NODE_ZHOU', SelectLocalization( EqualTo_int32( ComplexBarItem.GetIndex, '(int32)7' ), 'WJ_XIANWANG_NODE_CHAO', 'WJ_XIANWANG_NODE_GONG' ) ) ) )]"
		}
	}

	type WJ_merit_tooltip_base = object_tooltip_pop_out {
		block "WJ_merit_data" {
			datacontext = "[MeritItem.GetValueItem]"
			datacontext = "[MeritItem.GetComplexBar]"
		}
		visible = "[Character.HasMerit]"

		blockoverride "title_text"
		{
			text = "[Character.Custom('WJ_BandWord')]"
			default_format = "#T"
		}

		blockoverride "concept_link"
		{
			text = "[wj_luyi|E]"
		}

		blockoverride "subheading"
		{
			text_single = {
				max_width = 400
				layoutpolicy_horizontal = expanding
				text = "[Character.GetCareerPathDesc]"
				fonttintcolor = "[TooltipInfo.GetTintColor]"
				using = Font_Size_Small
				fontsize_min = 14
				autoresize = yes
				default_format = "#weak_glow"
			}
		}

		blockoverride "header_additions"
		{
			widget = {
				size = { 60 74 }
				WJ_luzhi_badge = {
					size = { 64 64 }
					parentanchor = center
					position = { -8 0 }
				}
			}
		}

		blockoverride "main_description"
		{
			vbox = {
				layoutpolicy_horizontal = expanding
				margin_right = 5
				spacing = 16

				### 当前禄秩
				text_label_left = {
					layoutpolicy_horizontal = expanding
					text = "WJ_LUZHI_CURRENT_HEADING"
				}
				cooltip_paragraph = {
					max_width = 500
					block "WJ_merit_rank_description" {
						text = "WJ_LUZHI_CURRENT_DESC"
					}
				}

				### 当前贤望；等级效果与任官资格均继续读取原版 merit
				text_label_left = {
					layoutpolicy_horizontal = expanding
					text = "WJ_XIANWANG_CURRENT_WITH_TITLE"
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					cooltip_paragraph = {
						visible = "[Not( StringIsEmpty( GetMeritLevelEffects( Character.GetMeritLevel ) ) )]"
						max_width = 500
						text = "[GetMeritLevelEffects( Character.GetMeritLevel )]"
					}

					cooltip_paragraph = {
						visible = "[Character.ShouldShowMovementPower]"
						max_width = 500
						text = "MERIT_MOVEMENT_POWER"
					}

					cooltip_paragraph = {
						max_width = 500
						name = "merit_appointment"
						layoutpolicy_horizontal = expanding
						text = "[Character.Custom('WJ_XianwangAppointment')]"
					}
				}

				### 原版九品数据与进度条；汉制只将可见节点归并为县、郡、州、卿、公五等。
				text_label_left = {
					layoutpolicy_horizontal = expanding
					block "WJ_merit_progress_heading" {
						text = "WJ_XIANWANG_PROGRESS_HEADING"
					}
				}
				widget = {
					name = "WJ_xianwang_progress"
					layoutpolicy_horizontal = expanding
					size = { 500 50 }
					allow_outside = yes

					block "WJ_merit_progress_content" {
						WJ_merit_complex_bar_progress = {
							layoutpolicy_horizontal = expanding
							margin_top = 30
							margin_right = 16
							margin_left = 5
						}

						hbox_complex_bar_levels = {
							layoutpolicy_horizontal = expanding
							position = { 0 -10 }
							margin_right = 16
							blockoverride "marker" {
								WJ_merit_level_marker = {}
							}
						}
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 12
					text_single = {
						text = "WJ_TOTAL_XIANWANG"
						align = nobaseline
					}
					block "WJ_merit_balance" {
						text_single = {
							datacontext = "[PlayerValueItem.GetBalanceGained]"
							text = "[Character.GetMeritBalanceBreakdown]"
							align = nobaseline
							tooltip_visible = "[ValueBreakdown.HasTooltip]"
							tooltipwidget = { widget_value_breakdown_tooltip = { } }
						}
					}
					expand = {}
					text_single = {
						block "WJ_merit_cap_text" {
							text = "[SelectLocalization( GreaterThan_int32( PlayerValueItem.GetMaxLevelIndex( Character.Self ), '(int32)8' ), 'WJ_CURRENT_ZIWANG_CAP_GONG', SelectLocalization( GreaterThan_int32( PlayerValueItem.GetMaxLevelIndex( Character.Self ), '(int32)6' ), 'WJ_CURRENT_ZIWANG_CAP_CHAO', SelectLocalization( GreaterThan_int32( PlayerValueItem.GetMaxLevelIndex( Character.Self ), '(int32)4' ), 'WJ_CURRENT_ZIWANG_CAP_ZHOU', SelectLocalization( GreaterThan_int32( PlayerValueItem.GetMaxLevelIndex( Character.Self ), '(int32)2' ), 'WJ_CURRENT_ZIWANG_CAP_JUN', 'WJ_CURRENT_ZIWANG_CAP_XIAN' ) ) ) )]"
						}
						align = nobaseline
					}
				}

				### 入仕之门
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5

					text_label_left = {
						layoutpolicy_horizontal = expanding
						text = "[wj_ruzhi|E]"
					}

					hbox = {
						datacontext = "[Character.MakeScope]"
						spacing = 50

						WJ_widget_road_bizhao_status = {}

						WJ_widget_road_xiaolian_status = {}

						WJ_widget_road_maocai_status = {}
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "WJ_exams_disclaimer_hanjin"
						default_format = "#weak"
					}
				}

			}
		}
	}
}
