# Caller supplies the actual Character. HUD and Tingyi inherit the same layout/art.
# No Character -> MeritItem factory is exported (logs/data_types, 2026-11-01).
# This adapter uses a linear 0..GetMeritLevelThreshold(9) axis, not ComplexBar's
# undisclosed widths or capped/overflow stretch factors. Raw merit is clamped only
# for drawing; actual rank and the first blocked band use Character's real values.
# Monthly CString remains visible; no fabricated ValueBreakdown/overflow segment.
# Node tooltip text is the complete HUD localization with a literal level index.
# Check: node gui/shared/WJ_merit_tooltip.check.cjs
types WJ_ty_merit_types {
	type WJ_ty_character_merit_tooltip = WJ_merit_tooltip_base {
		blockoverride "WJ_merit_data" {}
		blockoverride "WJ_merit_rank_description" { text = "[Character.Custom('WJ_ty_LuzhiCurrentDesc')]" }
		blockoverride "WJ_merit_progress_heading" { text = "WJ_XIANWANG_PROGRESS_HEADING" }
		blockoverride "WJ_merit_progress_content" {
			# Match the native bar's margins. Both fill and markers share this exact axis.
			widget = {
				name = "WJ_ty_merit_fill_axis"
				position = { 5 30 }
				size = { 479 20 }
			progressbar_standard = {
				name = "WJ_ty_merit_total_progress"
				tooltip = "[Character.GetTotalMerit]"
				size = { 100% 100% }
				blockoverride "progress_textures" {
					progresstexture = "gfx/interface/progressbars/progress_standard.dds"
					noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
				}
				value = "[Multiply_CFixedPoint( '(CFixedPoint)100', Divide_CFixedPoint( Min_CFixedPoint( Max_CFixedPoint( Character.GetMerit, '(CFixedPoint)0' ), GetMeritLevelThreshold( '(int32)9' ) ), Max_CFixedPoint( GetMeritLevelThreshold( '(int32)9' ), '(CFixedPoint)1' ) ) )]"
			}
			}
			hbox = {
				name = "WJ_ty_merit_threshold_nodes"
				layoutpolicy_horizontal = expanding
				allow_outside = yes
				spacing = 0
				position = { 0 -10 }
				margin_left = 5
				margin_right = 16
				expand = { layoutstretchfactor_horizontal = "[FixedPointToInt( GetMeritLevelThreshold( '(int32)1' ) )]" }
				widget = {
					name = "WJ_ty_merit_node_1"
					size = { 0 40 }
					allow_outside = yes
					WJ_merit_level_marker = {
						blockoverride "WJ_marker_visibility" {}
						blockoverride "WJ_marker_tick_visibility" {}
						blockoverride "WJ_marker_lock_visibility" { visible = "[LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)1' )]" }
						blockoverride "visible_active" { visible = "[Or( EqualTo_int32( Character.GetMeritLevel, '(int32)1' ), EqualTo_int32( Character.GetMeritLevel, '(int32)2' ) )]" }
						blockoverride "visible_inactive" { visible = "[Not( Or( EqualTo_int32( Character.GetMeritLevel, '(int32)1' ), EqualTo_int32( Character.GetMeritLevel, '(int32)2' ) ) )]" }
						blockoverride "level_inactive_style" {
							allow_outside = yes
							modify_texture = {
								visible = "[GreaterThan_int32( '(int32)1', Character.GetMaxMeritLevelForCharacter )]"
								texture = "gfx/interface/colors/black.dds"
								blend_mode = multiply
								alpha = 0.1
							}
						}
						blockoverride "marker_tooltip" {
							tooltip = "WJ_ty_merit_node_1_tt"
							using = tooltip_se
						}
						blockoverride "marker_text" { size = { 40 40 } autoresize = no align = center allow_outside = yes text = "WJ_XIANWANG_NODE_XIAN" }
					}
				}
				expand = { layoutstretchfactor_horizontal = "[FixedPointToInt( Subtract_CFixedPoint( GetMeritLevelThreshold( '(int32)3' ), GetMeritLevelThreshold( '(int32)1' ) ) )]" }
				widget = {
					name = "WJ_ty_merit_node_3"
					size = { 0 40 }
					allow_outside = yes
					WJ_merit_level_marker = {
						blockoverride "WJ_marker_visibility" {}
						blockoverride "WJ_marker_tick_visibility" {}
						blockoverride "WJ_marker_lock_visibility" { visible = "[And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)0' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)3' ) )]" }
						blockoverride "visible_active" { visible = "[Or( EqualTo_int32( Character.GetMeritLevel, '(int32)3' ), EqualTo_int32( Character.GetMeritLevel, '(int32)4' ) )]" }
						blockoverride "visible_inactive" { visible = "[Not( Or( EqualTo_int32( Character.GetMeritLevel, '(int32)3' ), EqualTo_int32( Character.GetMeritLevel, '(int32)4' ) ) )]" }
						blockoverride "level_inactive_style" {
							allow_outside = yes
							modify_texture = {
								visible = "[GreaterThan_int32( '(int32)3', Character.GetMaxMeritLevelForCharacter )]"
								texture = "gfx/interface/colors/black.dds"
								blend_mode = multiply
								alpha = 0.1
							}
						}
						blockoverride "marker_tooltip" {
							tooltip = "WJ_ty_merit_node_3_tt"
							using = tooltip_se
						}
						blockoverride "marker_text" { size = { 40 40 } autoresize = no align = center allow_outside = yes text = "WJ_XIANWANG_NODE_JUN" }
					}
				}
				expand = { layoutstretchfactor_horizontal = "[FixedPointToInt( Subtract_CFixedPoint( GetMeritLevelThreshold( '(int32)5' ), GetMeritLevelThreshold( '(int32)3' ) ) )]" }
				widget = {
					name = "WJ_ty_merit_node_5"
					size = { 0 40 }
					allow_outside = yes
					WJ_merit_level_marker = {
						blockoverride "WJ_marker_visibility" {}
						blockoverride "WJ_marker_tick_visibility" {}
						blockoverride "WJ_marker_lock_visibility" { visible = "[And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)2' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)5' ) )]" }
						blockoverride "visible_active" { visible = "[Or( EqualTo_int32( Character.GetMeritLevel, '(int32)5' ), EqualTo_int32( Character.GetMeritLevel, '(int32)6' ) )]" }
						blockoverride "visible_inactive" { visible = "[Not( Or( EqualTo_int32( Character.GetMeritLevel, '(int32)5' ), EqualTo_int32( Character.GetMeritLevel, '(int32)6' ) ) )]" }
						blockoverride "level_inactive_style" {
							allow_outside = yes
							modify_texture = {
								visible = "[GreaterThan_int32( '(int32)5', Character.GetMaxMeritLevelForCharacter )]"
								texture = "gfx/interface/colors/black.dds"
								blend_mode = multiply
								alpha = 0.1
							}
						}
						blockoverride "marker_tooltip" {
							tooltip = "WJ_ty_merit_node_5_tt"
							using = tooltip_se
						}
						blockoverride "marker_text" { size = { 40 40 } autoresize = no align = center allow_outside = yes text = "WJ_XIANWANG_NODE_ZHOU" }
					}
				}
				expand = { layoutstretchfactor_horizontal = "[FixedPointToInt( Subtract_CFixedPoint( GetMeritLevelThreshold( '(int32)7' ), GetMeritLevelThreshold( '(int32)5' ) ) )]" }
				widget = {
					name = "WJ_ty_merit_node_7"
					size = { 0 40 }
					allow_outside = yes
					WJ_merit_level_marker = {
						blockoverride "WJ_marker_visibility" {}
						blockoverride "WJ_marker_tick_visibility" {}
						blockoverride "WJ_marker_lock_visibility" { visible = "[And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)4' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)7' ) )]" }
						blockoverride "visible_active" { visible = "[Or( EqualTo_int32( Character.GetMeritLevel, '(int32)7' ), EqualTo_int32( Character.GetMeritLevel, '(int32)8' ) )]" }
						blockoverride "visible_inactive" { visible = "[Not( Or( EqualTo_int32( Character.GetMeritLevel, '(int32)7' ), EqualTo_int32( Character.GetMeritLevel, '(int32)8' ) ) )]" }
						blockoverride "level_inactive_style" {
							allow_outside = yes
							modify_texture = {
								visible = "[GreaterThan_int32( '(int32)7', Character.GetMaxMeritLevelForCharacter )]"
								texture = "gfx/interface/colors/black.dds"
								blend_mode = multiply
								alpha = 0.1
							}
						}
						blockoverride "marker_tooltip" {
							tooltip = "WJ_ty_merit_node_7_tt"
							using = tooltip_se
						}
						blockoverride "marker_text" { size = { 40 40 } autoresize = no align = center allow_outside = yes text = "WJ_XIANWANG_NODE_CHAO" }
					}
				}
				expand = { layoutstretchfactor_horizontal = "[FixedPointToInt( Subtract_CFixedPoint( GetMeritLevelThreshold( '(int32)9' ), GetMeritLevelThreshold( '(int32)7' ) ) )]" }
				widget = {
					name = "WJ_ty_merit_node_9"
					size = { 0 40 }
					allow_outside = yes
					WJ_merit_level_marker = {
						blockoverride "WJ_marker_visibility" {}
						blockoverride "WJ_marker_tick_visibility" {}
						blockoverride "WJ_marker_lock_visibility" { visible = "[And( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)6' ), LessThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)9' ) )]" }
						blockoverride "visible_active" { visible = "[EqualTo_int32( Character.GetMeritLevel, '(int32)9' )]" }
						blockoverride "visible_inactive" { visible = "[Not( EqualTo_int32( Character.GetMeritLevel, '(int32)9' ) )]" }
						blockoverride "level_inactive_style" {
							allow_outside = yes
							modify_texture = {
								visible = "[GreaterThan_int32( '(int32)9', Character.GetMaxMeritLevelForCharacter )]"
								texture = "gfx/interface/colors/black.dds"
								blend_mode = multiply
								alpha = 0.1
							}
						}
						blockoverride "marker_tooltip" {
							tooltip = "WJ_ty_merit_node_9_tt"
							using = tooltip_se
						}
						blockoverride "marker_text" { size = { 40 40 } autoresize = no align = center allow_outside = yes text = "WJ_XIANWANG_NODE_GONG" }
					}
				}
			}
		}
		blockoverride "WJ_merit_balance" {
			text_single = {
				text = "[Character.GetMeritBalanceBreakdown]"
				align = nobaseline
			}
		}
		blockoverride "WJ_merit_cap_text" {
			text = "[SelectLocalization( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)8' ), 'WJ_CURRENT_ZIWANG_CAP_GONG', SelectLocalization( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)6' ), 'WJ_CURRENT_ZIWANG_CAP_CHAO', SelectLocalization( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)4' ), 'WJ_CURRENT_ZIWANG_CAP_ZHOU', SelectLocalization( GreaterThan_int32( Character.GetMaxMeritLevelForCharacter, '(int32)2' ), 'WJ_CURRENT_ZIWANG_CAP_JUN', 'WJ_CURRENT_ZIWANG_CAP_XIAN' ) ) ) )]"
		}
	}
}
