    "housing": {
      "allowed_sources": [
        "F:\\开源建筑\\chinese_city",
        "F:\\开源建筑\\chinese_spwal"
      ],
      "placement": "randomly instance only inside housing_yellow mask; exclude roads, water, walls, gates, palace, barracks, monastery; do not alter source meshes/materials/textures"
    },
    "walls": {
      "allowed_source": "F:\\开源建筑\\chinese_wall",
      "placement": "repeat native wall pieces along black wall strokes; do not stretch or deform source mesh"
    },
    "gates": {
      "allowed_source": "F:\\开源建筑\\chinese_well",
      "placement": "use existing gate/wall parts at blue gate marks; align to local wall tangent; replace overlapping wall segment instead of stacking"
    },
    "palace": {
      "allowed_source": "mod asset: hd_imperial_palace_palcehold",
      "placement": "instance at deep-purple palace zones; the upper palace already includes its own walls, so do not recreate the erroneous black enclosure around it"
    },
    "barracks": {
      "allowed_source": "vanilla asset: barracks_chinese_unique",
      "placement": "instance at red zones only"
    },
    "monastery": {
      "allowed_source": "vanilla asset: monastery_chinese_unique",
      "placement": "instance at purple zones only"
    },
    "water": {
      "meaning": "river/lake reservation mask",
      "placement": "no buildings/walls may occupy water mask unless the user's existing terrain/water system explicitly requires it; no new water mesh is authorized by this manifest"
    },
    "roads": {
      "meaning": "road network / clearance corridors",
      "placement": "keep roads clear of residences and other structures; no new road mesh is authorized by this manifest"
    }
  },
  "non_destructive_rules": [
    "No source mesh topology edits",
    "No source material edits",
    "No source texture edits",
    "No substitute/proxy geometry in final output",
    "No unlisted model family may be introduced",
    "Use instancing/translation/rotation only unless the user separately authorizes scaling",
    "If a required asset cannot be resolved, stop that category instead of fabricating a replacement"
  ],
