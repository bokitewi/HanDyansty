# Native evidence: interaction_court_task.gui portraits/list art;
# interaction_templates.gui OptionItem bindings; DataModelFirst/SkipFirst are
# native GUI helpers. No CourtTaskInteractionWindow context or new court jobs.
types WJ_mufu_recruit_types {
 type WJ_mufu_recruit_scene = hbox {
  layoutpolicy_horizontal = expanding
  size = { 0 160 }
  margin = { 25 5 }
  background = {
   texture = "gfx/interface/illustrations/event_scenes/councilchamber.dds"
   alpha = 0.5
   fittype = centercrop
   using = Mask_Rough_Edges
  }
  portrait_shoulders = {
   datacontext = "[CharacterInteractionConfirmationWindow.GetActor]"
   visible = "[Character.IsValid]"
   tooltip_visible = "[Character.IsValid]"
  }
  vbox = {
   layoutpolicy_horizontal = expanding
   layoutpolicy_vertical = expanding
   text_multi = {
    text = "WJ_mufu_options"
    autoresize = yes
    max_width = 260
    align = center|nobaseline
    background = { using = Text_Label_Background }
   }
   expand = {}
  }
  portrait_shoulders = {
   datacontext = "[CharacterInteractionConfirmationWindow.GetRecipient]"
   visible = "[Character.IsValid]"
   tooltip_visible = "[Character.IsValid]"
   blockoverride "portrait_transformation" {
    portrait_scale = { -1 1 }
    portrait_offset = { 1 0 }
   }
  }
 }
 type WJ_bizhao_role_button = button_standard_clean {
  layoutpolicy_horizontal = expanding
  size = { 480 46 }
  down = "[OptionItem.HasOption]"
  enabled = "[And(OptionItem.IsValid, OptionItem.CanBeChanged)]"
  alwaystransparent = "[OptionItem.HasOption]"
  tooltip = "[OptionItem.GetTooltip]"
  using = tooltip_below
  block "role_click" {
   onclick = "[OptionItem.OnClick]"
  }
  # Native OptionItem stays the selection context; names explicitly use actor.
  # Salary display only. Monthly personal-gold settlement belongs to the backend.
  text_single = {
   parentanchor = right|vcenter
   position = { -16 0 }
   text = "WJ_bizhao_monthly_salary"
   alwaystransparent = yes
  }
  icon = {
   visible = "[OptionItem.HasFlag('mufu_role_1')]"
   parentanchor = left|vcenter
   position = { 12 0 }
   size = { 32 32 }
   texture = "gfx/interface/icons/icon_skills.dds"
   framesize = { 60 60 }
   frame = 3
   alwaystransparent = yes
  }
  icon = {
   visible = "[OptionItem.HasFlag('mufu_role_2')]"
   parentanchor = left|vcenter
   position = { 12 0 }
   size = { 32 32 }
   texture = "gfx/interface/icons/icon_skills.dds"
   framesize = { 60 60 }
   frame = 1
   alwaystransparent = yes
  }
  icon = {
   visible = "[OptionItem.HasFlag('mufu_role_3')]"
   parentanchor = left|vcenter
   position = { 12 0 }
   size = { 32 32 }
   texture = "gfx/interface/icons/icon_skills.dds"
   framesize = { 60 60 }
   frame = 4
   alwaystransparent = yes
  }
  icon = {
   visible = "[OptionItem.HasFlag('mufu_role_4')]"
   parentanchor = left|vcenter
   position = { 12 0 }
   size = { 32 32 }
   texture = "gfx/interface/icons/icon_skills.dds"
   framesize = { 60 60 }
   frame = 2
   alwaystransparent = yes
  }
  icon = {
   visible = "[OptionItem.HasFlag('mufu_role_5')]"
   parentanchor = left|vcenter
   position = { 12 0 }
   size = { 32 32 }
   texture = "gfx/interface/icons/icon_skills.dds"
   framesize = { 60 60 }
   frame = 5
   alwaystransparent = yes
  }
  text_single = {
   visible = "[OptionItem.HasFlag('mufu_role_1')]"
   parentanchor = left|vcenter
   position = { 52 0 }
   text = "[CharacterInteractionConfirmationWindow.GetActor.Custom('WJ_mufu_role_1')]"
   alwaystransparent = yes
   using = Font_Size_Medium
  }
  text_single = {
   visible = "[OptionItem.HasFlag('mufu_role_2')]"
   parentanchor = left|vcenter
   position = { 52 0 }
   text = "[CharacterInteractionConfirmationWindow.GetActor.Custom('WJ_mufu_role_2')]"
   alwaystransparent = yes
   using = Font_Size_Medium
  }
  text_single = {
   visible = "[OptionItem.HasFlag('mufu_role_3')]"
   parentanchor = left|vcenter
   position = { 52 0 }
   text = "[CharacterInteractionConfirmationWindow.GetActor.Custom('WJ_mufu_role_3')]"
   alwaystransparent = yes
   using = Font_Size_Medium
  }
  text_single = {
   visible = "[OptionItem.HasFlag('mufu_role_4')]"
   parentanchor = left|vcenter
   position = { 52 0 }
   text = "[CharacterInteractionConfirmationWindow.GetActor.Custom('WJ_mufu_role_4')]"
   alwaystransparent = yes
   using = Font_Size_Medium
  }
  text_single = {
   visible = "[OptionItem.HasFlag('mufu_role_5')]"
   parentanchor = left|vcenter
   position = { 52 0 }
   text = "[CharacterInteractionConfirmationWindow.GetActor.Custom('WJ_mufu_role_5')]"
   alwaystransparent = yes
   using = Font_Size_Medium
  }
 }
 type WJ_mufu_recruit_options = vbox {
  layoutpolicy_horizontal = expanding
  spacing = 5
  # Only these five native flags form the role selector; bribes remain independent.
  vbox = {
   name = "WJ_mufu_role_list"
   layoutpolicy_horizontal = expanding
   spacing = 4
   datamodel = "[DataModelFirst(CharacterInteractionConfirmationWindow.GetOptionItems, '(int32)5')]"
   item = {
    widget = {
     visible = "[OptionItem.IsShown]"
     layoutpolicy_horizontal = expanding
     size = { 480 46 }
     # No selection: just toggle the clicked native OptionItem on.
     WJ_bizhao_role_button = {
      visible = "[Not(Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_1').HasOption, Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_2').HasOption, Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_3').HasOption, Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_4').HasOption, CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_5').HasOption)))))]"
     }
     # Existing selection: both native callbacks run from this click, without state.
     WJ_bizhao_role_button = {
      visible = "[Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_1').HasOption, Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_2').HasOption, Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_3').HasOption, Or(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_4').HasOption, CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_5').HasOption))))]"
      blockoverride "role_click" {
       onclick = "[CharacterInteractionConfirmationWindow.GetOptionItemByFlag(Select_CString(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_1').HasOption, 'mufu_role_1', Select_CString(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_2').HasOption, 'mufu_role_2', Select_CString(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_3').HasOption, 'mufu_role_3', Select_CString(CharacterInteractionConfirmationWindow.GetOptionItemByFlag('mufu_role_4').HasOption, 'mufu_role_4', 'mufu_role_5'))))).OnClick]"
       onclick = "[OptionItem.OnClick]"
      }
     }
    }
   }
  }
  text_label_center = { text = "WJ_mufu_recruit_bribes" margin_top = 5 }
  vbox = {
   name = "WJ_mufu_bribe_list"
   layoutpolicy_horizontal = expanding
   spacing = 2
   datamodel = "[DataModelSkipFirst(CharacterInteractionConfirmationWindow.GetOptionItems, '(int32)5')]"
   item = {
    hbox = {
     visible = "[OptionItem.IsShown]"
     layoutpolicy_horizontal = expanding
     size = { 480 30 }
     alpha = "[Select_float(And(OptionItem.IsValid, OptionItem.CanBeChanged), '(float)1', '(float)0.4')]"
     spacing = 10
     margin = { 15 0 }
     background = { using = Background_Area_Border }
     tooltip = "[OptionItem.GetTooltip]"
     using = tooltip_below
     button_checkbox = {
      size = { 26 26 }
      checked = "[OptionItem.HasOption]"
      onclick = "[OptionItem.OnClick]"
      enabled = "[And(OptionItem.IsValid, OptionItem.CanBeChanged)]"
     }
     text_single = { text = "[OptionItem.GetName]" align = nobaseline }
     expand = {}
    }
   }
  }
 }
}
