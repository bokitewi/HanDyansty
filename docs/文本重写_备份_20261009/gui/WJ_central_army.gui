types WJCentralArmyTypes {
 type WJ_central_army_body = widget {
  size = { 1408 606 }
  widget = {
   name = "central_roster_sync" size = { 0 0 } alwaystransparent = yes
   visible = "[Not(GetScriptedGui('WJ_mt_ui_roster_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
   state = { name = _show on_start = "[GetScriptedGui('WJ_mt_ui_central').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
  }
  WJ_mt_entries = { name = "central_transfer_fixed" position = { 332 0 } }
  scrollbox = {
  blockoverride "scrollbox_background" {}
  blockoverride "scrollbox_margins" { margin = { 4 4 } }
  position = { 0 106 } size = { 1408 500 }
  blockoverride "scrollbox_content" {
   vbox = {
    layoutpolicy_horizontal = expanding spacing = 16
    widget = { name = "central_army_command" size = { 1368 268 } layoutpolicy_vertical = fixed
     WJ_inner_person_card = {
 position = { 0 0 }
 datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]"
 datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
 datacontext = "[ActiveCouncilTask.GetPositionType]"
 datacontext = "[ActiveCouncilTask.GetCouncillor]"
 blockoverride "inner_title" { text = WJ_inner_general }
 blockoverride "inner_scene" { texture = "gfx/interface/illustrations/event_scenes/tgp_courtyard_asia.dds" }
 blockoverride "inner_animation" { portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', CouncilPositionType.GetPortraitAnimation, PdxGetWidgetScreenSize(PdxGuiWidget.Self))]" }
 blockoverride "inner_appointment" { button_round = {
  position = { 354 230 } size = { 32 32 }
  visible = "[GuiCouncilPosition.CanPotentiallySelectCouncillor]" enabled = "[GuiCouncilPosition.CanSelectCouncillor]"
  onclick = "[GuiCouncilPosition.SelectCouncillor]" tooltip = "[GuiCouncilPosition.GetSelectCouncillorTooltip]"
  button_change = { parentanchor = center alwaystransparent = yes }
 } }
 WJ_mt_menu_button = { position = { 396 230 } visible = "[Character.IsValid]" }
}
     WJ_inner_person_card = {
      position = { 464 0 } datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_zw_holder').Char]"
      blockoverride "inner_title" { text = trait_WJ_zhongwai }
      blockoverride "inner_person_visible" { visible = "[GetScriptedGui('WJ_mt_ui_person_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End)]" }
      blockoverride "inner_vacant_visible" { visible = "[Not(GetScriptedGui('WJ_mt_ui_person_zw').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End))]" }
      tooltip = WJ_mt_zhongwai_help
      text_single = { position = { 286 86 } size = { 146 24 } text = WJ_mt_huangyue_status default_format = "#high"
       visible = "[GetScriptedGui('WJ_mt_ui_person_huangyue').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('person', Character.MakeScope).End)]"
      }
      WJ_mt_menu_button = { position = { 396 230 } visible = "[Character.IsValid]" }
     }
     WJ_inner_person_card = {
 position = { 928 0 }
 datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char]"
 blockoverride "inner_title" { text = WJ_inner_dasima }
 blockoverride "inner_scene" { texture = "gfx/interface/illustrations/event_scenes/tgp_courtyard_asia.dds" }
 blockoverride "inner_animation" { portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', 'marshal', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]" }
 blockoverride "inner_appointment" { button_round = {
  position = { 354 230 } size = { 32 32 }
  visible = "[ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter)]"
  enabled = "[GetScriptedGui('WJ_dasima_open_picker').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  onclick = "[GetScriptedGui('WJ_dasima_open_picker').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  tooltip = WJ_inner_select_dasima button_change = { parentanchor = center alwaystransparent = yes }
 } }
 WJ_mt_menu_button = { position = { 396 230 } visible = "[Character.IsValid]" }
}
    }
    text_single = { layoutpolicy_horizontal = expanding size = { 1300 40 } text = WJ_mt_roster align = center default_format = "#high" background = { using = Background_Area_Dark } }
    text_single = { layoutpolicy_horizontal = expanding size = { 1300 32 } text = WJ_mt_generals align = center default_format = "#high" }
    dynamicgridbox = { datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_generals')]" datamodel_wrap = 5 flipdirection = yes
     item = { WJ_mt_officer_card = { datacontext = "[Scope.Char]" } }
    }
    text_single = { layoutpolicy_horizontal = expanding size = { 1300 32 } text = WJ_mt_officials align = center default_format = "#high" }
    dynamicgridbox = { datamodel = "[GetPlayer.MakeScope.GetList('wj_mt_officials')]" datamodel_wrap = 5 flipdirection = yes
     item = { WJ_mt_officer_card = { datacontext = "[Scope.Char]" } }
    }
   }
  }
  }
 }
