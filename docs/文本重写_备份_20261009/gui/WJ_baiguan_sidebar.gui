types WJBaiguanSidebarTypes {
 # Reuse the native council data model, not the council window as an entry point.
 type WJ_baiguan_sidebar_tab = widget_hud_main_tab {
  blockoverride "maintab_button" {
   texture = "gfx/interface/icons/court_position_types/favored_minister_court_position.dds"
   tooltip = "hd_baiguan_open_tt"
   # Mutually exclusive with native right-side windows: close them first.
   onclick = "[CloseGameView('government_administration')]"
   onclick = "[CloseGameView('my_realm')]"
   onclick = "[CloseGameView('military')]"
   onclick = "[CloseGameView('council_window')]"
   onclick = "[CloseGameView('court_window')]"
   onclick = "[CloseGameView('intrigue_window')]"
   onclick = "[CloseGameView('factions_window')]"
   onclick = "[CloseGameView('decisions')]"
   onclick = "[CloseGameView('decision_detail')]"
   onclick = "[CloseGameView('activity_list_window')]"
   onclick = "[CloseGameView('situations')]"
   onclick = "[CloseGameView('manage_tax_slots')]"
   onclick = "[CloseGameView('character')]"
   block "select_baiguan_court" {}
   onclick = "[GetScriptedGui('hd_baiguan_open_effect').Execute(GuiScope.SetRoot(GetPlayer.GetTopLiege.MakeScope).End)]"
   onclick = "[GetVariableSystem.Clear('WJ_baiguan_page')]"
   onclick = "[GetVariableSystem.Toggle('hd_baiguan_visibility')]"
  }
 }
}
