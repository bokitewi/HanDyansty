template Wheel_Turn_Duration
{
	duration = 1.5
}

template Wheel_Turn_Bezier_Curve
{
	# ease out
	#bezier = { 0.5 0 1 0.75 }

	# S curve
	bezier = { 0.33 0 0.66 1 }
}

