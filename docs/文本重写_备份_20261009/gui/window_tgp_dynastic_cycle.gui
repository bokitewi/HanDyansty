######################################################
################ THE DYNASTIC CYCLE ##################
######################################################
window = {
	name = "window_tgp_dynastic_cycle"
	widgetid = "window_tgp_dynastic_cycle"

	datacontext = "[GetSituation('dynastic_cycle')]"
	datacontext = "[Situation.GetTopSubRegion]"
	datacontext = "[Situation.GetTopCurrentPhase]"
	datacontext = "[GetVariableSystem]"
	datacontext = "[GetPlayer]"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	allow_outside = yes

	using = Window_Size_MainTab

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab

		on_start = "[SetMapMode( 'dynastic_cycle' )]"
		on_start = "[SituationWindow.ClearSelectedFuturePhaseType]"
		on_start = "[SituationWindow.AccessParticipantCharacterList.SetSelectedParticipantGroup( Situation.GetTopCharacterParticipantGroup( GetPlayer.Self ) )]"
		on_start = "[SituationDynasticCycleWindow.UpdateSelectedParticipantGroup( Situation.GetTopCharacterParticipantGroup( GetPlayer.Self ) )]"
	}

	state = {
		name = on_create
		trigger_on_create = yes

		on_start = "[GetVariableSystem.Set( 'dynastic_cycle', 'overview'  )]"
		on_start = "[GetVariableSystem.Clear( 'movements' )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide

		on_start = "[SetMapMode( 'realms' )]"
		on_start = "[VariableSystem.Clear( 'dynastic_cycle_phases_list_window' )]"
		on_start = "[VariableSystem.Clear( 'hd_party_members_window' )]"
	}

	margin_widget = {
		size = { 100% 100% }
		margin_top = 32
		margin_bottom = 25
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				### HEADER
				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "[Situation.GetNameNoTooltip]"
					}

					blockoverride = "button_back"
					{
						onclick = "[OpenGameView( 'situations' )]"
					}

					blockoverride "button_close"
					{
						onclick = "[SituationWindow.Close]"
					}
				}

				### HEGEMONY NAME（天朝循环大修：时代列表/历史按钮移到同一行右侧）
				widget = {
					layoutpolicy_horizontal = expanding
					size = { 0 48 }
					text_single = {
						parentanchor = center
						max_width = 300
						text = "DYNASTIC_CYCLE_WINDOW_CURRENT_DYNASTY"
						using = Font_Size_Small
						align = center|nobaseline
					}
					### TOP RIGHT BUTTONS
					widget = {
						datacontext = "[SituationWindow.AccessParticipantCharacterList]"
						datacontext = "[SituationParticipantCharacterList.GetSelectedParticipantGroup]"
						visible = "[Not( SituationDynasticCycleWindow.IsInChaosEra )]"
						parentanchor = right|vcenter
						widgetanchor = right|vcenter
						position = { -4 0 }
						size = { 124 64 }
					
						situation_overview_buttons_vbox = {
							blockoverride "participants_list_section"
							{
								visible = no
							}

							blockoverride "hd_party_members_section"
							{
								hd_party_members_toggle_button = {}
							}
						}
					}

					### TOP RIGHT BUTTONS (DURING CHAOS ERA)
					widget = {
						visible = "[SituationDynasticCycleWindow.IsInChaosEra]"
						parentanchor = right|vcenter
						widgetanchor = right|vcenter
						position = { -4 0 }
						size = { 124 64 }
					
						situation_overview_buttons_vbox = {
							datacontext = "[SituationWindow.AccessParticipantCharacterList]"
							datacontext = "[SituationWindow.GetSituation.GetParticipantGroupByCharacter( GetPlayer )]"

							blockoverride "participants_list_section"
							{
								visible = "[SituationDynasticCycleWindow.IsInChaosEra]"
							}

							blockoverride "hd_party_members_section"
							{
								hd_party_members_toggle_button = {}
							}

							blockoverride "participants_number_text"
							{
								text = "[GetDataModelSize( SituationWindow.GetSituation.GetParticipatingCharacters )]"
								tooltip = "DYNASTIC_CYCLE_WINDOW_TOGGLE_MEMBER_LIST_TT_CHAOS"
							}
						}
					}
				}

				hbox = {
					name = "dynastic_cycle_tabs"
					# 天朝循环大修·朋党：乱世也显示标签页
					layoutpolicy_horizontal = expanding

					button_tab = {
						name = "open_dynastic_cyle_tab"
						shortcut = "tab_1"

						down = "[GetVariableSystem.Exists( 'dynastic_cycle' )]"

						onclick = "[GetVariableSystem.Set( 'dynastic_cycle', 'true' )]"
						onclick = "[GetVariableSystem.Clear( 'movements' )]"
						onclick = "[GetVariableSystem.Clear( 'hd_party_members_window' )]"

						alwaystransparent = "[GetVariableSystem.Exists( 'dynastic_cycle' )]"

						blockoverride "tab_label"
						{
							text = "dynastic_cycle_tab_dynastic_cycle"
							max_width = 220
						}

						blockoverride "icon_visible" {}

						blockoverride "tab_icon"
						{
							texture = "gfx/interface/icons/flat_icons/dynastic_cycle.dds"
							down = "[GetVariableSystem.Exists( 'dynastic_cycle' )]"
						}
					}

					button_tab = {
						name = "open_movements_tab"
						shortcut = "tab_2"
						# 天朝循环大修·朋党：只对王国级以上朝廷显示（文档 1.01）
						visible = "[GetScriptedGui( 'hd_party_tab_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						
						down = "[GetVariableSystem.Exists( 'movements' )]"

						onclick = "[GetVariableSystem.Set( 'movements', 'true' )]"
						onclick = "[GetVariableSystem.Clear( 'dynastic_cycle' )]"

						alwaystransparent = "[GetVariableSystem.Exists( 'movements' )]"

						blockoverride "tab_label"
						{
							text = "dynastic_cycle_tab_movements"
							max_width = 220
						}

						blockoverride "icon_visible" {}

						blockoverride "tab_icon"
						{
							texture = "gfx/interface/icons/flat_icons/group_power.dds"
							down = "[GetVariableSystem.Exists( 'movements' )]"
						}
					}
				}

				### DYNASTIC CYCLE ###
				scrollbox = {
					name = "dynastic_cycle_scrollarea"
					widgetid = "dynastic_cycles_eras_tab_contents"
					visible = "[Or( GetVariableSystem.Exists( 'dynastic_cycle' ), Or( Not( GetVariableSystem.Exists( 'movements' ) ), Not( GetScriptedGui( 'hd_party_tab_gui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					using = Animation_Tab_Switch

					blockoverride "scrollbox_margins" {}
					blockoverride "scrollbox_content"

					{
						### HD 天朝循环大修：新版时代页（插画 / 标题介绍与参与者组效果 / 时代轮盘 / 乱世势力 / 决议）
						### 1. 时代插画（随当前时代切换）
						widget = {
							name = "hd_dc_era_illustration"
							layoutpolicy_horizontal = expanding
							size = { 0 230 }
							background = {
								texture = "[SituationPhase.GetType.GetIllustration]"
								fittype = centercrop
								using = Mask_Rough_Edges
							}
						}

						### 2-4. 时代标题 / 介绍 / 参与者组效果（原版）
						### ERA INFORMATION BOX
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							divider_light = {
								layoutpolicy_horizontal = expanding
							}

							selected_era_info_vbox = {
								visible = "[Not(SituationWindow.GetSelectedFuturePhaseType.IsValid)]"
								datacontext = "[SituationPhase.GetType]"
								layoutpolicy_vertical = expanding

								blockoverride "selected_era_future_info" {
								}

								blockoverride "selected_era_header_extra" {
									text_single = {
										text = "DYNASTIC_CYCLE_WINDOW_CURRENT_ERA_LABEL"
										layoutpolicy_horizontal = expanding
										align = nobaseline|right
										default_format = "#weak"
									}
								}
							}

							selected_era_info_vbox = {
								visible = "[SituationWindow.GetSelectedFuturePhaseType.IsValid]"
								datacontext = "[SituationWindow.GetSelectedOrLeadingFuturePhaseType]"

								blockoverride "selected_era_header_extra" {

									text_single = {
										text = "DYNASTIC_CYCLE_WINDOW_FUTURE_ERA_LABEL"
										layoutpolicy_horizontal = expanding
										align = nobaseline|right
										default_format = "#weak"
									}

								}
							}

						}


						### 5. 时代轮盘：中央=进度最高的可进入时代；外圈=全部 8 个时代（不可进入的置灰）
						widget = {
							name = "hd_dc_era_wheel"
							layoutpolicy_horizontal = expanding
							size = { 0 400 }
							icon = {
								parentanchor = center
								size = { 380 388 }
								alwaystransparent = yes
								texture = "gfx/interface/icons/dynastic_cycle/ui2n.png"	# HanJIn_Clothes
							}
							return_current_era_button = {
								parentanchor = top|right
								position = { -16 8 }
							}
							widget = {
								parentanchor = center
								widgetanchor = center
								size = { 120 140 }
								dynastic_cycle_phase_widget = {
									datacontext = "[SituationPhase.GetLeadingPhaseType]"
									visible = "[SituationPhase.GetLeadingPhaseType.IsValid]"
									parentanchor = top|hcenter
									blockoverride "size" { size = { 104 104 } }
									blockoverride "phase_widget_tooltip" {
										tooltip = "HD_DC_WHEEL_LEADING_TT"
										using = tooltip_se
									}
								}
								dynastic_cycle_phase_widget = {
									datacontext = "[SituationPhase.GetType]"
									visible = "[Not( SituationPhase.GetLeadingPhaseType.IsValid )]"
									parentanchor = top|hcenter
									blockoverride "size" { size = { 104 104 } }
								}
								flowcontainer = {
									parentanchor = bottom|hcenter
									ignoreinvisible = yes
									datamodel = "[SituationPhase.GetFuturePhases]"
									item = {
										text_single = {
											visible = "[ObjectsEqual( FutureSituationPhase.GetType.Self, SituationPhase.GetLeadingPhaseType.Self )]"
											text = "HD_DC_WHEEL_LEADING_PROGRESS"
											using = Font_Size_Medium
											align = nobaseline|center
										}
									}
								}
							}
							# hd_recovery
							widget = {
								position = { 0 -150 }
								parentanchor = center
								widgetanchor = center
								size = { 72 72 }
								button_normal = {	# 天朝循环大修：不可进入的时代也可点击查看
									datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_hd_recovery')]"
									size = { 72 72 }
									alpha = 0.45
									visible = "[Not( EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_hd_recovery' ) )]"
									onclick = "[SituationWindow.SetSelectedFuturePhaseType( SituationPhaseType.Self )]"
									tooltipwidget = { using = situation_phase_type_tooltip }
									using = tooltip_ne
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_hd_recovery')]"
										parentanchor = center
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "size" { size = { 60 60 } }
									}
								}
								button_normal = {
									size = { 72 72 }
									visible = "[EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_hd_recovery' )]"
									onclick = "[SituationWindow.ClearSelectedFuturePhaseType]"
									datacontext = "[SituationPhase.GetType]"
									tooltip = "DYNASTIC_CYCLE_CURRENT_PHASE_TT"
									using = tooltip_se
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_hd_recovery')]"
										parentanchor = center
										blockoverride "size" { size = { 68 68 } }
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "phase_widget_glow" {
											glow = {
												glow_radius = 8
												using = Glow_Standard
												using = Color_Orange
											}
										}
									}
								}
								flowcontainer = {
									parentanchor = center
									widgetanchor = center
									ignoreinvisible = yes
									datamodel = "[SituationPhase.GetFuturePhases]"
									item = {
										hd_dc_future_era_button = {
											visible = "[EqualTo_string( FutureSituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_hd_recovery' )]"
										}
									}
								}
							}
							# stability_expansion
							widget = {
								position = { 106 -106 }
								parentanchor = center
								widgetanchor = center
								size = { 72 72 }
								button_normal = {	# 天朝循环大修：不可进入的时代也可点击查看
									datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_stability_expansion')]"
									size = { 72 72 }
									alpha = 0.45
									visible = "[Not( EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_stability_expansion' ) )]"
									onclick = "[SituationWindow.SetSelectedFuturePhaseType( SituationPhaseType.Self )]"
									tooltipwidget = { using = situation_phase_type_tooltip }
									using = tooltip_ne
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_stability_expansion')]"
										parentanchor = center
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "size" { size = { 60 60 } }
									}
								}
								button_normal = {
									size = { 72 72 }
									visible = "[EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_stability_expansion' )]"
									onclick = "[SituationWindow.ClearSelectedFuturePhaseType]"
									datacontext = "[SituationPhase.GetType]"
									tooltip = "DYNASTIC_CYCLE_CURRENT_PHASE_TT"
									using = tooltip_se
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_stability_expansion')]"
										parentanchor = center
										blockoverride "size" { size = { 68 68 } }
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "phase_widget_glow" {
											glow = {
												glow_radius = 8
												using = Glow_Standard
												using = Color_Orange
											}
										}
									}
								}
								flowcontainer = {
									parentanchor = center
									widgetanchor = center
									ignoreinvisible = yes
									datamodel = "[SituationPhase.GetFuturePhases]"
									item = {
										hd_dc_future_era_button = {
											visible = "[EqualTo_string( FutureSituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_stability_expansion' )]"
										}
									}
								}
							}
							# stability_advancement
							widget = {
								position = { 150 0 }
								parentanchor = center
								widgetanchor = center
								size = { 72 72 }
								button_normal = {	# 天朝循环大修：不可进入的时代也可点击查看
									datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_stability_advancement')]"
									size = { 72 72 }
									alpha = 0.45
									visible = "[Not( EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_stability_advancement' ) )]"
									onclick = "[SituationWindow.SetSelectedFuturePhaseType( SituationPhaseType.Self )]"
									tooltipwidget = { using = situation_phase_type_tooltip }
									using = tooltip_ne
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_stability_advancement')]"
										parentanchor = center
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "size" { size = { 60 60 } }
									}
								}
								button_normal = {
									size = { 72 72 }
									visible = "[EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_stability_advancement' )]"
									onclick = "[SituationWindow.ClearSelectedFuturePhaseType]"
									datacontext = "[SituationPhase.GetType]"
									tooltip = "DYNASTIC_CYCLE_CURRENT_PHASE_TT"
									using = tooltip_se
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_stability_advancement')]"
										parentanchor = center
										blockoverride "size" { size = { 68 68 } }
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "phase_widget_glow" {
											glow = {
												glow_radius = 8
												using = Glow_Standard
												using = Color_Orange
											}
										}
									}
								}
								flowcontainer = {
									parentanchor = center
									widgetanchor = center
									ignoreinvisible = yes
									datamodel = "[SituationPhase.GetFuturePhases]"
									item = {
										hd_dc_future_era_button = {
											visible = "[EqualTo_string( FutureSituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_stability_advancement' )]"
										}
									}
								}
							}
							# instability
							widget = {
								position = { 106 106 }
								parentanchor = center
								widgetanchor = center
								size = { 72 72 }
								button_normal = {	# 天朝循环大修：不可进入的时代也可点击查看
									datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_instability')]"
									size = { 72 72 }
									alpha = 0.45
									visible = "[Not( EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_instability' ) )]"
									onclick = "[SituationWindow.SetSelectedFuturePhaseType( SituationPhaseType.Self )]"
									tooltipwidget = { using = situation_phase_type_tooltip }
									using = tooltip_ne
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_instability')]"
										parentanchor = center
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "size" { size = { 60 60 } }
									}
								}
								button_normal = {
									size = { 72 72 }
									visible = "[EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_instability' )]"
									onclick = "[SituationWindow.ClearSelectedFuturePhaseType]"
									datacontext = "[SituationPhase.GetType]"
									tooltip = "DYNASTIC_CYCLE_CURRENT_PHASE_TT"
									using = tooltip_se
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_instability')]"
										parentanchor = center
										blockoverride "size" { size = { 68 68 } }
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "phase_widget_glow" {
											glow = {
												glow_radius = 8
												using = Glow_Standard
												using = Color_Orange
											}
										}
									}
								}
								flowcontainer = {
									parentanchor = center
									widgetanchor = center
									ignoreinvisible = yes
									datamodel = "[SituationPhase.GetFuturePhases]"
									item = {
										hd_dc_future_era_button = {
											visible = "[EqualTo_string( FutureSituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_instability' )]"
										}
									}
								}
							}
							# hd_collapse
							widget = {
								position = { 0 150 }
								parentanchor = center
								widgetanchor = center
								size = { 72 72 }
								button_normal = {	# 天朝循环大修：不可进入的时代也可点击查看
									datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_hd_collapse')]"
									size = { 72 72 }
									alpha = 0.45
									visible = "[Not( EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_hd_collapse' ) )]"
									onclick = "[SituationWindow.SetSelectedFuturePhaseType( SituationPhaseType.Self )]"
									tooltipwidget = { using = situation_phase_type_tooltip }
									using = tooltip_ne
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_hd_collapse')]"
										parentanchor = center
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "size" { size = { 60 60 } }
									}
								}
								button_normal = {
									size = { 72 72 }
									visible = "[EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_hd_collapse' )]"
									onclick = "[SituationWindow.ClearSelectedFuturePhaseType]"
									datacontext = "[SituationPhase.GetType]"
									tooltip = "DYNASTIC_CYCLE_CURRENT_PHASE_TT"
									using = tooltip_se
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_hd_collapse')]"
										parentanchor = center
										blockoverride "size" { size = { 68 68 } }
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "phase_widget_glow" {
											glow = {
												glow_radius = 8
												using = Glow_Standard
												using = Color_Orange
											}
										}
									}
								}
								flowcontainer = {
									parentanchor = center
									widgetanchor = center
									ignoreinvisible = yes
									datamodel = "[SituationPhase.GetFuturePhases]"
									item = {
										hd_dc_future_era_button = {
											visible = "[EqualTo_string( FutureSituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_hd_collapse' )]"
										}
									}
								}
							}
							# chaos
							widget = {
								position = { -106 106 }
								parentanchor = center
								widgetanchor = center
								size = { 72 72 }
								button_normal = {	# 天朝循环大修：不可进入的时代也可点击查看
									datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_chaos')]"
									size = { 72 72 }
									alpha = 0.45
									visible = "[Not( EqualTo_string( SituationPhase.GetType.GetKey, 'situation_dynastic_cycle_phase_chaos' ) )]"
									onclick = "[SituationWindow.SetSelectedFuturePhaseType( SituationPhaseType.Self )]"
									tooltipwidget = { using = situation_phase_type_tooltip }
									using = tooltip_ne
									dynastic_cycle_phase_widget = {
										datacontext = "[GetSituationType('dynastic_cycle').GetPhaseType('situation_dynastic_cycle_phase_chaos')]"
										parentanchor = center
										alwaystransparent = yes
										blockoverride "phase_widget_tooltip" {}
										blockoverride "size" { size = { 60 60 } }
									}
								}
