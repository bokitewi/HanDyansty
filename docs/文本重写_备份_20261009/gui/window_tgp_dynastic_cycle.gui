				}
			}

		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10

			vbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					layoutpolicy_horizontal = expanding
					text = "DYNASTIC_CYCLE_WINDOW_LEGITIMACY_TITLE"
