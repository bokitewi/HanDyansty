# Layout transplant from native window_council_potential_councillor/lists.gui.
# Scope list items are NOT CharacterListItem; never bind the native council model/actions.
window = {
 name = "WJ_dasima_picker_window"
 parentanchor = center
 layer = top
 allow_outside = yes
 state = { name = _show on_start = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]" }
 state = { name = _hide on_start = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]" }
 using = Window_Movable
 using = Window_Size_CharacterList
 using = Window_Background
 using = Window_Decoration_Spike
 filter_mouse = all
 alwaystransparent = no
 visible = "[GetScriptedGui('WJ_dasima_picker_visible').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End)]"
 widget = {
  name = "WJ_dasima_picker_panel"
  size = { 100% 100% }
 vbox = {
  using = Window_Margins
  header_pattern = {
   layoutpolicy_horizontal = expanding
   blockoverride "header_text" { text = WJ_inner_select_dasima }
   blockoverride "button_close" { name = "WJ_dasima_picker_close" onclick = "[GetScriptedGui('WJ_dasima_close_picker').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
  }
  widget = {
   name = "WJ_dasima_current"
   layoutpolicy_horizontal = expanding
   size = { 665 175 }
   visible = "[GetScriptedGui('WJ_dasima_revoke').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   datacontext = "[GetPlayer.MakeScope.Var('wj_dasima_holder').Char]"
   portrait_shoulders = { parentanchor = top|left position = { 15 0 } }
   text_single = { parentanchor = top|left position = { 160 24 } size = { 320 25 } text = WJ_dasima_picker_current default_format = "#low" align = center }
   text_single = { parentanchor = top|left position = { 160 53 } size = { 320 30 } text = "[Character.Custom('WJ_GetUIName')]" using = Font_Size_Medium autoresize = no }
   text_single = { parentanchor = top|left position = { 160 88 } size = { 320 25 } text = "[Character.Custom2('WJ_RelationToViewer', GetPlayer)]" tooltip = EXTENDED_RELATIONS_TOOLTIP visible = "[And(GetPlayer.IsValid, Or(Character.HasRelationTo(GetPlayer), GetScriptedGui('WJ_relation_has_mufu').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('viewer', GetPlayer.MakeScope).End)))]" autoresize = no }
   button_standard = {
    parentanchor = top|left position = { 190 122 } size = { 180 32 }
    text = WJ_inner_revoke
    enabled = "[GetScriptedGui('WJ_dasima_revoke').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetScriptedGui('WJ_dasima_revoke').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   }
   text_single = { parentanchor = top|left position = { 505 52 } size = { 160 25 } align = center text = COUNCIL_WINDOW_SKILLS }
   widget = {
    name = "WJ_dasima_current_skills"
    parentanchor = top|left position = { 505 80 } size = { 160 25 }
    hbox_skills_grid_character_model = {}
   }
   text_single = { parentanchor = top|left position = { 505 120 } size = { 160 25 } align = center text = "[Character.GetMerit|0]" tooltip = "[Character.GetMeritTooltipWithBalance]" }
   divider_light = { parentanchor = bottom|hcenter size = { 100% 3 } }
  }
  text_single = {
   layoutpolicy_horizontal = expanding
   size = { 630 30 } autoresize = no align = center default_format = "#low"
   text = WJ_inner_honor_desc tooltip = WJ_inner_candidate_help
  }
  hbox = {
   name = "WJ_dasima_sort_toolbar"
   layoutpolicy_horizontal = expanding
   margin_left = 20 margin_right = 23 margin_top = 5 spacing = 5
   button_standard = {
    name = "WJ_dasima_filters_toggle"
    size = { 25 25 } tooltip = TOGGLE_FILTERS
    onclick = "[GetScriptedGui('WJ_dasima_toggle_filters').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    down = "[GetScriptedGui('WJ_dasima_toggle_filters_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    button_search = { alwaystransparent = yes parentanchor = center size = { 20 20 } }
   }
   text_single = { text = SORT_BY align = nobaseline size = { 68 32 } autoresize = no }
   button = {
    name = "WJ_dasima_sort_dropdown" size = { 200 32 }
    onclick = "[GetVariableSystem.Set('wj_dasima_sort_menu', 'open')]"
    button_drop = { alwaystransparent = yes size = { 100% 100% } text = "[Select_CString(GetScriptedGui('WJ_dasima_sort_age_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('CHARACTER_SORT_AGE'), Select_CString(GetScriptedGui('WJ_dasima_sort_tier_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('CHARACTER_SORT_TITLES'), Select_CString(GetScriptedGui('WJ_dasima_sort_military_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('SORT_MILITARY_STRENGTH'), Select_CString(GetScriptedGui('WJ_dasima_sort_opinion_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('CONFEDERATION_SORT_OPTION_OPINION'), Select_CString(GetScriptedGui('WJ_dasima_sort_prowess_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('BATTLE_SUMMARY_SORT_PROWESS'), Select_CString(GetScriptedGui('WJ_dasima_sort_diplomacy_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('diplomacy'), Select_CString(GetScriptedGui('WJ_dasima_sort_martial_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('martial'), Select_CString(GetScriptedGui('WJ_dasima_sort_stewardship_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('stewardship'), Select_CString(GetScriptedGui('WJ_dasima_sort_intrigue_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('intrigue'), Select_CString(GetScriptedGui('WJ_dasima_sort_learning_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('learning'), Localize('CHARACTER_SORT_ALL_SKILLS')))))))))))]" }
   }
   button_standard = {
    size = { 25 25 } tooltip = WJ_dasima_picker_reverse
    onclick = "[GetScriptedGui('WJ_dasima_sort_reverse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    down = "[GetScriptedGui('WJ_dasima_sort_reverse_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    icon = { alwaystransparent = yes parentanchor = center size = { 25 25 } texture = "gfx/interface/icons/flat_icons/sort_icon.dds" framesize = { 66 66 } frame = "[BoolTo1And2(GetScriptedGui('WJ_dasima_sort_reverse_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
   }
   expand = {}
   button_standard_hover = {
    name = "WJ_dasima_skill_diplomacy" size = { 32 32 }
    tooltip = SORT_BY_DIPLOMACY
    onclick = "[GetScriptedGui('WJ_dasima_sort_diplomacy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    down = "[GetScriptedGui('WJ_dasima_sort_diplomacy_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    icon = { alwaystransparent = yes size = { 32 32 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 1 }
   }
   button_standard_hover = {
    name = "WJ_dasima_skill_martial" size = { 32 32 }
    tooltip = SORT_BY_MARTIAL
    onclick = "[GetScriptedGui('WJ_dasima_sort_martial').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    down = "[GetScriptedGui('WJ_dasima_sort_martial_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    icon = { alwaystransparent = yes size = { 32 32 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 2 }
   }
   button_standard_hover = {
    name = "WJ_dasima_skill_stewardship" size = { 32 32 }
    tooltip = SORT_BY_STEWARDSHIP
    onclick = "[GetScriptedGui('WJ_dasima_sort_stewardship').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    down = "[GetScriptedGui('WJ_dasima_sort_stewardship_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    icon = { alwaystransparent = yes size = { 32 32 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 3 }
   }
   button_standard_hover = {
    name = "WJ_dasima_skill_intrigue" size = { 32 32 }
    tooltip = SORT_BY_INTRIGUE
    onclick = "[GetScriptedGui('WJ_dasima_sort_intrigue').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    down = "[GetScriptedGui('WJ_dasima_sort_intrigue_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    icon = { alwaystransparent = yes size = { 32 32 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 4 }
   }
   button_standard_hover = {
    name = "WJ_dasima_skill_learning" size = { 32 32 }
    tooltip = SORT_BY_LEARNING
    onclick = "[GetScriptedGui('WJ_dasima_sort_learning').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    down = "[GetScriptedGui('WJ_dasima_sort_learning_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    icon = { alwaystransparent = yes size = { 32 32 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 5 }
   }
  }
  vbox = {
   name = "WJ_dasima_filters"
   layoutpolicy_horizontal = expanding
   margin_left = 20 margin_right = 23 spacing = 5
   visible = "[GetScriptedGui('WJ_dasima_toggle_filters_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   hbox = {
    layoutpolicy_horizontal = expanding
    text_single = { layoutpolicy_horizontal = expanding text = religion_filter align = nobaseline }
   dropdown_menu_standard = {
    name = "WJ_dasima_filter_faith"
    blockoverride "dropdown_properties" {
     datamodel = "[GetPlayer.MakeScope.GetList('wj_dasima_filter_options')]"
     selectedindex = "[Select_int32(GetScriptedGui('WJ_dasima_filter_faith_0_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), '(int32)0', Select_int32(GetScriptedGui('WJ_dasima_filter_faith_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), '(int32)1', '(int32)2'))]"
     onselectionchanged = "[GetScriptedGui(Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), 'WJ_dasima_filter_faith_0', Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), 'WJ_dasima_filter_faith_1', 'WJ_dasima_filter_faith_2'))).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    blockoverride "dropdown_active_item_properties" { text = "[Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), Localize('any_filter_option'), Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Localize('same_faith_filter_option'), Localize('not_same_faith_filter_option')))]" }
    blockoverride "dropdown_item_properties" { text = "[Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), Localize('any_filter_option'), Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Localize('same_faith_filter_option'), Localize('not_same_faith_filter_option')))]" }
   }
   }
   hbox = {
    layoutpolicy_horizontal = expanding
    text_single = { layoutpolicy_horizontal = expanding text = culture_filter align = nobaseline }
   dropdown_menu_standard = {
    name = "WJ_dasima_filter_culture"
    blockoverride "dropdown_properties" {
     datamodel = "[GetPlayer.MakeScope.GetList('wj_dasima_filter_options')]"
     selectedindex = "[Select_int32(GetScriptedGui('WJ_dasima_filter_culture_0_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), '(int32)0', Select_int32(GetScriptedGui('WJ_dasima_filter_culture_1_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), '(int32)1', '(int32)2'))]"
     onselectionchanged = "[GetScriptedGui(Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), 'WJ_dasima_filter_culture_0', Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), 'WJ_dasima_filter_culture_1', 'WJ_dasima_filter_culture_2'))).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    blockoverride "dropdown_active_item_properties" { text = "[Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), Localize('any_filter_option'), Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Localize('same_culture_filter_option'), Localize('not_same_culture_filter_option')))]" }
    blockoverride "dropdown_item_properties" { text = "[Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'), Localize('any_filter_option'), Select_CString(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), Localize('same_culture_filter_option'), Localize('not_same_culture_filter_option')))]" }
   }
   }
  }
  scrollbox = {
   name = "characters_scroll_area"
   layoutpolicy_vertical = expanding layoutpolicy_horizontal = expanding
   blockoverride "scrollbox_content" {
    fixedgridbox = {
     name = "characters_grid"
     parentanchor = top|left
     addcolumn = 650 addrow = 110
     maxhorizontalslots = 1
     datamodel_reuse_widgets = yes
     datamodel = "[GetPlayer.MakeScope.GetList('wj_dasima_candidates')]"
     item = {
      widget = {
       name = "WJ_dasima_candidate_row"
       datacontext = "[Scope.Char]"
       size = { 630 110 }
       # Put absolute geometry on widgets, never on hbox child defaults.
       portrait_head_small = { parentanchor = top|left position = { 0 5 } }
       widget = {
        parentanchor = top|left position = { 95 5 } size = { 535 100 }
        background = { using = Background_Area_Characterlist }
        text_single = { parentanchor = top|left position = { 10 0 } size = { 345 28 } text = "[Character.Custom('WJ_GetUIName')|U]" using = Font_Size_Medium autoresize = no }
        widget = {
         name = "WJ_dasima_candidate_skills"
         parentanchor = top|left position = { 372 3 } size = { 160 25 }
         hbox_skills_grid_character_model = {}
        }
        widget = {
         name = "WJ_dasima_candidate_age"
         parentanchor = top|left position = { 10 30 } size = { 345 25 }
         hbox = {
          spacing = 5
          hbox = { using = character_age_or_death_text blockoverride "list_layout" {} }
          text_single = { layoutpolicy_horizontal = expanding text = "[Character.Custom2('WJ_RelationToViewer', GetPlayer)]" tooltip = EXTENDED_RELATIONS_TOOLTIP default_format = "#low" autoresize = no visible = "[And(GetPlayer.IsValid, Or(Character.HasRelationTo(GetPlayer), GetScriptedGui('WJ_relation_has_mufu').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('viewer', GetPlayer.MakeScope).End)))]" }
         }
        }
        widget = {
         name = "WJ_dasima_candidate_identity"
         parentanchor = top|left position = { 10 60 } size = { 340 40 }
         hbox = {
         spacing = 5
         widget = { size = { 35 40 } coa_house_tiny = { datacontext = "[Character.GetHouse]" parentanchor = center } }
         icon = { size = { 35 35 } datacontext = "[Character.GetFaith]" texture = "[Faith.GetIcon]" tooltipwidget = { faith_tooltip = {} } }
         icon = { size = { 30 30 } texture = "gfx/interface/icons/icon_culture.dds" datacontext = "[Character.GetCulture]" tooltipwidget = { culture_tooltip = {} } }
         text_single = { size = { 45 30 } datacontext = "[Character.GetCulture]" text = CULTURE_LISTS_WINDOW autoresize = no tooltipwidget = { culture_tooltip = {} } }
         widget = {
          size = { 150 35 } scissor = yes
          fixedgridbox = {
           parentanchor = top|left
           datamodel = "[Character.GetTraitIndices]"
           addcolumn = 30 addrow = 35 maxhorizontalslots = 100 maxverticalslots = 1
           item = { icon_trait = { datacontext = "[GetTraitForIndex(int32.GetInt)]" blockoverride "icon_size" { size = { 30 30 } } } }
          }
         }
         }
        }
        button_standard = {
         parentanchor = top|left position = { 357 62 } size = { 170 32 } text = WJ_inner_appoint
         enabled = "[GetScriptedGui('WJ_dasima_select_candidate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Character.MakeScope).AddScope('wj_inner_emperor', GetPlayer.MakeScope).End)]"
         onclick = "[GetScriptedGui('WJ_dasima_select_candidate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Character.MakeScope).AddScope('wj_inner_emperor', GetPlayer.MakeScope).End)]"
         tooltip = "[GetPlayer.Custom('WJ_GetUIName')] → [Character.Custom('WJ_GetUIName')]\\n[GetScriptedGui('WJ_dasima_select_candidate').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('candidate', Character.MakeScope).AddScope('wj_inner_emperor', GetPlayer.MakeScope).End)]"
        }
       }
       divider_light = { parentanchor = bottom|hcenter size = { 100% 3 } }
      }
     }
    }
   }
  blockoverride "scrollbox_empty" { visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_dasima_candidates'))]" text = WJ_inner_no_candidates }
  }
 }
 button = {
  size = { 100% 100% }
  visible = "[GetVariableSystem.Exists('wj_dasima_sort_menu')]"
  onclick = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]"
 }
 widget = {
  name = "WJ_dasima_sort_menu" position = { 163 141 } size = { 200 200 }
  visible = "[GetVariableSystem.Exists('wj_dasima_sort_menu')]"
  using = Background_DropDown filter_mouse = all
  state = { name = "with_holder"
   trigger_when = "[GetScriptedGui('WJ_dasima_revoke').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   position = { 163 316 }
  }
  state = { name = "without_holder"
   trigger_when = "[Not(GetScriptedGui('WJ_dasima_revoke').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
   position = { 163 141 }
  }
  vbox = { margin = { 4 4 } spacing = 0
   button = { name = "WJ_dasima_sort_option_age" size = { 192 32 }
    onclick = "[GetScriptedGui('WJ_dasima_sort_age').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]"
    button_dropdown = { alwaystransparent = yes size = { 100% 100% } text = CHARACTER_SORT_AGE }
   }
   button = { name = "WJ_dasima_sort_option_tier" size = { 192 32 }
    onclick = "[GetScriptedGui('WJ_dasima_sort_tier').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]"
    button_dropdown = { alwaystransparent = yes size = { 100% 100% } text = CHARACTER_SORT_TITLES }
   }
   button = { name = "WJ_dasima_sort_option_military" size = { 192 32 }
    onclick = "[GetScriptedGui('WJ_dasima_sort_military').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]"
    button_dropdown = { alwaystransparent = yes size = { 100% 100% } text = SORT_MILITARY_STRENGTH }
   }
   button = { name = "WJ_dasima_sort_option_opinion" size = { 192 32 }
    onclick = "[GetScriptedGui('WJ_dasima_sort_opinion').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]"
    button_dropdown = { alwaystransparent = yes size = { 100% 100% } text = CONFEDERATION_SORT_OPTION_OPINION }
   }
   button = { name = "WJ_dasima_sort_option_prowess" size = { 192 32 }
    onclick = "[GetScriptedGui('WJ_dasima_sort_prowess').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]"
    button_dropdown = { alwaystransparent = yes size = { 100% 100% } text = BATTLE_SUMMARY_SORT_PROWESS }
   }
   button = { name = "WJ_dasima_sort_option_all_skills" size = { 192 32 }
    onclick = "[GetScriptedGui('WJ_dasima_sort_all_skills').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[GetVariableSystem.Clear('wj_dasima_sort_menu')]"
    button_dropdown = { alwaystransparent = yes size = { 100% 100% } text = CHARACTER_SORT_ALL_SKILLS }
   }
  }
 }
}
}
