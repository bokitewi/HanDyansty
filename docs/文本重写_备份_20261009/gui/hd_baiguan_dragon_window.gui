types hd_baiguan_dragon_types
{
	# The small action button never replaces the portrait's native character click.
	type hd_dragon_person_slot = widget {
		size = { 88 122 }
		allow_outside = yes
		widget = {
			position = { 10 0 } size = { 68 76 }
			background = { using = Background_Area_Dark }
			icon = {
				size = { 68 76 } alwaystransparent = yes
				visible = "[Not(And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter))))]"
				texture = "gfx/portraits/unknown_portraits/unknown_head.dds"
			}
		}
		widget = {
			size = { 100% 100% }
			block "person_visible" { visible = "[And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter)))]" }
			portrait_button = {
				position = { 10 0 } size = { 68 76 } using = portrait_base
				portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
				mask = "gfx/portraits/portrait_mask_head_small.dds" effectname = "NoHighlight"
			}
			text_single = {
				position = { -6 100 } size = { 100 22 }
				text = "[SelectLocalization( Character.IsValid, 'WJ_UI_SHORT_NAME_VALID', '' )]"
				fontsize = 14 align = center|nobaseline autoresize = no
			}
			block "person_actions" {}
		}
		text_single = {
			position = { -6 100 } size = { 100 22 }
			block "vacant_visible" { visible = "[Not(And(Character.IsValid, And(Character.IsAlive, ObjectsEqual(Character.GetTopLiege, CouncilWindow.GetCharacter))))]" }
			block "vacant_text" { text = WJ_baiguan_text_vacant }
			fontsize = 14 default_format = "#weak" align = center|nobaseline autoresize = no
		}
		text_single = {
			position = { -6 78 } size = { 100 22 }
			block "office_label" { text = WJ_baiguan_text_vacant }
			fontsize = 16 default_format = "#high" align = center|nobaseline autoresize = no
		}
		block "appointment" {}
	}
	type hd_dragon_council_slot = hd_dragon_person_slot {
		size = { 88 150 }
		blockoverride "vacant_text" {
			text = "[SelectLocalization(GuiCouncilPosition.CanPotentiallySelectCouncillor, 'WJ_baiguan_text_vacant', 'hd_dragon_office_unavailable')]"
		}
		blockoverride "appointment" {
			button_round = {
				position = { 64 52 } size = { 24 24 }
				visible = "[ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter)]"
				enabled = "[GuiCouncilPosition.CanSelectCouncillor]"
				tooltip = "[GuiCouncilPosition.GetSelectCouncillorTooltip]"
				onclick = "[GuiCouncilPosition.SelectCouncillor]"
				button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
			}
		}
		blockoverride "person_actions" {
			button_standard = {
				position = { 4 126 } size = { 80 24 } text = hd_baiguan_mufu
				# This child is evaluated only inside the live-holder parent.
				visible = "[GetScriptedGui('WJ_mufu_own_entry').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
				tooltip = WJ_mufu_own_entry_tt
				onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
				onclick = "[GetScriptedGui('WJ_mufu_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
			}
		}
	}
	type hd_dragon_court_slot = widget {
		size = { 88 122 } allow_outside = yes
		block "court_label" { text_single = {
			position = { -6 78 } size = { 100 22 }
			text = "[CourtPositionType.CalcTriggeredNameNoTooltip(CouncilWindow.GetCharacter)]"
			fontsize = 16 default_format = "#high" align = center|nobaseline autoresize = no
		} }
		widget = {
			size = { 88 122 }
			visible = "[Not(CouncilWindow.GetCharacter.EmploysCourtPositionType(CourtPositionType.Self))]"
			hd_dragon_person_slot = {
				datacontext = "[GetNullCharacter]"
				blockoverride "person_visible" { visible = no }
				blockoverride "vacant_visible" { visible = yes }
				blockoverride "office_label" { text = "" }
				blockoverride "vacant_text" { text = "[SelectLocalization(CourtPositionType.CanHirePosition(CouncilWindow.GetCharacter), 'WJ_baiguan_text_vacant', 'hd_dragon_office_unavailable')]" }
			}
		}
		hbox = {
			size = { 88 122 } ignoreinvisible = yes
			datamodel = "[CouncilWindow.GetCharacter.GetEmployedCourtPositions]"
			item = {
				hd_dragon_person_slot = {
					block "court_match" { visible = no }
					datacontext = "[CourtPosition.GetEmployee]"
					blockoverride "office_label" { text = "" }
					blockoverride "appointment" { button_round = {
						position = { 64 52 } size = { 24 24 }
						visible = "[ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter)]"
						tooltip = COURT_POSITION_REPLACE
						onclick = "[CourtPosition.OpenReplaceWindow]"
						button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
					} }
				}
			}
		}
		button_round = {
			position = { 64 52 } size = { 24 24 }
			visible = "[And(ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter), Not(CouncilWindow.GetCharacter.EmploysCourtPositionType(CourtPositionType.Self)))]"
			enabled = "[CourtPositionType.CanHirePosition(CouncilWindow.GetCharacter)]"
			tooltip = "[SelectLocalization(CourtPositionType.CanHirePosition(CouncilWindow.GetCharacter), 'hd_dragon_appoint_tt', 'hd_dragon_office_unavailable_tt')]"
			onclick = "[CourtPositionType.OpenAppointWindow(CouncilWindow.GetCharacter)]"
			button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
		}
	}
	type hd_dragon_navigation_button = button_standard {
		size = { 64 62 }
		buttonText = { text_single = {
			size = { 100% 100% } autoresize = no margin = { 4 0 }
			fontsize = 16 align = center|nobaseline default_format = "#clickable" alwaystransparent = yes
		} }
	}
}

window = {
	name = "hd_baiguan_dragon_window"
	# Keep native drag coordinates unscaled; only the ordinary content canvas scales.
	size = "[FloatToCVector2f(Multiply_float('(float)1747', ScaleToFitElementInside('(int32)1800', '(int32)1040')), Multiply_float('(float)984', ScaleToFitElementInside('(int32)1800', '(int32)1040')))]"
	parentanchor = center widgetanchor = center layer = windows_layer alwaystransparent = no
	using = Window_Movable
	allow_outside = yes
	enabled = "[Not(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End))]"
	datacontext = "[AccessCouncilWindow]"
	# Never pass a missing council owner to a character-scoped scripted GUI.
	visible = "[And(GetVariableSystem.HasValue('hd_baiguan_visibility', 'true'), And(CouncilWindow.GetCharacter.IsValid, Not(Or(IsGameViewOpen('barbershop'), GetVariableSystem.HasValue('court_scene', 'yes')))))]"
	state = { name = _show using = Animation_FadeIn_Quick using = Sound_WindowShow_Standard }
	state = {
		name = _hide using = Animation_FadeOut_Quick using = Sound_WindowHide_Standard
	}
	widget = {
		name = "hd_dragon_canvas"
		size = { 1747 984 } alwaystransparent = yes
		parentanchor = top|left widgetanchor = top|left position = { 0 0 }
		scale = "[ScaleToFitElementInside('(int32)1800', '(int32)1040')]"
		visible = "[GetScriptedGui('hd_baiguan_open_effect').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
		# The root owns movement and context; only explicit close actions change the open toggle.
		icon = {
			name = "hd_dragon_background" position = { 0 11 } size = { 1747 962 }
			texture = "gfx/interface/hd_baiguan/ui1.png" alwaystransparent = yes
		}
		button_close = {
			position = { 1610 282 } size = { 32 32 } tooltip = CLOSE_TOOLTIP
			shortcut = "[Select_CString(Or(GetScriptedGui('hd_mufu_open_state').IsShown(GuiScope.AddScope('hd_gui_player', GetPlayer.MakeScope).End), Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page'))), '', 'close_window')]"
			onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
			onclick = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
		}
		portrait_button = {
			name = "hd_dragon_emperor" position = { 765.6 27.4 } size = { 228.8 262.6 }
			enabled = "[Not(Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page')))]"
			datacontext = "[CouncilWindow.GetCharacter]" using = portrait_base
			portrait_texture = "[Character.GetAnimatedPortrait('environment_torso', 'camera_torso', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			mask = "gfx/portraits/portrait_mask_torso.dds" effectname = "NoHighlight"
		}
		widget = {
			name = "hd_dragon_display_sync" size = { 0 0 } alwaystransparent = yes
			visible = "[Not(GetScriptedGui('WJ_baiguan_display_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]"
			state = { name = _show on_start = "[GetScriptedGui('hd_baiguan_rebuild_effect').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]" }
		}
		widget = {
			name = "hd_dragon_overview" size = { 1747 984 } alwaystransparent = yes
			enabled = "[Not(Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page')))]"
			visible = "[Not(GetVariableSystem.Exists('WJ_baiguan_page'))]"
			hd_dragon_person_slot = {
				name = "hd_dragon_regent" position = { 746 312 }
				datacontext = "[CouncilWindow.GetCharacter.GetDiarchy.GetDiarch]"
				blockoverride "office_label" { text = hd_baiguan_office_she_zheng }
				blockoverride "person_visible" { visible = "[And(CouncilWindow.GetCharacter.HasActiveDiarchy, And(Character.IsValid, Character.IsAlive))]" }
				blockoverride "vacant_visible" { visible = "[Not(And(CouncilWindow.GetCharacter.HasActiveDiarchy, And(Character.IsValid, Character.IsAlive)))]" }
			}
			hd_dragon_person_slot = {
				name = "hd_dragon_heir" position = { 842 312 }
				datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_crown_prince').Char]"
				blockoverride "office_label" { text = hd_baiguan_office_tai_zi }
				blockoverride "person_visible" { visible = "[GetScriptedGui('hd_dragon_heir_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]" }
				blockoverride "vacant_visible" { visible = "[Not(GetScriptedGui('hd_dragon_heir_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
				blockoverride "vacant_text" { text = WJ_baiguan_text_undesignated }
			}
			hd_dragon_person_slot = {
				name = "hd_dragon_empress" position = { 938 312 }
				datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_empress').Char]"
				blockoverride "office_label" { text = hd_baiguan_office_huang_hou }
				blockoverride "person_visible" { visible = "[GetScriptedGui('hd_dragon_empress_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]" }
				blockoverride "vacant_visible" { visible = "[Not(GetScriptedGui('hd_dragon_empress_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
			}
			# Inner court: the current honor, two native council positions and two court positions.
			hd_dragon_person_slot = {
				name = "hd_dragon_dasima" position = { 280 450 }
				datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_dasima_holder').Char]"
				blockoverride "office_label" { text = hd_baiguan_office_da_si_ma }
				blockoverride "person_visible" { visible = "[GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]" }
				blockoverride "vacant_visible" { visible = "[Not(GetScriptedGui('hd_dragon_dasima_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
				blockoverride "appointment" { button_round = {
					position = { 64 52 } size = { 24 24 }
					visible = "[ObjectsEqual(GetPlayer, CouncilWindow.GetCharacter)]"
					enabled = "[GetScriptedGui('WJ_dasima_open_picker').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = WJ_inner_select_dasima
					onclick = "[GetScriptedGui('WJ_dasima_open_picker').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					button_change = { parentanchor = center size = { 18 18 } alwaystransparent = yes }
				} }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_general" position = { 390 450 }
				datacontext = "[CouncilWindow.GetCouncillor('minister_grand_marshal')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_grand_marshal }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_personnel" position = { 500 450 }
				datacontext = "[CouncilWindow.GetCouncillor('minister_personnel')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_shangshuling }
				blockoverride "person_actions" {}
			}
			hd_dragon_court_slot = {
				name = "hd_dragon_shizhong" position = { 325 604 }
				datacontext = "[GetCourtPositionType('favored_minister_court_position')]"
				blockoverride "court_match" { visible = "[ObjectsEqual(CourtPosition.GetPositionType, GetCourtPositionType('favored_minister_court_position'))]" }
			}
			hd_dragon_court_slot = {
				name = "hd_dragon_eunuch" position = { 435 604 }
				datacontext = "[GetCourtPositionType('chief_eunuch_court_position')]"
				blockoverride "court_match" { visible = "[ObjectsEqual(CourtPosition.GetPositionType, GetCourtPositionType('chief_eunuch_court_position'))]" }
			}
			# Outer court: preserve the exact council-position mapping used by the existing page.
			hd_dragon_council_slot = {
				name = "hd_dragon_taifu" position = { 1260 434 }
				datacontext = "[CouncilWindow.GetCouncillor('WJ_minister_tai_fu')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_taifu }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_chengxiang" position = { 1390 434 }
				datacontext = "[CouncilWindow.GetCouncillor('WJ_minister_cheng_xiang')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_chengxiang }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_situ" position = { 850 586 }
				datacontext = "[CouncilWindow.GetCouncillor('councillor_chancellor')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_situ }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_sikong" position = { 950 586 }
				datacontext = "[CouncilWindow.GetCouncillor('councillor_spymaster')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_sikong }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_taiwei" position = { 1050 586 }
				datacontext = "[CouncilWindow.GetCouncillor('councillor_marshal')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_taiwei }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_taichang" position = { 1150 586 }
				datacontext = "[CouncilWindow.GetCouncillor('councillor_court_chaplain')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_taichang }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_taipu" position = { 1250 586 }
				datacontext = "[CouncilWindow.GetCouncillor('minister_works')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_taipu }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_dasinong" position = { 1350 586 }
				datacontext = "[CouncilWindow.GetCouncillor('councillor_steward')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_dasinong }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_tingwei" position = { 1450 586 }
				datacontext = "[CouncilWindow.GetCouncillor('minister_justice')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_tingwei }
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_zongzheng" position = { 1270 738 } size = { 88 122 }
				datacontext = "[CouncilWindow.GetCouncillor('WJ_minister_zong_zheng')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_zongzheng }
				blockoverride "person_actions" {}
			}
			hd_dragon_council_slot = {
				name = "hd_dragon_guangluxun" position = { 1170 738 } size = { 88 122 }
				datacontext = "[CouncilWindow.GetCouncillor('WJ_minister_guang_lu_xun')]"
				datacontext = "[GuiCouncilPosition.GetActiveCouncilTask]"
				datacontext = "[ActiveCouncilTask.GetPositionType]"
				datacontext = "[ActiveCouncilTask.GetCouncillor]"
				blockoverride "office_label" { text = WJ_baiguan_label_guangluxun }
				blockoverride "person_actions" {}
			}
			hd_dragon_person_slot = {
				name = "hd_dragon_capital" position = { 1370 738 }
				datacontext = "[CouncilWindow.GetCharacter.MakeScope.Var('wj_baiguan_capital_governor').Char]"
				blockoverride "office_label" { text = hd_dragon_capital_short }
				blockoverride "person_visible" { visible = "[GetScriptedGui('hd_dragon_capital_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]" }
				blockoverride "vacant_visible" { visible = "[Not(GetScriptedGui('hd_dragon_capital_current').IsShown(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End))]" }
				tooltip = WJ_baiguan_label_capital_governor
			}
			button_standard = {
				position = { 504 576 } size = { 80 24 } text = WJ_baiguan_text_kaoke
				visible = "[GetScriptedGui('WJ_kaoke_court_table_open').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_kaoke_court', CouncilWindow.GetCharacter.MakeScope).End)]"
				onclick = "[GetVariableSystem.Clear('hd_baiguan_visibility')]"
				onclick = "[GetScriptedGui('WJ_kaoke_court_table_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wj_kaoke_court', CouncilWindow.GetCharacter.MakeScope).End)]"
				tooltip = WJ_kaoke_table_help
			}
			# Preserve the explicit pause on the existing establishment decision.
			button_standard = {
				position = { 280 864 } size = { 145 32 }
				datacontext = "[GetDecisionWithKey('wj_create_cheng_xiang_decision')]"
				text = "[Decision.GetTitleForPlayer]" visible = no enabled = no
				onclick = "[OpenGameViewData('decision_detail', Decision.Self)]"
			}
		}
		# Navigation stays enabled while secondary windows disable the officer content.
		widget = {
			name = "hd_dragon_navigation" position = { 1561 352 } size = { 64 412 }
			hd_dragon_navigation_button = {
				position = { 0 0 } size = { 64 62 } text = hd_dragon_overview
				down = "[And(Not(GetVariableSystem.Exists('WJ_baiguan_page')), Not(Or(GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true'), GetVariableSystem.Exists('hd_secondary_royal_page'))))]"
				onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
				onclick = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
				onclick = "[GetScriptedGui('hd_baiguan_rebuild_effect').Execute(GuiScope.SetRoot(CouncilWindow.GetCharacter.MakeScope).End)]"
				onclick = "[GetVariableSystem.Clear('WJ_baiguan_page')]"
			}
			hd_dragon_navigation_button = {
				position = { 0 70 } size = { 64 62 } text = WJ_baiguan_tab_army
				down = "[GetVariableSystem.HasValue('hd_secondary_army_visibility', 'true')]"
				onclick = "[GetScriptedGui('WJ_mt_ui_central').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetVariableSystem.Clear('hd_secondary_royal_page')]"
				onclick = "[GetVariableSystem.Set('hd_secondary_army_visibility', 'true')]"
			}
			hd_dragon_navigation_button = {
				position = { 0 140 } text = WJ_baiguan_tab_nobles
				down = "[GetVariableSystem.HasValue('hd_secondary_royal_page', 'nobles')]"
				onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
				onclick = "[GetVariableSystem.Set('hd_secondary_royal_page', 'nobles')]"
			}
			hd_dragon_navigation_button = {
				position = { 0 210 } text = WJ_baiguan_tab_clan
				down = "[GetVariableSystem.HasValue('hd_secondary_royal_page', 'clan')]"
				onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
				onclick = "[GetVariableSystem.Set('hd_secondary_royal_page', 'clan')]"
			}
			hd_dragon_navigation_button = {
				position = { 0 280 } text = WJ_baiguan_tab_harem
				down = "[GetVariableSystem.HasValue('hd_secondary_royal_page', 'harem')]"
				onclick = "[GetVariableSystem.Clear('hd_secondary_army_visibility')]"
				onclick = "[GetVariableSystem.Set('hd_secondary_royal_page', 'harem')]"
			}
		}
	}
}
