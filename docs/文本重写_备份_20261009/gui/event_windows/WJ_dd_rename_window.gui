# Reuse the existing event window, as vanilla scheme_successful_event does.
# Only the two district rename events use this variant: option 0 confirms;
# option 1 cancels without effects, even when the text controller is invalid.
WJ_miaoshi_minor_window = {
	name = "WJ_dd_rename_window"
	blockoverride "WJ_minor_option_enabled" {
		enabled = "[Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), EventOption.IsValid)]"
	}
	blockoverride "WJ_minor_scroll_option_enabled" {
		enabled = "[Or(EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), EventOption.IsValid)]"
	}
}
