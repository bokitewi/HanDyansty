# Tianjia's multi-column option-list pattern, using existing native event buttons.
# Only WJ military-rank picker events select this window; no title-grant mechanics.
window = {
	name = "WJ_mr_selection_window"
	parentanchor = center
	widgetanchor = center
	size = { 1120 750 }
	layer = events
	datacontext = "[EventWindow.AccessEventWindowData]"
	enabled = "[EventWindow.IsOnTop]"
	using = Event_Window_Debug_EventTools
	state = { name = show trigger_on_create = yes using = Animation_FadeIn_Standard on_start = "[GetVariableSystem.Clear( 'event_window_mouse_leave' )]" }
	state = { name = _mouse_hierarchy_leave on_start = "[GetVariableSystem.Set( 'event_window_mouse_leave', 'true' )]" }
	event_window_dimmer_widget = {}
	widget = { size = { 100% 100% } using = Window_Background using = Window_Decoration_Frontend_Flat }
	event_window_background_widget = { margin = { 20 20 } }
	portrait_event = {
		name = "portrait_left"
		datacontext = "[EventWindowData.GetPortraitCharacter('left_portrait')]"
		visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
		parentanchor = bottom|right
		position = { -5 -20 }
		size = { 310 550 }
		blockoverride "portrait_button" {
			size = { 310 550 }
			portrait_texture = "[EventWindowData.GetAnimatedEventPortraitTexture('left_portrait', 'camera_event_left', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			tooltip_visible = "[EventWindowData.ShouldShowPortraitInfo('left_portrait')]"
			using = tooltip_es
		}
	}
	text_single = { position = { 35 24 } size = { 1050 42 } text = "[EventWindowData.GetTitle]" fontsize = 29 fontsize_min = 20 default_format = "#high" }
	text_multi = { position = { 35 80 } size = { 750 140 } max_width = 750 text = "[EventWindowData.GetDescription]" fontsize = 18 }
	scrollbox = {
		name = "WJ_mr_all_options"
		position = { 30 232 }
		size = { 780 485 }
		blockoverride "scrollbox_content" {
			fixedgridbox = {
				name = "option_grid"
				addcolumn = 152
				addrow = 50
				datamodel = "[EventWindowData.GetOptions]"
				datamodel_wrap = 5
				item = {
					SanGong_button_eventoption = {
						blockoverride "button_size" { size = { 148 48 } }
					}
				}
			}
		}
	}
}
