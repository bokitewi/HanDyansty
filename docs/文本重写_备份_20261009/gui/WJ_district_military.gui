# Embedded in the native military window; no extra floating window.
types WJDistrictMilitary {
 type WJ_dd_military_page = vbox {
  layoutpolicy_horizontal = expanding
  layoutpolicy_vertical = expanding
  spacing = 8
  background = {
   texture = "gfx/interface/skinned/illustrations/moving.dds"
   alpha = 0.25
   modify_texture = { texture = "gfx/interface/component_masks/mask_fade_vertical.dds" blend_mode = alphamultiply }
  }
  state = { name = _show on_start = "[GetVariableSystem.Set('wj_dd_page_visible', 'yes')]" }
  state = { name = _hide on_start = "[GetVariableSystem.Clear('wj_dd_page_visible')]" }
  hbox = {
   layoutpolicy_horizontal = expanding spacing = 8
   button_standard = {
    layoutpolicy_horizontal = expanding size = { 0 32 } text = wj_dd_petition_create_player
    visible = "[GetPlayer.GetTopLiege.IsPlayerInteractionShown('wj_dd_petition_create_player')]"
    enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetPlayer.GetTopLiege.IsPlayerInteractionValid('wj_dd_petition_create_player'))]"
    tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetPlayer.GetTopLiege.GetPlayerInteractionTooltip('wj_dd_petition_create_player'), Localize('WJ_zw_takeover_notice'))]"
    onclick = "[GetPlayer.GetTopLiege.OpenPlayerInteraction('wj_dd_petition_create_player')]"
   }

  }

  scrollbox = {
   layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
   blockoverride "scrollbox_content" {
    vbox = {
     layoutpolicy_horizontal = expanding spacing = 12
     text_multi = {
      layoutpolicy_horizontal = expanding text = WJ_dd_ui_empty
      visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_dd_ui_cores'))]"
     }
     vbox = {
      layoutpolicy_horizontal = expanding spacing = 16
      datamodel = "[GetPlayer.MakeScope.GetList('wj_dd_ui_cores')]"
      item = {
       vbox = {
        datacontext = "[Scope.Title]"
        datacontext = "[Title.GetHolder]"
        layoutpolicy_horizontal = expanding spacing = 6
        visible = "[GetScriptedGui('WJ_dd_ui_row_valid').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
        background = { using = Background_Area_Dark_Border }
        state = {
         name = district_live_people trigger_on_create = yes duration = 3 next = district_live_people
         on_start = "[GetScriptedGui(Select_CString(GetVariableSystem.Exists('wj_dd_page_visible'), 'WJ_dd_ui_people_refresh', 'WJ_dd_ui_noop')).Execute(GuiScope.SetRoot(Character.MakeScope).End)]"
        }
        hbox = {
         name = "district_header"
         layoutpolicy_horizontal = expanding size = { 0 40 } spacing = 8
         background = { using = Background_Area_Dark }
         widget = {
          name = "district_header_order" size = { 136 40 }
          button_standard = {
           parentanchor = center size = { 132 32 } text = WJ_conquest_commission_interaction
           visible = "[GetScriptedGui('WJ_dd_ui_conquest').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor', GetPlayer.MakeScope).AddScope('recipient', Character.MakeScope).End)]"
           enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('WJ_conquest_commission_interaction'))]"
           tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('WJ_conquest_commission_interaction'), Localize('WJ_zw_takeover_notice'))]"
           onclick = "[Character.OpenPlayerInteraction('WJ_conquest_commission_interaction')]"
          }
          button_standard = {
           parentanchor = center size = { 132 32 } text = wj_dd_petition_expand_player
           visible = "[And(ObjectsEqual(Character.Self, GetPlayer), GetPlayer.GetTopLiege.IsPlayerInteractionShown('wj_dd_petition_expand_player'))]"
           enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetPlayer.GetTopLiege.IsPlayerInteractionValid('wj_dd_petition_expand_player'))]"
           tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetPlayer.GetTopLiege.GetPlayerInteractionTooltip('wj_dd_petition_expand_player'), Localize('WJ_zw_takeover_notice'))]"
           onclick = "[GetPlayer.GetTopLiege.OpenPlayerInteraction('wj_dd_petition_expand_player')]"
          }
         }
         widget = {
          name = "district_header_name" size = { 0 40 } layoutpolicy_horizontal = expanding
          text_multi = {
           size = { 100% 40 } autoresize = no fontsize = 16 align = center
           text = WJ_dd_ui_district_name tooltip = WJ_dd_ui_district_full
          }
         }
         widget = {
          name = "district_header_rename" size = { 36 40 }
          button_edit_text = {
           button_ignore = none
          enabled = "[GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
           parentanchor = center size = { 30 30 }
           visible = "[GetScriptedGui('WJ_dd_ui_rename').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('head', Character.MakeScope).End)]"
           onclick = "[GetScriptedGui('WJ_dd_ui_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('head', Character.MakeScope).End)]"
           onrightclick = "[GetScriptedGui('WJ_dd_ui_reset_name').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('head', Character.MakeScope).End)]"
           tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('WJ_dd_rename_controls'), Localize('WJ_zw_takeover_notice'))]"
          }
         }
        }
        hbox = {
         layoutpolicy_horizontal = expanding spacing = 8 margin = { 8 8 }
         background = { using = Background_Area_Light }
         portrait_head = {}
         vbox = {
          layoutpolicy_horizontal = expanding spacing = 6
          # 保持已确认的卡片宽高，不从文字反向测量父容器宽度；浮窗提供全称。
          textbox = {
           name = "WJ_dd_head_full_name"
           using = Font_Type_Standard default_format = "#medium" multiline = yes align = top|left
           layoutpolicy_horizontal = expanding size = { 0 52 }
           text = "[Character.Custom('WJ_GetUIName')]"
           tooltip = "[Character.Custom('WJ_GetUIName')]"
           alwaystransparent = no
           fontsize = 18 fontsize_min = 17 autoresize = no
          }
          text_single = { text = WJ_dd_ui_skills }
          text_single = { text = "[Character.GetPrimaryTitle.GetNameNoTooltip]" }
          text_single = { text = WJ_dd_ui_strength }
          text_single = { text = "REALM_WINDOW_SIZE" tooltip = "REALM_WINDOW_SIZE_TT" }
         }
         vbox = {
          size = { 110 0 } layoutpolicy_vertical = preferred spacing = 3
          widget = {
           size = { 110 92 }
           coa_title_small_crown = {
            datacontext = "[Character.GetPrimaryTitle]" parentanchor = center
            blockoverride "coa_button" { onclick = "[OpenAdminVassalDetailView(Title.Self)]" }
           }
          }
          text_multi = { size = { 110 30 } text = "[Character.GetPrimaryTitle.GetNameNoTooltip]" align = center fontsize = 14 autoresize = no }
          button_standard = {
           name = "WJ_dd_dispatch_own_war"
           size = { 110 30 } text = WJ_dd_ui_dispatch_own
           visible = "[And(ObjectsEqual(Character.Self, GetPlayer), Character.IsPlayerInteractionShown('wj_dd_deploy_aid_interaction'))]"
           enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('wj_dd_deploy_aid_interaction'))]"
           tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('wj_dd_deploy_aid_interaction'), Localize('WJ_zw_takeover_notice'))]"
           onclick = "[Character.OpenPlayerInteraction('wj_dd_deploy_aid_interaction')]"
          }
          button_standard = {
           size = { 110 30 } text = wj_dd_qinwang_interaction
           visible = "[Character.IsPlayerInteractionShown('wj_dd_qinwang_interaction')]"
           enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('wj_dd_qinwang_interaction'))]"
           tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('wj_dd_qinwang_interaction'), Localize('WJ_zw_takeover_notice'))]"
           onclick = "[Character.OpenPlayerInteraction('wj_dd_qinwang_interaction')]"
          }
         }
        }
        hbox = {
         layoutpolicy_horizontal = expanding spacing = 0 margin = { 4 4 }
         background = { using = Background_Area_Light }
         WJ_dd_contract_liege_strip = {}
         WJ_dd_contract_self_strip = {}
         WJ_dd_vertical_separator = {}
         button_standard = {
          enabled = "[GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          size = { 120 32 } text = WJ_dd_ui_officers
          visible = "[GetScriptedGui('WJ_dd_ui_officers_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('head', Character.MakeScope).End)]"
          onclick = "[GetScriptedGui('WJ_dd_ui_officers_access').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('head', Character.MakeScope).End)]"
          tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('WJ_dd_ui_officers_help'), Localize('WJ_zw_takeover_notice'))]"
         }
        }
        hbox = {
         layoutpolicy_horizontal = expanding spacing = 6
         visible = "[GetScriptedGui('WJ_dd_ui_emperor').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
         button_standard = {
          tooltip = "[GetScriptedGui('WJ_dd_ui_not_superseded').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          enabled = "[GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          layoutpolicy_horizontal = expanding size = { 0 32 } text = WJ_dd_ui_manage
          onclick = "[Character.OpenPlayerInteraction('wj_dd_manage_interaction')]"
         }
         button_standard = {
          tooltip = "[GetScriptedGui('WJ_dd_ui_not_superseded').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          enabled = "[GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          size = { 100 32 } text = WJ_dd_ui_dissolve
          onclick = "[Character.OpenPlayerInteraction('wj_dd_dissolve_interaction')]"
         }
        }
        dynamicgridbox = {
         datamodel_wrap = 3
         flipdirection = yes
         datamodel = "[Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_members')]"
         item = {
          widget = {
           datacontext = "[Scope.Title]"
           size = { 158 190 }
           vbox = {
           size = { 150 182 } spacing = 4 margin = { 4 4 }
           background = { using = Background_Area_Light }
           text_single = { layoutpolicy_horizontal = expanding text = "[Title.GetNameNoTooltip]" align = center autoresize = yes }
           widget = {
            size = { 142 92 }
            coa_title_small_crown = {
             parentanchor = center
             blockoverride "coa_button" {
              onclick = "[OpenAdminVassalDetailView( Title.Self )]"
             }
            }
           }
           text_single = {
            text = "TITLE_TROOPS_MAPMODE_EXTRA_CURRENT_ARMY_SIZE"
            visible = "[Title.CanHaveTroops]"
            tooltip = "TITLE_TROOPS_MAPMODE_TOOLTIP_CURRENT_ARMY_SIZE"
           }
           text_single = { text = WJ_dd_ui_no_title_troops visible = "[Not(Title.CanHaveTroops)]" }
           button_standard = {
          tooltip = "[GetScriptedGui('WJ_dd_ui_not_superseded').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          enabled = "[GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            size = { 142 30 } text = WJ_dd_ui_province
            onclick = "[OpenAdminVassalDetailView( Title.Self )]"
           }
           }
          }
         }
        }
        text_single = {
         layoutpolicy_horizontal = expanding size = { 0 36 }
         text = WJ_dd_ui_warring_officers using = Font_Size_Medium align = center
         tooltip = WJ_dd_ui_defenders_help
         background = { using = Background_Area_Dark }
         visible = "[Not(IsDataModelEmpty(Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_defenders')))]"
        }
        vbox = {
         layoutpolicy_horizontal = expanding spacing = 4
         datamodel = "[Character.GetPrimaryTitle.MakeScope.GetList('wj_dd_ui_defenders')]"
         item = {
          vbox = {
           name = "WJ_dd_warring_officer_card"
           datacontext = "[Scope.Char]" layoutpolicy_horizontal = expanding spacing = 6
           background = { using = Background_Area_Dark }
           hbox = {
            name = "WJ_dd_warring_officer_header"
            layoutpolicy_horizontal = expanding size = { 0 102 } spacing = 8
            widget = {
             name = "WJ_dd_warring_officer_identity"
             layoutpolicy_horizontal = expanding size = { 0 102 }
             portrait_head_small = { position = { 6 6 } }
             text_single = { position = { 92 8 } size = { 290 28 } text = "[Character.Custom('WJ_GetUIName')]" tooltip = "[Character.Custom('WJ_GetUIName')]" autoresize = no fontsize_min = 13 }
             widget = {
              position = { 92 43 } size = { 30 30 }
              coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.6 }
             }
             WJ_luzhi_glyph = { position = { 130 44 } size = { 28 28 } tooltip = "[Character.Custom('WJ_BandWordPlain')]" }
             text_single = { position = { 92 76 } size = { 290 24 } text = WJ_dd_ui_officer_strength autoresize = no }
            }
            vbox = {
             name = "WJ_dd_warring_officer_actions"
             size = { 130 102 } spacing = 4
             button_standard = {
              name = "WJ_dd_stop_attacker_war"
              size = { 130 30 } text = stop_attacker_vassal_war_interaction
              visible = "[Character.IsPlayerInteractionShown('stop_attacker_vassal_war_interaction')]"
              enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('stop_attacker_vassal_war_interaction'))]"
              tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('stop_attacker_vassal_war_interaction'), Localize('WJ_zw_takeover_notice'))]"
              onclick = "[Character.OpenPlayerInteraction('stop_attacker_vassal_war_interaction')]"
             }
             button_standard = {
              name = "WJ_dd_request_central_aid"
              size = { 130 30 }
              text = "CELESTIAL_REQUEST_MILITARY_AID_NAME"
              visible = "[And(ObjectsEqual(Character.Self, GetPlayer), And(GetScriptedGui('WJ_dd_ui_row_valid').IsShown(GuiScope.SetRoot(Character.MakeScope).End), Character.GetTopLiege.IsPlayerInteractionShown('celestial_request_military_aid_interaction')))]"
              enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetTopLiege.IsPlayerInteractionValid('celestial_request_military_aid_interaction'))]"
              onclick = "[Character.GetTopLiege.OpenPlayerInteraction('celestial_request_military_aid_interaction')]"
              tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetTopLiege.GetPlayerInteractionTooltip('celestial_request_military_aid_interaction'), Localize('WJ_zw_takeover_notice'))]"
              using = tooltip_ws
             }
             button_standard = {
              size = { 130 30 } text = wj_dd_deploy_aid_interaction
              visible = "[Character.IsPlayerInteractionShown('wj_dd_deploy_aid_interaction')]"
              enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('wj_dd_deploy_aid_interaction'))]"
              tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('wj_dd_deploy_aid_interaction'), Localize('WJ_zw_takeover_notice'))]"
              onclick = "[Character.OpenPlayerInteraction('wj_dd_deploy_aid_interaction')]"
             }
             button_standard = {
              name = "WJ_dd_join_wars"
              size = { 130 30 } text = wj_dd_join_wars_01
              visible = "[Character.IsPlayerInteractionShown('wj_dd_join_wars_01')]"
              enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('wj_dd_join_wars_01'))]"
              tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('wj_dd_join_wars_01'), Localize('WJ_zw_takeover_notice'))]"
              onclick = "[Character.OpenPlayerInteraction('wj_dd_join_wars_01')]"
             }
             button_standard = {
              size = { 130 30 } text = celestial_send_military_aid_interaction
              visible = "[Character.IsPlayerInteractionShown('celestial_send_military_aid_interaction')]"
              enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('celestial_send_military_aid_interaction'))]"
              tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('celestial_send_military_aid_interaction'), Localize('WJ_zw_takeover_notice'))]"
              onclick = "[Character.OpenPlayerInteraction('celestial_send_military_aid_interaction')]"
             }
            }
           }
           hbox = {
            name = "WJ_dd_main_wars"
            layoutpolicy_horizontal = expanding spacing = 6
            visible = "[Not(IsDataModelEmpty(Character.MakeScope.GetList('wj_dd_ui_main_wars')))]"
            widget = {
             size = { 28 60 } layoutpolicy_vertical = expanding
             background = { texture = "gfx/interface/colors/white.dds" color = { 0.141 0.155 0.177 1 } }
             text_single = { parentanchor = center text = WJ_dd_ui_main_label }
            }
            vbox = {
             layoutpolicy_horizontal = expanding
             background = { using = Background_Area_Light color = { 0.35 0.21 0.12 1 } }
             dynamicgridbox = {
              datamodel = "[Character.MakeScope.GetList('wj_dd_ui_main_wars')]" datamodel_wrap = 9 flipdirection = yes
              item = { WJ_dd_war_side_icon = {} }
             }
            }
           }
           hbox = {
            name = "WJ_dd_support_wars"
            layoutpolicy_horizontal = expanding spacing = 6
            visible = "[Not(IsDataModelEmpty(Character.MakeScope.GetList('wj_dd_ui_support_wars')))]"
            widget = {
             size = { 28 60 } layoutpolicy_vertical = expanding
             background = { texture = "gfx/interface/colors/white.dds" color = { 0.141 0.155 0.177 1 } }
             text_single = { parentanchor = center text = WJ_dd_ui_support_label }
            }
            vbox = {
             layoutpolicy_horizontal = expanding
             background = { using = Background_Area_Light color = { 0.17 0.25 0.34 1 } }
             dynamicgridbox = {
              datamodel = "[Character.MakeScope.GetList('wj_dd_ui_support_wars')]" datamodel_wrap = 9 flipdirection = yes
              item = { WJ_dd_war_side_icon = {} }
             }
            }
           }
          }
         }
        }
        hbox = {
         layoutpolicy_horizontal = expanding spacing = 6
         button_standard = {
          layoutpolicy_horizontal = expanding size = { 0 32 } text = wj_dd_request_aid_interaction
          visible = "[Character.IsPlayerInteractionShown('wj_dd_request_aid_interaction')]"
          enabled = "[And(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.IsPlayerInteractionValid('wj_dd_request_aid_interaction'))]"
          tooltip = "[Select_CString(GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Character.GetPlayerInteractionTooltip('wj_dd_request_aid_interaction'), Localize('WJ_zw_takeover_notice'))]"
          onclick = "[Character.OpenPlayerInteraction('wj_dd_request_aid_interaction')]"
         }
        }
       }
      }
     }
     button_standard = {
          tooltip = "[GetScriptedGui('WJ_dd_ui_not_superseded').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          enabled = "[GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      layoutpolicy_horizontal = expanding size = { 0 42 } text = WJ_dd_ui_create
      visible = "[GetScriptedGui('WJ_dd_ui_emperor').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetScriptedGui('WJ_dd_ui_refresh').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      onclick = "[GetVariableSystem.Toggle('wj_dd_ui_create_list')]"
     }
     vbox = {
      layoutpolicy_horizontal = expanding spacing = 4
      visible = "[And(GetVariableSystem.Exists('wj_dd_ui_create_list'), GetScriptedGui('WJ_dd_ui_emperor').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
      text_multi = { layoutpolicy_horizontal = expanding text = WJ_dd_ui_no_candidates visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('wj_dd_ui_candidates'))]" }
      vbox = {
       layoutpolicy_horizontal = expanding spacing = 5
       datamodel = "[GetPlayer.MakeScope.GetList('wj_dd_ui_candidates')]"
       item = {
        hbox = {
         datacontext = "[Scope.Char]" layoutpolicy_horizontal = expanding spacing = 8
         textbox = {
          name = "WJ_dd_candidate_full_name"
          using = Font_Type_Standard default_format = "#medium" multiline = yes align = top|left
          layoutpolicy_horizontal = expanding size = { 0 46 }
          text = "[Character.Custom('WJ_GetUIName')]"
          tooltip = "[Character.Custom('WJ_GetUIName')]"
          alwaystransparent = no
          fontsize = 15 fontsize_min = 14 autoresize = no
         }
         button_standard = {
          tooltip = "[GetScriptedGui('WJ_dd_ui_not_superseded').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          enabled = "[GetScriptedGui('WJ_dd_ui_not_superseded').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          size = { 100 32 } text = WJ_dd_ui_create
          onclick = "[Character.OpenPlayerInteraction('wj_dd_create_interaction')]"
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
