		}
	}

	type hd_party_widget_ecumenical_innovator = widget {
		size = { 275 350 }

		state = {
			name = _show
			trigger_when = "[DataModelHasItems( ActivityWindow.GetCurrentPhaseGuestSubset( 'innovator' ) )]"
			on_start = "[ActivityWindow.SetAllPhasesGuestSubsetSortingDescending( 'innovator', 'ecumenical_council_innovator_sort_value' )]"
		}

		vbox = {
			layoutpolicy_horizontal = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 0 5 }

				hbox = {
					layoutpolicy_horizontal = expanding

					### TITLE INNOVATORS
					hbox = {
						spacing = 5
						tooltip = "INNOVATOR_WINDOW_LABEL_HOVER"

						text_single = {
							text = "INNOVATOR_WINDOW_LABEL"
							align = nobaseline|hcenter
							using = Font_Type_Flavor
							fontsize_min = 16
							fontsize = 22
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							autoresize = yes
						}

						text_single = {
							text = "[ActivityWindow.GetCurrentPhaseSubsetSizeLabel( 'innovator' )]"
							align = nobaseline|hcenter
							fontsize_min = 16
							fontsize = 22
							autoresize = yes
						}
					}

					background = {
						using = Mask_Rough_Edges
						alpha = 0.8
						margin = { 2 5 }

						texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
						spriteType = Corneredtiled
						spriteborder = { 40 8 }
						texture_density = 2

						modify_texture = {
							name = "mask"
							texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
							spriteType = Corneredstretched
							spriteborder = { 0 0 }
							blend_mode = alphamultiply
							mirror = horizontal
						}
					}
				}

				background = {
					tintcolor = { 0.7 0.8 1 0.8 }
					texture = "gfx/interface/colors/blue.dds"

					using = Mask_Rough_Edges

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
						blend_mode = alphaMultiply
						alpha = 0.5
					}
				}
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_margins"
				{
					margin_top = 15
					margin_bottom = 0
					margin_left = 5
					margin_right = 20
				}

				vbox = {
					visible = "[IsDataModelEmpty( ActivityWindow.GetCurrentPhaseGuestSubset( 'innovator' ) )]"

					text_single = {
						text = "SUPPORT_WINDOW_EMPTY"
						align = nobaseline
					}
				}

				blockoverride "scrollbox_content"
				{
					vbox = {
						fixedgridbox = {
							addcolumn = 85
							addrow = 100
							flipdirection = yes
							datamodel_wrap = 3

							datamodel = "[ActivityWindow.GetCurrentPhaseGuestSubset( 'innovator' )]"
							item = {
								portrait_head_small = {}
							}
						}
					}
				}
			}
		}
	}

