types PeaceDealsExpanded {

	type hd_peace_summary_line_v2 = text_multi {
		using = Font_Size_Tiny
		layoutpolicy_horizontal = expanding
		max_width = 500
		autoresize = yes
		layoutpolicy_vertical = fixed
		default_format = "#high"
		align = top|left
	}

	# Compact, single-column recap. Invisible clauses do not reserve space,
	# which keeps the tooltip readable even for mixed bilateral treaties.
	type hd_peace_treaty_summary_tooltip_v2 = widget {
		alwaystransparent = no
		using = GeneralTooltipSetup

		widget = {
			using = DefaultTooltipBackground
			size = { 100% 100% }
			alwaystransparent = no
		}

		vbox = {
			set_parent_size_to_minimum = yes
			minimumsize = { 500 0 }
			maximumsize = { 500 -1 }
			layoutpolicy_vertical = shrinking
			margin = { 18 14 }
			spacing = 5
			ignoreinvisible = yes

			text_single = { using = Font_Size_Big  text = "hd_peace_summary_title" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#high"  size = { 500 30 } autoresize = no layoutpolicy_vertical = fixed }
			text_multi = {  using = Font_Size_Small  text = "hd_peace_summary_parties" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#low"   max_width = 500 autoresize = yes layoutpolicy_vertical = fixed }
			text_multi = {  using = Font_Size_Medium  text = "hd_peace_summary_outcome_actor_victory" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_result_preview_value'), '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#positive_value"   max_width = 500 autoresize = yes layoutpolicy_vertical = fixed }
			text_multi = {  using = Font_Size_Medium  text = "hd_peace_summary_outcome_actor_defeat" visible = no layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#negative_value"   max_width = 500 autoresize = yes layoutpolicy_vertical = fixed }
			text_multi = {  using = Font_Size_Medium  text = "hd_peace_summary_outcome_white_peace" visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_result_preview_value'), '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#high"   max_width = 500 autoresize = yes layoutpolicy_vertical = fixed }
			divider_light = {  layoutpolicy_horizontal = expanding  size = { 500 2 } layoutpolicy_vertical = fixed }
			text_single = { using = Font_Size_Small  text = "hd_peace_we_demand" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_cost_value'), '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#negative_value"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
			vbox = {
 layoutpolicy_vertical = shrinking
				visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_cost_value'), '(CFixedPoint)0')]"
				layoutpolicy_horizontal = expanding
				spacing = 2
				ignoreinvisible = yes

				vbox = {
 layoutpolicy_vertical = shrinking
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_county_count_value'), '(CFixedPoint)0')]"
					layoutpolicy_horizontal = expanding
					spacing = 1
					text_single = { using = Font_Size_Tiny  text = "hd_peace_summary_demand_land" layoutpolicy_horizontal = expanding default_format = "#high"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
					vbox = {
 layoutpolicy_vertical = shrinking
						datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_demand_counties')]"
						layoutpolicy_horizontal = expanding
						item = {
							text_single = { using = Font_Size_Tiny  datacontext = "[Scope.Title]" text = "hd_peace_summary_county_item" layoutpolicy_horizontal = expanding max_width = 500 default_format = "#low"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
						}
					}
				}
				vbox = {
 layoutpolicy_vertical = shrinking
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_title_count_value'), '(CFixedPoint)0')]"
					layoutpolicy_horizontal = expanding
					spacing = 1
					text_single = { using = Font_Size_Tiny  text = "hd_peace_summary_demand_titles" layoutpolicy_horizontal = expanding default_format = "#high"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
					vbox = {
 layoutpolicy_vertical = shrinking
						datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_demand_titles')]"
						layoutpolicy_horizontal = expanding
						item = {
							text_single = { using = Font_Size_Tiny  datacontext = "[Scope.Title]" text = "hd_peace_summary_title_item" layoutpolicy_horizontal = expanding max_width = 500 default_format = "#low"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
						}
					}
				}
				vbox = {
 layoutpolicy_vertical = shrinking
 visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_release_count_value'), '(CFixedPoint)0')]"
 layoutpolicy_horizontal = expanding
 text_multi = { using = Font_Size_Tiny  autoresize = yes layoutpolicy_vertical = fixed text = "hd_peace_summary_demand_release" layoutpolicy_horizontal = expanding max_width = 500  default_format = "#high" }
 vbox = {
 layoutpolicy_vertical = shrinking
  datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_demand_released_vassals')]"
  layoutpolicy_horizontal = expanding
  item = { text_single = { using = Font_Size_Tiny  datacontext = "[Scope.Char]" text = "[Character.GetTitledFirstName]" layoutpolicy_horizontal = expanding max_width = 500  default_format = "#low" size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed } }
 }
}
hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_gold" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_gold').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_herd" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_herd').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_tribute" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_tribute').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_suzerainty" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_suzerainty').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_claims" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_claims').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_hostage" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_hostage').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_alliances" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_break_alliances').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_humiliation" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_humiliation').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_prisoners" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_prisoner_release').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_conversion" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_conversion').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_demand_disarmament" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_disarmament').GetValue, '(CFixedPoint)0')]" }
			}

			divider_light = {  visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_cost_value'), '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding  size = { 500 2 } layoutpolicy_vertical = fixed }
			text_single = { using = Font_Size_Small  text = "hd_peace_we_offer" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_cost_value'), '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#positive_value"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
			vbox = {
 layoutpolicy_vertical = shrinking
				visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_cost_value'), '(CFixedPoint)0')]"
				layoutpolicy_horizontal = expanding
				spacing = 2
				ignoreinvisible = yes

				vbox = {
 layoutpolicy_vertical = shrinking
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_county_count_value'), '(CFixedPoint)0')]"
					layoutpolicy_horizontal = expanding
					spacing = 1
					text_single = { using = Font_Size_Tiny  text = "hd_peace_summary_offer_land" layoutpolicy_horizontal = expanding default_format = "#high"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
					vbox = {
 layoutpolicy_vertical = shrinking
						datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_offer_counties')]"
						layoutpolicy_horizontal = expanding
						item = {
							text_single = { using = Font_Size_Tiny  datacontext = "[Scope.Title]" text = "hd_peace_summary_county_item" layoutpolicy_horizontal = expanding max_width = 500 default_format = "#low"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
						}
					}
				}
				vbox = {
 layoutpolicy_vertical = shrinking
 visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_release_count_value'), '(CFixedPoint)0')]"
 layoutpolicy_horizontal = expanding
 text_multi = { using = Font_Size_Tiny  autoresize = yes layoutpolicy_vertical = fixed text = "hd_peace_summary_offer_release" layoutpolicy_horizontal = expanding max_width = 500  default_format = "#high" }
 vbox = {
 layoutpolicy_vertical = shrinking
  datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_offer_released_vassals')]"
  layoutpolicy_horizontal = expanding
  item = { text_single = { using = Font_Size_Tiny  datacontext = "[Scope.Char]" text = "[Character.GetTitledFirstName]" layoutpolicy_horizontal = expanding max_width = 500  default_format = "#low" size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed } }
 }
}
hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_gold" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_gold').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_herd" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_herd').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_tribute" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_tribute').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_suzerainty" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_suzerainty').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_claims" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_claims').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_hostage" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_hostage').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_alliances" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_break_alliances').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_humiliation" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_humiliation').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_prisoners" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_prisoner_release').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_conversion" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_conversion').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_offer_disarmament" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_disarmament').GetValue, '(CFixedPoint)0')]" }
			}

			divider_light = {  visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_common_term_value'), '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding  size = { 500 2 } layoutpolicy_vertical = fixed }
			text_single = { using = Font_Size_Small  text = "hd_peace_common_terms" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_common_term_value'), '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#low"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
			vbox = {
 layoutpolicy_vertical = shrinking
				visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_common_term_value'), '(CFixedPoint)0')]"
				layoutpolicy_horizontal = expanding
				spacing = 2
				ignoreinvisible = yes
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_alliance" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_forced_alliance').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_long_truce" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_long_truce').GetValue, '(CFixedPoint)0')]" }
				hd_peace_summary_line_v2 = { text = "hd_peace_summary_extended_truce" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_extended_truce').GetValue, '(CFixedPoint)0')]" }
			}

			divider_light = {  layoutpolicy_horizontal = expanding  size = { 500 2 } layoutpolicy_vertical = fixed }
			text_single = { using = Font_Size_Small  text = "hd_peace_summary_acceptance" layoutpolicy_horizontal = expanding align = left|vcenter default_format = "#high"  size = { 500 22 } autoresize = no layoutpolicy_vertical = fixed }
			text_multi = { using = Font_Size_Tiny  autoresize = yes layoutpolicy_vertical = fixed
				visible = "[Not(GetScriptedGui('hd_peace_send_treaty_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End))]"
				text = "[GetScriptedGui('hd_peace_send_treaty_gui').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End)]"
				layoutpolicy_horizontal = expanding
				max_width = 500
				default_format = "#negative_value"
				
			}
		}
	}


	########## 1.6 interface building blocks ##########

	type hd_peace_ui_cat_term = button_standard_list {
		size = { 258 34 }
		using = tooltip_ws
	}
	type hd_peace_ui_cat_icon = icon {
		size = { 22 22 }
		position = { 8 6 }
		alwaystransparent = yes
	}
	type hd_peace_ui_cat_label = text_single {
		using = Font_Size_Small
		position = { 38 0 }
		size = { 146 34 }
		align = left|vcenter
		default_format = "#clickable"
		autoresize = no
		alwaystransparent = yes
	}
	type hd_peace_ui_cat_cost = text_single {
		using = Font_Size_Tiny
		position = { 184 0 }
		size = { 44 34 }
		align = right|vcenter
		default_format = "#weak"
		autoresize = no
		alwaystransparent = yes
	}
	type hd_peace_ui_cat_check = icon {
		texture = "gfx/interface/icons/symbols/icon_check.dds"
		size = { 18 18 }
		position = { 234 8 }
		alwaystransparent = yes
	}
	type hd_peace_ui_cat_more = icon {
		texture = "gfx/interface/icons/symbols/icon_plus_small.dds"
		size = { 16 16 }
		position = { 235 9 }
		alpha = 0.7
		alwaystransparent = yes
	}
	type hd_peace_ui_cat_section = text_single {
		using = Font_Size_Tiny
		size = { 258 26 }
		margin_left = 4
		align = left|vcenter
		default_format = "#low"
		autoresize = no
	}

	type hd_peace_ui_term_row = button_standard_list {
		size = { 358 32 }
		using = tooltip_ws
	}
	type hd_peace_ui_row_icon = icon {
		size = { 22 22 }
		position = { 8 5 }
		alwaystransparent = yes
	}
	type hd_peace_ui_row_label = text_single {
		using = Font_Size_Small
		position = { 38 0 }
		size = { 196 32 }
		align = left|vcenter
		default_format = "#high"
		autoresize = no
		alwaystransparent = yes
	}
	type hd_peace_ui_row_value = text_single {
		using = Font_Size_Small
		position = { 262 0 }
		size = { 64 32 }
		align = right|vcenter
		default_format = "#high"
		autoresize = no
		alwaystransparent = yes
	}
	type hd_peace_ui_row_remove = icon {
		texture = "gfx/interface/icons/symbols/icon_cross.dds"
		size = { 16 16 }
		position = { 334 8 }
		alpha = 0.6
		alwaystransparent = yes
	}
	type hd_peace_ui_row_edit = icon {
		texture = "gfx/interface/icons/symbols/icon_plus_small.dds"
		size = { 16 16 }
		position = { 334 8 }
		alpha = 0.6
		alwaystransparent = yes
	}

	# Acceptance from -100 to +100, drawn with the native progress bar.
	type hd_peace_ui_acceptance_bar = widget {
		size = { 192 6 }
		progressbar_green = {
			size = { 100% 100% }
			min = 0
			max = 200
			value = "[Subtract_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_deal_acceptance_value'), '(CFixedPoint)-100')]"
			alwaystransparent = yes
		}
		icon = {
			texture = "gfx/interface/colors/gold.dds"
			size = { 2 12 }
			parentanchor = center
			alwaystransparent = yes
		}
	}

	type hd_peace_ui_column_title = text_single {
		using = Font_Size_Small
		position = { 14 4 }
		size = { 260 28 }
		align = left|vcenter
		default_format = "#high"
		autoresize = no
	}

	# 1.6 peace desk: clause catalogue, treaty draft and live evaluation.
	# All artwork and controls are CK3 assets or original Peace Deals Expanded art.
	type hd_peace_negotiated_peace_panel_v2 = vbox {
		name = "hd_peace_negotiated_peace_panel_v2"
		minimumsize = { 940 0 }
		maximumsize = { 940 0 }
		ignoreinvisible = yes

		widget = {
			size = { 940 500 }
			background = { using = Background_Area_Dark }

			# Header
			widget = {
				position = { 8 6 }
				size = { 924 46 }
				background = {
					texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
					spriteType = Corneredtiled
					spriteborder = { 18 18 }
					alpha = 0.85
				}
				icon = { texture = "gfx/interface/icons/character_interactions/scroll_scales.dds" position = { 12 8 } size = { 30 30 } alwaystransparent = yes }
				text_single = { using = Font_Size_Big text = "hd_peace_window_title" position = { 52 0 } size = { 330 46 } align = left|vcenter default_format = "#high" autoresize = no }
				text_single = { using = Font_Size_Small text = "hd_peace_summary_parties" position = { 380 0 } size = { 444 46 } align = right|vcenter default_format = "#low" autoresize = no }
				button_expand = {
					parentanchor = right|vcenter
					position = { -50 0 }
					onclick = "[GetVariableSystem.Set('hd_peace_overview_collapsed', 'true')]"
					tooltip = "hd_peace_collapse_negotiation_tt"
				}
				button_close = {
					parentanchor = right|vcenter
					position = { -10 0 }
					onclick = "[GetVariableSystem.Clear('hd_peace_treaty_collapsed')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_treaty_offer_tab')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_treaty_demand_tab')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_peace_open')]"
					tooltip = "hd_peace_close_negotiation_tt"
				}
			}

			# Direction tabs, with the running value of each side.
			button_tab = {
				position = { 8 58 }
				size = { 460 40 }
				text = "hd_peace_tab_demands"
				down = "[GetVariableSystem.Exists('hd_peace_treaty_demand_tab')]"
				onclick = "[GetVariableSystem.Clear('hd_peace_treaty_offer_tab')]"
				onclick = "[GetVariableSystem.Set('hd_peace_treaty_demand_tab', 'true')]"
				icon = {
					using = Icon_Flat_Standard blockoverride "master_color_frame" { frame = 1 } texture = "gfx/interface/icons/flat_icons/war_outcome_victory.dds"
					size = { 26 26 }
					parentanchor = left|vcenter
					position = { 14 0 }
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_cost_value'), '(CFixedPoint)0')]"
					using = Font_Size_Small
					raw_text = "−[GetPlayer.MakeScope.ScriptValue('hd_peace_demand_cost_value')|0]"
					parentanchor = right|vcenter
					position = { -16 0 }
					size = { 70 30 }
					align = right|vcenter
					default_format = "#negative_value"
					autoresize = no
					alwaystransparent = yes
				}
			}
			button_tab = {
				position = { 472 58 }
				size = { 460 40 }
				text = "hd_peace_tab_offers"
				down = "[GetVariableSystem.Exists('hd_peace_treaty_offer_tab')]"
				onclick = "[GetVariableSystem.Clear('hd_peace_treaty_demand_tab')]"
				onclick = "[GetVariableSystem.Set('hd_peace_treaty_offer_tab', 'true')]"
				icon = {
					using = Icon_Flat_Standard blockoverride "master_color_frame" { frame = 1 } texture = "gfx/interface/icons/flat_icons/war_outcome_defeat.dds"
					size = { 26 26 }
					parentanchor = left|vcenter
					position = { 14 0 }
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_cost_value'), '(CFixedPoint)0')]"
					using = Font_Size_Small
					raw_text = "+[GetPlayer.MakeScope.ScriptValue('hd_peace_offer_cost_value')|0]"
					parentanchor = right|vcenter
					position = { -16 0 }
					size = { 70 30 }
					align = right|vcenter
					default_format = "#positive_value"
					autoresize = no
					alwaystransparent = yes
				}
			}

			# Left: clause catalogue, grouped by kind.
			widget = {
				position = { 8 104 }
				size = { 292 346 }
				background = {
					texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
					spriteType = Corneredtiled
					spriteborder = { 18 18 }
					alpha = 0.7
				}
				hd_peace_ui_column_title = { text = "hd_peace_available_terms" }
				divider_light = { position = { 12 34 } size = { 268 2 } }
				scrollbox = {
					visible = "[GetVariableSystem.Exists('hd_peace_treaty_demand_tab')]"
					position = { 4 40 }
					size = { 284 302 }
					blockoverride "scrollbox_background" {}
					blockoverride "scrollbox_margins" {
						margin_top = 2
						margin_bottom = 8
						margin_left = 6
						margin_right = 18
					}
					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							spacing = 3
							hd_peace_ui_cat_section = { text = "hd_peace_cat_territory" }
							hd_peace_ui_cat_term = {
								datacontext = "[GetScriptedGui('hd_peace_begin_demand_land_selection_gui')]"
