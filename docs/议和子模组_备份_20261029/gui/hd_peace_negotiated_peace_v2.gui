					enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End)]"
					onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End)]"
					onclick = "[GetVariableSystem.Clear('hd_peace_treaty_offer_tab')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_treaty_demand_tab')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_treaty_collapsed')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_peace_open')]"
					tooltipwidget = { hd_peace_treaty_summary_tooltip_v2 = {} }
					using = tooltip_above
				}
			}
		}
	}
}
