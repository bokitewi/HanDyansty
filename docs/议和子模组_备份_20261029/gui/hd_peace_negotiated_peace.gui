types PeaceDealsExpanded {

	type hd_peace_term_icon = icon {
		size = { 26 26 }
		parentanchor = left|vcenter
		position = { 7 0 }
		alwaystransparent = yes
	}

	type hd_peace_clause_tile = button_standard_clean {
		size = { 132 40 }
		using = tooltip_ws
	}

	type hd_peace_catalog_term = button_standard_list {
		size = { 248 38 }
		using = tooltip_ws
	}

	type hd_peace_catalog_icon = icon {
		size = { 22 22 }
		position = { 8 8 }
		alwaystransparent = yes
	}

	type hd_peace_catalog_label = text_single {
		using = Font_Size_Small
		position = { 39 0 }
		size = { 154 38 }
		align = left|vcenter
		default_format = "#clickable"
		autoresize = no
		alwaystransparent = yes
	}

	type hd_peace_catalog_cost = text_single {
		using = Font_Size_Tiny
		position = { 194 0 }
		size = { 46 38 }
		align = right|vcenter
		default_format = "#low"
		autoresize = no
		alwaystransparent = yes
	}

	type hd_peace_selected_term = button_standard_list {
		size = { 348 31 }
		using = tooltip_ws
	}

	type hd_peace_selected_icon = icon {
		size = { 21 21 }
		position = { 7 5 }
		alwaystransparent = yes
	}

	type hd_peace_selected_text = text_single {
		using = Font_Size_Tiny
		position = { 35 0 }
		size = { 302 31 }
		align = left|vcenter
		default_format = "#high"
		autoresize = no
		alwaystransparent = yes
	}

	type hd_peace_territory_tile = button_standard_clean {
		size = { 276 43 }
		using = tooltip_ws
	}

	type hd_peace_gold_step = button_standard_clean {
		size = { 30 30 }
		using = tooltip_ws
	}

	type hd_peace_gold_step_text = text_single {
		using = Font_Size_Tiny
		position = { 0 0 }
		size = { 30 30 }
		align = vcenter|nobaseline|center
		default_format = "#high"
	fontsize_min = 7
		autoresize = no
		alwaystransparent = yes
	}

	# Full proposed-treaty recap shown from the Send Offer button. County names
	# come directly from the two saved title lists, so the recap always matches
	# what will actually be transferred.
	type hd_peace_treaty_summary_tooltip = widget {
		alwaystransparent = no
		using = GeneralTooltipSetup

		widget = {
			using = DefaultTooltipBackground
			size = { 100% 100% }
			alwaystransparent = no
		}

		vbox = {
			set_parent_size_to_minimum = yes
			min_width = 520
			margin = { 18 12 }
			spacing = 6

			text_single = { using = Font_Size_Big  text = "hd_peace_summary_title" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#high"  }
			text_single = { using = Font_Size_Small  text = "hd_peace_summary_parties" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#low"  }
			divider_light = { layoutpolicy_horizontal = expanding }

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 18

				vbox = {
					min_width = 240
					spacing = 3
					text_single = { using = Font_Size_Medium  text = "hd_peace_we_offer" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#positive_value"  }
					vbox = {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_offer_county_count_value'), '(CFixedPoint)0')]"
						layoutpolicy_horizontal = expanding
						text_single = { using = Font_Size_Small  text = "hd_peace_summary_offer_land" layoutpolicy_horizontal = expanding default_format = "#high"  }
						vbox = {
							datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_offer_counties')]"
							layoutpolicy_horizontal = expanding
							item = {
								text_single = { using = Font_Size_Small  datacontext = "[Scope.Title]" text = "hd_peace_summary_county_item" layoutpolicy_horizontal = expanding max_width = 230 default_format = "#low"  }
							}
						}
					}
					text_single = { using = Font_Size_Small  text = "hd_peace_summary_offer_gold" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_gold').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_tribute" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_tribute').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_suzerainty" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_suzerainty').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_claims" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_claims').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_hostage" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_hostage').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_alliances" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_break_alliances').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_humiliation" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_humiliation').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_prisoners" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_prisoner_release').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_conversion" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_conversion').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_offer_disarmament" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_offer_disarmament').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
				}

				vbox = {
					min_width = 240
					spacing = 3
					text_single = { using = Font_Size_Medium  text = "hd_peace_we_demand" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#negative_value"  }
					vbox = {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('hd_peace_demand_county_count_value'), '(CFixedPoint)0')]"
						layoutpolicy_horizontal = expanding
						text_single = { using = Font_Size_Small  text = "hd_peace_summary_demand_land" layoutpolicy_horizontal = expanding default_format = "#high"  }
						vbox = {
							datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_demand_counties')]"
							layoutpolicy_horizontal = expanding
							item = {
								text_single = { using = Font_Size_Small  datacontext = "[Scope.Title]" text = "hd_peace_summary_county_item" layoutpolicy_horizontal = expanding max_width = 230 default_format = "#low"  }
							}
						}
					}
					text_single = { using = Font_Size_Small  text = "hd_peace_summary_demand_gold" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_gold').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_tribute" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_tribute').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_suzerainty" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_suzerainty').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_claims" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_claims').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_hostage" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_hostage').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_alliances" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_break_alliances').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_humiliation" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_humiliation').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_prisoners" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_prisoner_release').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_conversion" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_conversion').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
					text_multi = { using = Font_Size_Small  text = "hd_peace_summary_demand_disarmament" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_demand_disarmament').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding max_width = 240 default_format = "#high"  }
				}
			}

			divider_light = { layoutpolicy_horizontal = expanding }
			text_single = { using = Font_Size_Small  text = "hd_peace_summary_alliance" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_forced_alliance').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#high"  }
			text_single = { using = Font_Size_Small  text = "hd_peace_summary_long_truce" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_long_truce').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#high"  }
			text_single = { using = Font_Size_Small  text = "hd_peace_summary_extended_truce" visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('hd_peace_extended_truce').GetValue, '(CFixedPoint)0')]" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#high"  }
			text_single = { using = Font_Size_Small  text = "hd_peace_summary_acceptance" layoutpolicy_horizontal = expanding align = center|vcenter default_format = "#low"  }
			text_multi = { using = Font_Size_Small 
				visible = "[Not(GetScriptedGui('hd_peace_send_treaty_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End))]"
				text = "[GetScriptedGui('hd_peace_send_treaty_gui').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End)]"
				layoutpolicy_horizontal = expanding
				max_width = 500
				default_format = "#negative_value"
				
			}
		}
	}

	# Territorial picker: eligible counties on the left, current selection and
	# its live effect on acceptance on the right.
	type hd_peace_negotiated_peace_panel = vbox {
		name = "hd_peace_negotiated_peace_panel"
		minimumsize = { 940 0 }
		maximumsize = { 940 0 }
		ignoreinvisible = yes

		widget = {
			name = "hd_peace_land_selection_picker"
			size = { 940 500 }
			background = { using = Background_Area_Dark }

			widget = {
				position = { 8 6 }
				size = { 924 52 }
				background = {
					texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
					spriteType = Corneredtiled
					spriteborder = { 18 18 }
					alpha = 0.85
				}
				icon = { texture = "gfx/interface/icons/character_interactions/revoke_title.dds" visible = "[GetVariableSystem.Exists('hd_peace_land_demand_select')]" position = { 14 11 } size = { 30 30 } alwaystransparent = yes }
				icon = { texture = "gfx/interface/icons/character_interactions/grant_titles_interaction.dds" visible = "[GetVariableSystem.Exists('hd_peace_land_offer_select')]" position = { 14 11 } size = { 30 30 } alwaystransparent = yes }
				text_single = { using = Font_Size_Big text = "hd_peace_map_offer_title" visible = "[GetVariableSystem.Exists('hd_peace_land_offer_select')]" position = { 56 3 } size = { 700 28 } align = left|vcenter default_format = "#positive_value" autoresize = no }
				text_single = { using = Font_Size_Big text = "hd_peace_map_demand_title" visible = "[And(GetVariableSystem.Exists('hd_peace_land_demand_select'), Not(GetVariableSystem.Exists('hd_peace_land_title_select')))]" position = { 56 3 } size = { 700 28 } align = left|vcenter default_format = "#negative_value" autoresize = no }
				text_single = { using = Font_Size_Big text = "hd_peace_map_demand_titles_title" visible = "[And(GetVariableSystem.Exists('hd_peace_land_demand_select'), GetVariableSystem.Exists('hd_peace_land_title_select'))]" position = { 56 3 } size = { 700 28 } align = left|vcenter default_format = "#negative_value" autoresize = no }
				text_single = { using = Font_Size_Tiny text = "hd_peace_territory_picker_subtitle" visible = "[Not(And(GetVariableSystem.Exists('hd_peace_land_demand_select'), GetVariableSystem.Exists('hd_peace_land_title_select')))]" position = { 56 29 } size = { 700 20 } align = left|vcenter default_format = "#low" autoresize = no }
				text_single = { using = Font_Size_Tiny text = "hd_peace_title_picker_subtitle" visible = "[And(GetVariableSystem.Exists('hd_peace_land_demand_select'), GetVariableSystem.Exists('hd_peace_land_title_select'))]" position = { 56 29 } size = { 700 20 } align = left|vcenter default_format = "#low" autoresize = no }
				button_expand = { parentanchor = right|vcenter position = { -50 0 } onclick = "[GetVariableSystem.Set('hd_peace_overview_collapsed', 'true')]" tooltip = "hd_peace_collapse_war_panel_tt" }
				button_close = {
					parentanchor = right|vcenter
					position = { -10 0 }
					onclick = "[GetScriptedGui('hd_peace_end_land_selection_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					onclick = "[GetVariableSystem.Clear('hd_peace_land_offer_select')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_land_demand_select')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_land_title_select')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_land_select')]"
					tooltip = "hd_peace_finish_land_selection"
				}
			}

			widget = {
				name = "hd_peace_county_filters"
				position = { 8 64 }
				size = { 604 32 }
				hd_peace_filter_tab = { position = { 0 0 } size = { 148 32 } text = "hd_peace_filter_all"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_border')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_claims')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_selected')]"
					down = "[Not(Or(GetVariableSystem.Exists('hd_peace_filter_border'), Or(GetVariableSystem.Exists('hd_peace_filter_claims'), GetVariableSystem.Exists('hd_peace_filter_selected'))))]"
				}
				hd_peace_filter_tab = { position = { 152 0 } size = { 148 32 } text = "hd_peace_filter_border"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_claims')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_selected')]"
					onclick = "[GetVariableSystem.Set('hd_peace_filter_border', 'true')]"
					down = "[GetVariableSystem.Exists('hd_peace_filter_border')]"
				}
				hd_peace_filter_tab = { position = { 304 0 } size = { 148 32 } text = "hd_peace_filter_claims"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_border')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_selected')]"
					onclick = "[GetVariableSystem.Set('hd_peace_filter_claims', 'true')]"
					down = "[GetVariableSystem.Exists('hd_peace_filter_claims')]"
				}
				hd_peace_filter_tab = { position = { 456 0 } size = { 148 32 } text = "hd_peace_filter_selected"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_border')]"
					onclick = "[GetVariableSystem.Clear('hd_peace_filter_claims')]"
					onclick = "[GetVariableSystem.Set('hd_peace_filter_selected', 'true')]"
					down = "[GetVariableSystem.Exists('hd_peace_filter_selected')]"
				}
			}

			widget = {
				position = { 8 456 }
				size = { 924 40 }
				background = {
					texture = "gfx/interface/component_tiles/tile_frame_subwindow_01.dds"
					spriteType = Corneredtiled
					spriteborder = { 18 18 }
					alpha = 0.85
				}
			}

			scrollbox = {
				visible = "[GetVariableSystem.Exists('hd_peace_land_offer_select')]"
				position = { 8 102 }
				size = { 604 348 }
				blockoverride "scrollbox_margins" {
					margin_top = 2
					margin_bottom = 8
					margin_left = 6
					margin_right = 18
				}
				blockoverride "scrollbox_content" {
					vbox = {
						datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_offer_candidates')]"
						layoutpolicy_horizontal = expanding
						spacing = 3
						ignoreinvisible = yes
						item = {
							widget = {
								datacontext = "[Scope.Title]"
								visible = "[Or(Not(Or(GetVariableSystem.Exists('hd_peace_filter_border'), Or(GetVariableSystem.Exists('hd_peace_filter_claims'), GetVariableSystem.Exists('hd_peace_filter_selected')))), Or(And(GetVariableSystem.Exists('hd_peace_filter_selected'), GetScriptedGui('hd_peace_map_offer_county_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)), Or(And(GetVariableSystem.Exists('hd_peace_filter_claims'), GetScriptedGui('hd_peace_offer_county_claim_filter_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)), And(GetVariableSystem.Exists('hd_peace_filter_border'), GetScriptedGui('hd_peace_offer_county_border_filter_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)))))]"
								size = { 578 50 }
								button_standard_list = {
									size = { 530 50 }
									down = "[GetScriptedGui('hd_peace_map_offer_county_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)]"
									enabled = "[GetScriptedGui('hd_peace_map_offer_county_toggle_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)]"
									onclick = "[GetScriptedGui('hd_peace_map_offer_county_toggle_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)]"
									tooltip = "hd_peace_offer_county_row_tt"
									using = tooltip_ws
									coa_title_tiny_crown = { position = { 8 2 } }
									text_single = { using = Font_Size_Small text = "[Title.GetNameNoTooltip]" position = { 56 5 } size = { 350 22 } align = left|vcenter default_format = "#high" alwaystransparent = yes autoresize = no }
									text_single = { using = Font_Size_Tiny text = "hd_peace_county_holder" position = { 56 26 } size = { 350 19 } align = left|vcenter default_format = "#low" alwaystransparent = yes autoresize = no }
									text_single = { using = Font_Size_Medium raw_text = "[Title.MakeScope.ScriptValue('hd_peace_county_price_value')|0]" position = { 410 0 } size = { 70 50 } align = right|vcenter default_format = "#positive_value" tooltip = "hd_peace_county_price_tt" autoresize = no }
									icon = { texture = "gfx/interface/icons/symbols/icon_check.dds" position = { 494 13 } size = { 24 24 } alwaystransparent = yes visible = "[GetScriptedGui('hd_peace_map_offer_county_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)]" }
								}
								button_round = {
									position = { 538 6 }
									size = { 38 38 }
									onclick = "[Title.GetProvince.ZoomCameraTo]"
									tooltip = "hd_peace_center_county_tt"
									using = tooltip_ws
									icon = { texture = "gfx/interface/icons/flat_icons/go_to_my_location.dds" size = { 22 22 } parentanchor = center alwaystransparent = yes }
								}
							}
						}
					}
				}
			}
			scrollbox = {
				visible = "[And(GetVariableSystem.Exists('hd_peace_land_demand_select'), Not(GetVariableSystem.Exists('hd_peace_land_title_select')))]"
				position = { 8 102 }
				size = { 604 348 }
				blockoverride "scrollbox_margins" {
					margin_top = 2
					margin_bottom = 8
					margin_left = 6
					margin_right = 18
				}
				blockoverride "scrollbox_content" {
					vbox = {
						datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_demand_candidates')]"
						layoutpolicy_horizontal = expanding
						spacing = 3
						ignoreinvisible = yes
						item = {
							widget = {
								datacontext = "[Scope.Title]"
								visible = "[Or(Not(Or(GetVariableSystem.Exists('hd_peace_filter_border'), Or(GetVariableSystem.Exists('hd_peace_filter_claims'), GetVariableSystem.Exists('hd_peace_filter_selected')))), Or(And(GetVariableSystem.Exists('hd_peace_filter_selected'), GetScriptedGui('hd_peace_map_demand_county_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)), Or(And(GetVariableSystem.Exists('hd_peace_filter_claims'), GetScriptedGui('hd_peace_demand_county_claim_filter_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)), And(GetVariableSystem.Exists('hd_peace_filter_border'), GetScriptedGui('hd_peace_demand_county_border_filter_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)))))]"
								size = { 578 50 }
								button_standard_list = {
									size = { 530 50 }
									down = "[GetScriptedGui('hd_peace_map_demand_county_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)]"
									enabled = "[GetScriptedGui('hd_peace_map_demand_county_toggle_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)]"
									onclick = "[GetScriptedGui('hd_peace_map_demand_county_toggle_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End)]"
									tooltip = "hd_peace_demand_county_row_tt"
									using = tooltip_ws
									coa_title_tiny_crown = { position = { 8 2 } }
									text_single = { using = Font_Size_Small text = "[Title.GetNameNoTooltip]" position = { 56 5 } size = { 350 22 } align = left|vcenter default_format = "#high" alwaystransparent = yes autoresize = no }
									text_single = { using = Font_Size_Tiny text = "hd_peace_county_holder" visible = "[Not(GetScriptedGui('hd_peace_demand_county_occupied_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('county', Title.MakeScope).End))]" position = { 56 26 } size = { 350 19 } align = left|vcenter default_format = "#low" alwaystransparent = yes autoresize = no }
