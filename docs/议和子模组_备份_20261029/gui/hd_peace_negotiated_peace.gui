			button_tertiary = { visible = "[And(GetVariableSystem.Exists('hd_peace_land_demand_select'), GetVariableSystem.Exists('hd_peace_land_title_select'))]" position = { 16 460 } size = { 140 32 } text = "hd_peace_clear" onclick = "[GetScriptedGui('hd_peace_clear_demand_titles_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }

			button_primary = {
				position = { 716 459 }
				size = { 208 34 }
				text = "hd_peace_finish_land_selection"
				datacontext = "[GetScriptedGui('hd_peace_end_land_selection_gui')]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetVariableSystem.Clear('hd_peace_land_offer_select')]"
				onclick = "[GetVariableSystem.Clear('hd_peace_land_demand_select')]"
				onclick = "[GetVariableSystem.Clear('hd_peace_land_title_select')]"
				onclick = "[GetVariableSystem.Clear('hd_peace_land_select')]"
			}
		}
	}
}
