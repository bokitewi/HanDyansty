types HdPeaceRouting {
	type hd_peace_routing_panel = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 8
		text_multi = {
			text = "hd_peace_entry_explanation"
			using = Font_Size_Small
			layoutpolicy_horizontal = expanding
			max_width = 600
			autoresize = yes
		}
		button_standard = {
			text = "hd_peace_scripted_settle"
			size = { 400 42 }
			datacontext = "[GetScriptedGui('hd_peace_scripted_settle_gui')]"
			visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End)]"
			enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End)]"
			onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('war', WarOverviewWindow.GetWar.MakeScope).End)]"
			tooltip = "hd_peace_scripted_settle_tt"
		}
	}
	type hd_peace_objective_controls = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 4
		text_multi = {
			text = "hd_peace_artifact_objective_details"
			visible = "[GetScriptedGui('hd_peace_artifact_objective_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = Font_Size_Small
			max_width = 900
			layoutpolicy_horizontal = expanding
			autoresize = yes
		}
		dynamicgridbox = {
			visible = "[GetScriptedGui('hd_peace_artifact_objective_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_objective_artifacts')]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = shrinking
			item = {
				text_single = {
					datacontext = "[Scope.Artifact]"
					text = "[Artifact.GetName]"
					using = Font_Size_Small
					layoutpolicy_horizontal = expanding
					size = { 600 22 }
				}
			}
		}
		text_multi = {
			text = "hd_peace_raze_objective_details"
			visible = "[GetScriptedGui('hd_peace_raze_objective_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = Font_Size_Small
			max_width = 900
			layoutpolicy_horizontal = expanding
			autoresize = yes
		}
		text_multi = {
			text = "hd_peace_migration_objective_details"
			visible = "[GetScriptedGui('hd_peace_migration_objective_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = Font_Size_Small
			max_width = 900
			layoutpolicy_horizontal = expanding
			autoresize = yes
		}
		button_standard = {
			text = "hd_peace_objective_toggle"
			size = { 600 38 }
			datacontext = "[GetScriptedGui('hd_peace_objective_gui')]"
			enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			tooltip = "hd_peace_objective_tt"
		}
		text_multi = {
			text = "hd_peace_relocation_objective_details"
			visible = "[GetScriptedGui('hd_peace_relocation_objective_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = Font_Size_Small
			max_width = 900
			layoutpolicy_horizontal = expanding
			autoresize = yes
		}
		text_multi = {
			text = "hd_peace_objective_selected"
			visible = "[GetScriptedGui('hd_peace_objective_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = Font_Size_Small
			max_width = 900
			layoutpolicy_horizontal = expanding
			autoresize = yes
		}
		dynamicgridbox = {
			visible = "[GetScriptedGui('hd_peace_objective_selected_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			datamodel = "[GetPlayer.MakeScope.GetList('hd_peace_objective_display_titles')]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = shrinking
			item = {
				text_single = {
					datacontext = "[Scope.Title]"
					text = "[Title.GetName]"
					using = Font_Size_Small
					size = { 600 22 }
				}
			}
		}
	}
}
